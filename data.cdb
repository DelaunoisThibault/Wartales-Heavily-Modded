						"apCost": 1,
						"useWithoutWeapon": true
					}, 
					"script": "function onEval(s) {
						if( !isPlayer(skill.unit) ){
							dontAllow();
						}
					}
					function onSkill() {
						for ( t in skill.getTargets() ) {
							if( t.target != null && !t.target.hasStatus(Status.NotCapturableUnit) && !t.target.hasStatus(Status.Skilled) &&  !t.target.hasStatus(Status.Leader) && !t.target.hasStatus(Status.Gladiator) && !t.target.hasStatus(Status.Champion) && !t.target.hasSkill(Skill.RingleaderThreat) && !t.target.hasSkill(Skill.TrainedToKill) && !t.target.hasSkill(Skill.IronWill) && !t.target.hasSkill(Skill.SupportLeader) && !t.target.hasSkill(Skill.Exaltation) ) {
								playAnim();
								captureTarget(t);
							} else {
								if (isExtremeDifficulty()){
									skill.unit.gainsActionPoint(vars.value2);
								} else {
									skill.unit.gainsActionPoint(vars.value1);
								}
								allowReplay();
							}
						}
					}", 
