					"script": "function onCenserInhaled(c) {\n\tif (c.st.target == skill.unit) {\n\t\tvar as = [];\n\t\tfor (a in getAllies(skill.unit)) {\n\t\t\tif (skill.level <= 1 && a.isMelee(skill.unit)) {\n\t\t\t\tas.push(a);\n\t\t\t} else if (skill.level >= 2 && getDistance(a, skill.unit) <= vars.meters) {\n\t\t\t\tas.push(a);\n\t\t\t}\n\t\t}\n\t\tif (as.length > 0)\n\t\t\tfor (a in as) {\n\t\t\t\tinhaleCenser(a);\n\t\t\t}\n\t}\n}",
