					},
					"script": "var arr = [];\n\nfunction onHit(a) {\n\ta.target.damages(skill, a.target.getPercentHealth(vars.value2),true);\n\ta.target.pushback({ unit : skill.unit }, getPushback(a), a);\n\tarr.push(a.target);\n}\n\nfunction getPushback( a ) {\n\treturn vars.value1;\n}\n\nfunction onPostSkill() {\n\tfor (f in arr)\n\t\tfor (a in getMeleeUnits(f))\n\t\t\tif (a.side == skill.unit.side)\n\t\t\t\ta.opportunityAttack(f, skill);\n\tarr = [];\n}",
