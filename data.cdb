					"script": "function onBeginBattle() {
						vars.auraWasActivated = false;
					}
					function onEndTurn() {
						if( !vars.auraWasActivated ){
							skill.unit.addStatus(Status.Zeal, vars.value2, true);
							for( u in getAllies(skill.unit) ) {
								if( getDistance(skill.unit, u) <= vars.value1 ) {
									u.addStatus(Status.Zeal, vars.value2, true);
								}
							}
							vars.auraWasActivated = true;
						}
					}",
