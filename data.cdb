					},
					"script": "function onBeginAction() {
						vars.allowed = false;
						for( u in getFoes(skill.unit) ) {
							var p = 100 * (u.health / u.stats.health);
							if( p <= vars.value1 && u.isMelee(skill.unit) ) {
								vars.allowed = true;
								break;
							}
						}
					}
					function onEval(a) {
						var p = 100 * (a.target.health / a.target.stats.health);
						if( p > vars.value1 ) {
							dontAllow();
						}
					}
					function onPostSkill() {
						for( t in skill.getTargets() ) {
							if( !t.target.isAlive() ) {
								skill.unit.addStatus(Status.Fury);
