							}
						],
						"usableWhenLocked": true
					},
					"script": "function onBeginRound() {\n\tvars.poison = false;\n\tvars.burning = false;\n\tvars.bleeding = false;\n}\n\nfunction onStatus(s) {\n\tif (s.unit != skill.unit) return;\n\tif (s.kind != Status.Poison && s.kind != Status.Bleeding && s.kind != Status.Burning) return;\n\tspawnFx();\n\ts.cancel();\n\tif (skill.level < 2) return;\n\tif( s.kind == Status.Poison && !vars.poison) {\n\t\tskill.unit.addStatus(Status.AnimalMarkedBonus, vars.value1);\n\t\tvars.poison = true;\n\t}\n\tif( s.kind == Status.Bleeding && !vars.bleeding) {\n\t\tskill.unit.addStatus(Status.AnimalMarkedBonus, vars.value1);\n\t\tvars.bleeding = true;\n\t}\n\tif( s.kind == Status.Burning && !vars.burning) {\n\t\tskill.unit.addStatus(Status.AnimalMarkedBonus, vars.value1);\n\t\tvars.burning = true;\n\t}\n}",
