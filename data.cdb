						"isAttack": true,
						"dmgAttribute": 1,
						"useStances": true
					},
					"script": "function onEval(t) {\n\tt.attackCount = vars.value1;\n}\n\nfunction onBeforeSkill(s) {\n\tif (vars.ally == null && s.target.isEngaged() && s.target.engagedUnit.isAnimal){\n\t\tvars.ally = s.target.engagedUnit;\n\t}\n}\n\nfunction onPostSkill(){\n\tbreakpoint(\"\", vars);\n\tif (vars.ally != null) {\n\t\tif (canUseDefenseStance()) {\n\t\t\tvars.ally.addStatus(Status.Deflection);\n\t\t\tskill.unit.addStatus(Status.Deflection);\n\t\t}\n\t\tif (canUseAttackStance() && vars.ally.engagedUnit != null) {\n\t\t\tvars.ally.opportunityAttack(vars.ally.engagedUnit, skill);\n\t\t}\n\n\t}\n\n\tvars.ally = null;\n}",
