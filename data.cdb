												"target": 0
											}
										],
										"tiredness": 0.2
									}
								}
							],
							"personality": "PersPragmatic"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Les autres ont l’air très inquiet de voir nos têtes mises à prix, mais ils s’en font pour rien. La Garde a la mémoire courte, en se tenant à carreau pendant quelques temps, ils auront tôt fait de nous oublier."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Rassurer le groupe à propos de la Garde."
