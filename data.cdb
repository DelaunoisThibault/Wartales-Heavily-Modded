					"script": "function onBeginAction() {\n\tvars.allowed = false;\n\tfor( u in getAllies(skill.unit) ) {\n\t\tif( u.isAnimal ) {\n\t\t\tvars.allowed = true;\n\t\t\tbreak;\n\t\t}\n\t}\n}\n\nfunction onEval(a) {\n\tif( !a.target.isAnimal ) {\n\t\tdontAllow();\n\t}\n}\n\nfunction onSkill() {\n\tplay();\n}\n\nfunction onPostSkill() {\n\tvar t = skill.getTargets()[0];\n\tif( t == null )\n\t\treturn;\n\tif (t.target.isAnimal) {\n\t\tt.target.addStatus(Status.Fury);\n\t\tt.target.addStatus(Status.AnimalMarkedBonus, vars.value1);\n\t\tif( skill.level >= 2 ) {\n\t\t\tt.target.addStatus(Status.Riposte);\n\t\t}\n\t}\n}",
