								"st": "OpportunityAttack"
							}
						],
						"isAttack": true
					},
					"script": "function onSkill() {
						play();
						for( t in skill.getTargets() ) {
							for(u in getAllies(skill.unit) ) {
								if( t.target.isAlive() && u.isAnimal && u.isMelee(t.target) ) {
									u.opportunityAttack(t.target, skill);
								}
							}
						}
					}",
