							"val2": 2
						},
						"needDisengaged": true,
						"useWithoutWeapon": true
					},
					"script": "function onEval(s) {\n\tif(skill.unit.armor > 0 )\n\t\tdontAllow();\n}\n\nfunction onBeginAction(){\n\tvars.allowed = skill.unit.armor <= 0 ;\n}\n\nfunction onSkill() {\n\tvar dmg = skill.unit.getPercentHealth(vars.val1);\n\tskill.unit.damages(skill, dmg);\n\tplay();\n\tskill.unit.heal(skill, dmg * vars.val2);\n}",
