					"script": "function onEval(t) {\n\tvar hasBonus = false;\n\tfor( st in t.target.getAllStatus() ) {\n\t\t\tif( st.isMalus ) {\n\t\t\t\thasBonus = true;\n\t\t\t\tbreak;\n\t\t\t}\n\t}\n\tif (hasBonus == true){\n\t\tt.dmg = t.target.getPercentHealth(vars.value1*2);\n\t}\n\telse {\n\t\tt.dmg = t.target.getPercentHealth(vars.value1);\n\t}\n\n}\n\nfunction onSkill() {\nattack();\n}",
