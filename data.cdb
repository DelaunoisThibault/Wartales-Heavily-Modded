					"script": "function onBeforeHit(a){\n    if (a.target == skill.unit && a.dmg < skill.unit.getPercentHealth(vars.value1, true))\n        a.dmg = 0;\n}\n\nfunction onEndRound(){\n    skill.unit.cancelStatus(Status.Poison);\n    skill.unit.cancelStatus(Status.Bleeding);\n    skill.unit.cancelStatus(Status.Burning);\n}",
