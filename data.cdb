									]
								}
							]
						},
						{
							"introDialog": [
								{
									"text": "[XM] ::name:: est peut-être un lycanthrope, mais c’est toujours notre compagnon ! Hors de question d’abandonner un membre de la troupe. Et puis, il est devenu plus fort, pourquoi se priver de lui ?"
								},
								{
									"text": "[XF] ::name:: est peut-être une lycanthrope, mais c’est toujours notre compagnon ! Hors de question d’abandonner un membre de la troupe. Et puis, elle est devenue plus forte, pourquoi se priver d'elle ?"
								}
							],
							"choices": [
								{
