					"script": "function onDamageDealt(s) {\n    if( s.unit == skill.unit && s.target.armor == 0 ) {\n        s.target.addStatus(Status.Bleeding);\n    }\n}\n\nfunction onDotEval(a) {\n    if( a.kind == Status.Bleeding ) {\n        skill.unit.addStatus(Status.AnimalMarkedBonus, vars.value1);\n    }\n}",
