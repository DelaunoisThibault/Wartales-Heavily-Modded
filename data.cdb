				{
					"id": "Overwhelming",
					"name": "Surpuissant",
					"desc": "[DamageBonusPercent] augmentés de ::value2::% si cette unité n'a pas Supériorité de la liche, et [DamageTakenPercent] réduits de ::value3::% si cette unité n'a pas Immortel ou Supériorité de la liche. Le bonus aux dégâts est réduit de moitié si l'unité a la compétence Force brute ou Renforcement par le meurtre.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 90,
							"value2": 150,
							"value3": 75
						},
						"globalEvents": true
					},
					"script": "function onSkillEval(z) {
						for (t in z.getTargets()){
							if (t.target == skill.unit && isPlayer(skill.unit) && !skill.unit.hasSkill(Skill.Immortality) && !skill.unit.hasSkill(Skill.LichSuperiority)){
								t.baseDamageBonus -= vars.value3;
							}
							if ( z.unit == skill.unit && isPlayer(skill.unit) && !skill.unit.hasSkill(Skill.LichSuperiority) ){
								if( skill.unit.hasSkill(Skill.RawStrength) || skill.unit.hasSkill(Skill.GainStatsOnkill) ){
									t.baseDamageBonus += (vars.value2 / 2);
								} else {
									t.baseDamageBonus += vars.value2;
								}
							}
						}
					}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
