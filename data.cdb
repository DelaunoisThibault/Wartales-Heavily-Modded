				{
					"id": "AllyDoubt",
					"name": "Confiance vacillante",
					"desc": "Cette unité a [Discredit] tant que sa [Health] ou son [Armor] a été réduite de ::val::% depuis le début du round.",
					"mode": 2,
					"range": {},
					"props": {
