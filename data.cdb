					"script": "function onDamageTaken(a){\n    checkSt(a);\n}\n\nfunction onDamageDone(a) {\n    checkSt(a);\n}\n\nfunction checkSt(a) {\n    if (a.target.side == skill.unit.side) return;\n    if (getDistance(a.target, skill.unit) > vars.value1) return;\n    if (a.damagedHealth <= 0) return;\n    a.target.damages(skill, a.target.getPercentHealth(vars.value2), true);\n}",
