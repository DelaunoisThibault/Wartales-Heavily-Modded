								"st": "Fury"
							},
							{
								"st": "Deflection"
							}
						]
					},
					"script": "function onBeginBattle() {
						if(skill.unit.armor <= 0) {
							skill.unit.addStatusPersist(Status.Fury, skill);
							skill.unit.addStatusPersist(Status.Deflection, skill);
						} else {
							skill.unit.cancelStatus(Status.Fury, skill);
							skill.unit.cancelStatus(Status.Deflection, skill);
						}
					}
					function onBeginRound() {
						if(skill.unit.armor <= 0) {
							skill.unit.addStatusPersist(Status.Fury, skill);
							skill.unit.addStatusPersist(Status.Deflection, skill);
						} else {
							skill.unit.cancelStatus(Status.Fury, skill);
							skill.unit.cancelStatus(Status.Deflection, skill);
						}
					}
					function onBeginAction() {
						if(skill.unit.armor <= 0) {
							skill.unit.addStatusPersist(Status.Fury, skill);
							skill.unit.addStatusPersist(Status.Deflection, skill);
						} else {
							skill.unit.cancelStatus(Status.Fury, skill);
							skill.unit.cancelStatus(Status.Deflection, skill);
						}
					}
					function onEndTurn() {
						if(skill.unit.armor <= 0) {
							skill.unit.addStatusPersist(Status.Fury, skill);
							skill.unit.addStatusPersist(Status.Deflection, skill);
						} else {
							skill.unit.cancelStatus(Status.Fury, skill);
							skill.unit.cancelStatus(Status.Deflection, skill);
						}
					}",
					"notes": "",
