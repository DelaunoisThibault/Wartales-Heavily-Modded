					"script": "function onStatus(s) {\n\tif (s.unit != skill.unit) return;\n\tif (s.kind != Status.Poison && s.kind != Status.Bleeding && s.kind != Status.Burning && s.kind != Status.Terror) return;\n\tspawnFx();\n\ts.cancel();\n\t\n}",
