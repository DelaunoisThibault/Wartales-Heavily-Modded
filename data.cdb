						"baseDistance": 6
					},
					"props": {
						"vars": {
							"value1": 18,
							"engaged": false
						},
						"dmgAttribute": 0,
						"apCost": 2,
						"isAttack": true,
						"useWithoutWeapon": true,
						"animFx": "prefabs/fx/fight/Creatures/CrawlerSlash.fx",
						"tooltipStatus": [
							{
								"st": "OpportunityAttack"
							}
						]
					},
					"script": "function onEval(a) {
						if( !a.target.isEngaged() || a.target.engagedUnit != skill.unit ) {
							vars.engaged = false;
						} else {
							vars.engaged = true;
						}
					}
					function onHit(a) {
						if( !a.target.isEngaged() || a.target.engagedUnit != skill.unit ) {
							vars.engaged = false;
						} else {
							vars.engaged = true;
						}
						a.target.pushback({ unit : skill.unit }, getPushback(a), a);
					}
					function onDamage(a) {
						if( a.target.isAlive() && a.target.isMelee(skill.unit) ) {
							a.target.disengage(false);
							a.target.engage(skill.unit);
							if( a.target.isEngaged() && skill.unit.engagedUnit == a.target && !vars.engaged ) {
								skill.unit.opportunityAttack(a.target, skill);
							}
						}
					}
					function getPushback( a ) {
						return -vars.value1;
					}",
