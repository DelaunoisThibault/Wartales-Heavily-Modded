								"minDmg": 7,
								"maxDmg": 9
							}
						}
					],
					"iconeDone": true
				},
				{
					"id": "GainStatsOnkill",
					"name": "Renforcement par le meurtre",
					"desc": "Pour chaque ennemi tué, cette unité gagne 1 en [Constitution] (si elle n'a pas Immortel) et 1% de [DamageBonusPercent] par pallier d'ennemis tués. \nLes palliers sont les suivants : \n- Pour les Rampants (de toute sortes) et Pestiférés : ::crawlersAndPlageriddensDividerValue::; \n- Pour les autres : ::baseDividerValue::. \n\nBonus actuel (valeur correcte en combat) : ::counterActualValue::",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"vars": {
							"crawlersAndPlageriddensDividerValue": 3,
							"baseDividerValue": 5,
							"nbrOfPowerStack": 0,
							"nbrOfConstStack": 0,
							"counterActualValue": 0,
							"divider": 0
						}
					},
					"script": "function onBeginBattle() {
						if(skill.unit.kind == UnitClass.Crawler || skill.unit.kind == UnitClass.SnowCrawler || skill.unit.kind == UnitClass.SeaCrawler || skill.unit.kind == UnitClass.Plagueridden ) {
							vars.divider = vars.crawlersAndPlageriddensDividerValue;
						} else {
							vars.divider = vars.baseDividerValue;
						}
						if( !skill.unit.hasSkill(Skill.Immortality) ){
							if(!skill.unit.hasStatus(Status.PrisonnerHealthMurderReinforcement)) {
								skill.unit.addStatus(Status.PrisonnerHealthMurderReinforcement, skill.unit.getCounter(Counter.EnemiesKilled));
							} else {
								vars.nbrOfConstStack = skill.unit.getStatusCount(Status.PrisonnerHealthMurderReinforcement);
								if(vars.nbrOfConstStack != 0 && vars.nbrOfConstStack < skill.unit.getCounter(Counter.EnemiesKilled)) {
									skill.unit.cancelStatus(Status.PrisonnerHealthMurderReinforcement);
									skill.unit.addStatus(Status.PrisonnerHealthMurderReinforcement, skill.unit.getCounter(Counter.EnemiesKilled));
								}
							}
						}
						vars.counterActualValue = skill.unit.getCounter(Counter.EnemiesKilled) / vars.divider;
					}
					function onSkillEval(a) {
						vars.counterActualValue = skill.unit.getCounter(Counter.EnemiesKilled) / vars.divider;
						for( t in a.getTargets() ) {
							if (a.unit == skill.unit) {
								t.baseDamageBonus += vars.counterActualValue;
							}
						}
					}
					function onDeath(a) {
						if( a.unit == skill.unit ) {
							if(skill.unit.kind == UnitClass.Crawler || skill.unit.kind == UnitClass.SnowCrawler || skill.unit.kind == UnitClass.SeaCrawler || skill.unit.kind == UnitClass.Plagueridden ) {
								vars.divider = vars.crawlersAndPlageriddensDividerValue;
							} else {
								vars.divider = vars.baseDividerValue;
							}
							if( !skill.unit.hasSkill(Skill.Immortality) ){
								if(!skill.unit.hasStatus(Status.PrisonnerHealthMurderReinforcement)) {
									skill.unit.addStatus(Status.PrisonnerHealthMurderReinforcement, skill.unit.getCounter(Counter.EnemiesKilled));
								} else {
									vars.nbrOfConstStack = skill.unit.getStatusCount(Status.PrisonnerHealthMurderReinforcement);
									if(vars.nbrOfConstStack != 0 && vars.nbrOfConstStack < skill.unit.getCounter(Counter.EnemiesKilled) && !skill.unit.hasStatus(Status.Confus) ) {
										skill.unit.cancelStatus(Status.PrisonnerHealthMurderReinforcement);
										skill.unit.addStatus(Status.PrisonnerHealthMurderReinforcement, skill.unit.getCounter(Counter.EnemiesKilled));
									}
								}
							}
							vars.counterActualValue = skill.unit.getCounter(Counter.EnemiesKilled) / vars.divider;
						}
					}",
					"notes": "",
					"levels": [],
					"icon": {
						"file": "ui/Icons/BattleIcons96PX.png",
						"size": 96,
						"x": 6,
						"y": 5
					},
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "BloodyArmor",
					"name": "Armure de sang",
					"desc": "Si cette unité a Renforcement par le meurtre et N'A PAS Immortel, pour ::armorDividerValue:: ennemis tués, cette unité gagne 1% d'armure. En plus, pour ::guardDividerValue:: ennemis tués, cette unité gagne 1% de [Guard], jusqu'à un maximum de ::value1::%. \nRégénère ::value2::% d'[Armor] à chaque ennemi tué. \n\nBonus actuel (valeur correcte en combat) : \n- Armure : ::counterArmorValue::, \n- Garde : ::counterGuardValue::.",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"vars": {
							"value1": 30,
							"value2": 10,
							"armorDividerValue": 3,
							"guardDividerValue": 5,
							"nbrOfArmorStack": 0,
							"nbrOfGuardStack": 0,
							"counterArmorValue": 0,
							"counterGuardValue": 0
						}
					},
					"script": "function onBeginBattle() {
						if( !skill.unit.hasSkill(Skill.Immortality) && skill.unit.hasSkill(Skill.GainStatsOnkill) ){
							vars.counterArmorValue = skill.unit.getCounter(Counter.EnemiesKilled) / vars.armorDividerValue;
							vars.counterGuardValue = skill.unit.getCounter(Counter.EnemiesKilled) / vars.guardDividerValue;
							if(!skill.unit.hasStatus(Status.ArmorPercentageBonus)) {
								skill.unit.addStatus(Status.ArmorPercentageBonus, vars.counterArmorValue);
							} else {
								vars.nbrOfArmorStack = skill.unit.getStatusCount(Status.ArmorPercentageBonus);
								if(vars.nbrOfArmorStack != 0 && vars.nbrOfArmorStack < vars.counterArmorValue) {
									skill.unit.cancelStatus(Status.ArmorPercentageBonus);
									skill.unit.addStatus(Status.ArmorPercentageBonus, vars.counterArmorValue);
								}
							}
							if(!skill.unit.hasStatus(Status.GuardStackableBonus)) {
								skill.unit.addStatus(Status.GuardStackableBonus, vars.counterGuardValue);
							} else {
								vars.nbrOfGuardStack = skill.unit.getStatusCount(Status.GuardStackableBonus);
								if(vars.nbrOfArmorStack != 0 && vars.nbrOfGuardStack < vars.counterGuardValue) {
									skill.unit.cancelStatus(Status.GuardStackableBonus);
									skill.unit.addStatus(Status.GuardStackableBonus, vars.counterGuardValue);
								}
							}
						}
					}
					function onDeath(a) {
						if( !skill.unit.hasSkill(Skill.Immortality) && skill.unit.hasSkill(Skill.GainStatsOnkill) ){
							if( a.unit == skill.unit ) {
								vars.counterArmorValue = skill.unit.getCounter(Counter.EnemiesKilled) / vars.armorDividerValue;
								vars.counterGuardValue = skill.unit.getCounter(Counter.EnemiesKilled) / vars.guardDividerValue;
								if(!skill.unit.hasStatus(Status.ArmorPercentageBonus)) {
									skill.unit.addStatus(Status.ArmorPercentageBonus, vars.counterArmorValue);
								} else {
									vars.nbrOfArmorStack = skill.unit.getStatusCount(Status.ArmorPercentageBonus);
									if(vars.nbrOfArmorStack != 0 && vars.nbrOfArmorStack < vars.counterArmorValue && !skill.unit.hasStatus(Status.Confus) ) {
										skill.unit.cancelStatus(Status.ArmorPercentageBonus);
										skill.unit.addStatus(Status.ArmorPercentageBonus, vars.counterArmorValue);
									}
								}
								if(!skill.unit.hasStatus(Status.GuardStackableBonus)) {
									skill.unit.addStatus(Status.GuardStackableBonus, vars.counterGuardValue);
								} else {
									vars.nbrOfGuardStack = skill.unit.getStatusCount(Status.GuardStackableBonus);
									if(vars.nbrOfArmorStack != 0 && vars.nbrOfGuardStack < vars.counterGuardValue && !skill.unit.hasStatus(Status.Confus) ) {
										skill.unit.cancelStatus(Status.GuardStackableBonus);
										skill.unit.addStatus(Status.GuardStackableBonus, vars.counterGuardValue);
									}
								}
								if( skill.unit.armor < skill.unit.stats.armor && skill.unit.stats.armor > 0 ) {
									skill.unit.gainsArmor(ceil(skill.unit.stats.armor * vars.value2 / 100));
								}
							}
						}
					}",
