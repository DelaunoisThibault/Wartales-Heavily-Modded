					"script": "function onSkillEval(s) {\n\tif (s.unit == skill.unit && skill.unit.health <= skill.unit.getPercentHealth(vars.healthPercentThreshold, true))\n\t\tfor (t in s.getTargets())\n\t\t\tt.baseDamageBonus += vars.bonusDamage;\n}\n\nfunction onSkillPlayed(s) {\n\tcheckSide();\n}\n\nfunction onEndTurn() {\n\tcheckSide();\n}\n\nfunction checkSide() {\n\tif (skill.unit.health <= skill.unit.getPercentHealth(vars.healthPercentThreshold, true)) {\n\t\tif (!vars.neutral) {\n\t\t\tvars.neutral = true;\n\t\t\tskill.unit.setNeutral();\n\t\t}\n\t} else if (vars.neutral) {\n\t\tvars.neutral = false;\n\t\tskill.unit.resetSide();\n\t}\n}",
