				{
					"id": "Swap",
					"name": "Changement !",
					"desc": "Échange de place avec un allié engagé.\n[AttackStance] :Effectue une attaque d'opportunité.\n[DefenseStance] : Cette unité et l'allié gagnent [Deflection].",
					"mode": 0,
