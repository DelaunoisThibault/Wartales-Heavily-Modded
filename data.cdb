					"script": "function onBeginAction() {\n\tif( !skill.unit.isEngaged() )\n\t\tvars.engaged = false;\n}\n\nfunction onSkillPlayed(s) {\n\tif (skill.unit.isEngaged() && !vars.engaged ) {\n\t\tvars.engaged = true;\n\t\tswitch (skill.unit.engagedUnit.getCategory()) {\n\t\tcase UnitClass.Wolf: add(Status.Fury);\n\t\tcase UnitClass.Boar: add(Status.Deflection);\n\t\tcase UnitClass.Bear: add(Status.Riposte);\n\t\tcase UnitClass.Mosquito: add(Status.Dodge);\n\t\tcase UnitClass.PlaguedRat, UnitClass.Molerat: add(Status.Inspiration);\n\t\tcase UnitClass.Saurian: add(Status.WarmBlood);\n\t\tdefault:\n\t\t}\n\t}\n}\n\nfunction add(sk) {\n\tspawnFx();\n\tskill.unit.addStatusPersist(sk, skill);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "BeltAccBlockTerror",
					"name": "Ignorer la peur",
					"desc": "Si cette unité a reçu [Terror] ce tour-ci, elle ne reçoit pas les applications supplémentaires et perd ::value1::% de sa [MaxHealth] à la place.",
					"mode": 2,
					"range": {},
					"props": {
						"tooltipStatus": [
							{
								"st": "Terror"
							}
						],
						"vars": {
							"nbCanceled": 0,
							"value1": 5
						},
						"globalEvents": true
					},
					"script": "function onStatus(s) {\n\tif (s.unit == skill.unit && skill.unit.nbAppliedThisRound(Status.Terror) > 1) {\n\t\tskill.unit.consumeStatus(Status.Terror, s.count);\n\t\tspawnFx();\n\t\tvars.nbCanceled += s.count;\n\t}\n}\n\nfunction onBeginAction() {\n\tif (vars.nbCanceled > 0) {\n\t\tskill.unit.damages(skill, skill.unit.getPercentHealth(vars.value1 * vars.nbCanceled), true);\n\t\tvars.nbCanceled = 0;\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "BeltAccHealTerror",
					"name": "Soin de Terreur",
					"desc": "À chaque fois que cette unité en soigne une autre, si c'est un humain, lui retire également ::value:: [Terror]. Si c'est un animal, lui retire ::value:: [BeastInfluence].",
					"mode": 2,
					"range": {},
