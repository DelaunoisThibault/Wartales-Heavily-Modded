							"value1": 3
						},
						"tooltipStatus": [
							{
								"st": "Replay"
							}
						]
					},
					"script": "function onSkill() {\n\tplay();\n\n\tif (getAllies(skill.unit).length <= 0) {\n\t\tskill.unit.addStatus(Status.Fury);\n\t\treturn;\n\t}\n\n\tvar t = null;\n\tvar d = 0.;\n\tfor( u in getAllies(skill.unit) ) {\n\t\tif( u.isAnimal ) {\n\t\t\tvar tmp = getDistance(skill.unit, u);\n\t\t\tif (t == null || tmp < d){\n\t\t\t\tt = u;\n\t\t\t\td = tmp;\n\t\t\t}\n\t\t}\n\t}\n\tif (t != null)\n\t\tt.addStatus(Status.Replay);\n}",
