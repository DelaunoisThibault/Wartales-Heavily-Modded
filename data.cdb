						for (t in z.getTargets()){
							if (t.target == skill.unit){
								t.baseDamageBonus -= vars.bonusValue;
							}
							if (z.unit == skill.unit && skill.level == 2){
								t.baseDamageBonus += vars.bonusValue;
							}
						}
					}",
