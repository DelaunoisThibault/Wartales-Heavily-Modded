							"arenaConditions": 1
						}
					},
					"script": "function onEndTurn() {\n\tvar isGood = false;\n\tif (isPlayer(skill.unit)) {\n\t\tfor (u in getFoes(skill.unit)) {\n\t\t\tif (u.isMelee(skill.unit)) {\n\t\t\t\tisGood = true;\n\t\t\t}\n\t\t}\n\t\tif (isGood) {\n\t\t\tif (!skill.unit.hasStatus(Status.Arena_DemandAlreadyContribute)) {\n\t\t\t\tskill.unit.addStatus(Status.Arena_DemandAlreadyContribute);\n\t\t\t}\n\t\t}\n\t\telse {\n\t\t\tfailObjective();\n\t\t}\n\t}\n}\n\nfunction onEndRound() {\n\tvar isGood = true;\n\tfor (u in getPlayerUnits()) {\n\t\tif (u.isAlive() && !u.hasStatus(Status.Arena_DemandAlreadyContribute)) {\n\t\t\tfailObjective();\n\t\t\tisGood = false;\n\t\t}\n\t}\n\tif (isGood) {\n\t\tsuccessObjective();\n\t}\n}",
