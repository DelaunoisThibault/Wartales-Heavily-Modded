						"useStances": true
					},
					"script": "function onEval(a){
						a.attackCount = vars.value1;
					}
					function onDamage(a){
						vars.attackCount++;
						if( vars.attackCount == vars.value1 ){
							for( u in getAllies(skill.unit) ){
								if( getDistance(skill.unit, u) <= vars.value3 ){
									if( canUseAttackStance() ){
										u.addStatus(Status.Brutality, vars.value2, true);
										u.addStatus(Status.Fury);
									}
									if ( canUseDefenseStance() ){
										u.addStatus(Status.Protection, vars.value2, true);
										u.addStatus(Status.Deflection);
									}
								}
							}
						}
					}
					function onPostSkill(){
						vars.attackCount = 0;
					}",
