						"descPassiveGroup": "[GROUPTYPE] :Tant qu’au moins ::ally1:: unité est engagée, [DamageTakenPercent] réduit de ::value1::%\nTant qu’au moins ::ally2:: unités sont engagées, [DamageTakenPercent] réduit de ::value2::%\nTant qu’au moins ::ally3:: unités sont engagées, [DamageTakenPercent] réduit de ::value3::%"
					},
					"script": "function onSkillEval(a) {\n\tfor (t in a.getTargets()) {\n\t\tif (t.target != skill.unit) continue;\n\t\tvar engagedAlly = getEngagedAllyCount();\n\t\tif (engagedAlly >= vars.ally3)\n\t\t\tt.baseDamageBonus -= vars.value3;\n\t\telse if (engagedAlly >= vars.ally2)\n\t\t\tt.baseDamageBonus -= vars.value2;\n\t\telse if (engagedAlly >= vars.ally1)\n\t\t\tt.baseDamageBonus -= vars.value1;\n\t\treturn;\n\t}\n\n\n}\n\nfunction getEngagedAllyCount(){\n\tvar count = 0;\n\tfor( a in getAllies(skill.unit, true)){\n\t\tif (a.isEngaged())\n\t\t\tcount++;\n\t}\n\treturn count;\n}\n\n\n",
