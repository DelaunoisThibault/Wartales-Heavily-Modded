					"script": "function onEndTurn() {\n    var count = skill.unit.getStatusCount(Status.PitS1_4_KillerMark);\n    var max = isHardPit()? vars.valuebrutal: vars.valuenormal;\n    if (count >= max)\n        flee(false);\n\n}",
