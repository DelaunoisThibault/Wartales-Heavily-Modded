				{
					"id": "BossStatusResistance",
					"name": "Résistance de boss",
					"desc": "Cette unité ne peut pas subir [Terror] et ne peut pas subir [Bleeding], [Burning] et [Poison] en même temps, sinon elle se soigne de ces status. \nDe plus, elle se soigne de [Poison] lorsque le cumul dépasse ::value1::.",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"vars": {
							"value1": 10,
							"isBurned": false,
							"isPoisonned": false,
							"isBleeding": false
						},
						"tooltipStatus": [
							{
								"st": "Poison"
							},
							{
								"st": "Bleeding"
							},
							{
								"st": "Burning"
							},
							{
								"st": "Terror"
							}
						]
					},
					"script": "function onStatus(s) {
						if (s.unit == skill.unit) {
							if(s.kind == Status.Terror) {
								spawnFx();
								s.cancel();
							}
							for( st in skill.unit.getAllStatus() ) {
								if(st.kind == Status.Bleeding) {
									vars.isBleeding = true;
								}
								if(st.kind == Status.Burning ) {
									vars.isBurned = true;
								}
								if( st.kind == Status.Poison ) {
									vars.isPoisonned = true;
								}
							}
							if( (vars.isBleeding && vars.isBurned) || (vars.isBleeding && vars.isPoisonned) || (vars.isBurned && vars.isPoisonned) ) {
								for( st in skill.unit.getAllStatus() ) {
									if( st.kind == Status.Poison || st.kind == Status.Bleeding || st.kind == Status.Burning ) {
										spawnFx();
										st.cancel();
									}
								}
								vars.isBleeding = false;
								vars.isBurned = false;
								vars.isPoisonned = false;
							}
							if(s.kind == Status.Poison) {
								var poisonCountStack = skill.unit.getStatusCount(Status.Poison);
								if(poisonCountStack >= 10) {
									spawnFx();
									s.cancel();
								}
							}
						}
					}",
					"notes": "",
