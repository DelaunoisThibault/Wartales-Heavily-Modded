						],
						"specialAnim": "AttackPower",
						"isAttack": true
					},
					"script": "function onDamage(a) {\n\tif( skill.level == 2 && a.backstab ) {\n\t\ta.target.addStatus(Status.Vulnerability);\n\t}\n\tif( a.target.isEngaged() && a.target.engagedUnit != skill.unit ) {\n\t\ta.target.disengage(true);\n\t\ta.target.engage(skill.unit);\n\t}\n}",
