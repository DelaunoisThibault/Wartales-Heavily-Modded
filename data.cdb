							}
						]
					},
					"script": "function onStatus(s) {
						if( s.unit == skill.unit && s.kind == Status.Poison ){
							if( vars.currentStack < vars.value2 ) {
								vars.currentStack = skill.unit.getStatusCount(Status.Poison) * vars.value1;
							} else {
								vars.currentStack = vars.value2;
							}
						}
					}
					function onDamageDone(s){
						if( s.unit == skill.unit && s.unit != null && !isGameMaster(s.unit) ) {
							if( vars.currentStack < vars.value2 ) {
								vars.currentStack = skill.unit.getStatusCount(Status.Poison) * vars.value1;
							} else {
								vars.currentStack = vars.value2;
							}
						}
					}
					function onDamageTaken(s){
						if( s.unit == skill.unit && !isGameMaster(s.unit) ) {
							if( vars.currentStack < vars.value2 ) {
								vars.currentStack = skill.unit.getStatusCount(Status.Poison) * vars.value1;
							} else {
								vars.currentStack = vars.value2;
							}
						}
					}
					function onEndTurn(){
						if( vars.currentStack < vars.value2 ) {
							vars.currentStack = skill.unit.getStatusCount(Status.Poison) * vars.value1;
						} else {
							vars.currentStack = vars.value2;
						}
					}
					function onSkillEval(z) {
						for (t in z.getTargets()){
							if (t.target == skill.unit){
								t.baseDamageBonus -= vars.currentStack;
							}
						}
					}",
