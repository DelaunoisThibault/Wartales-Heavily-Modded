					"script": "function onEval(t) {\n\tvar count = vars.value1;\n\tif (canUseAttackStance()) {\n\t\tcount += vars.value3;\n\t}\n\tt.attackCount = count;\n\tif (t.forExecute()) {\n\t\tt.baseDamageBonus += vars.value2 * vars.attackCount;\n\t} else {\n\t\tt.baseDamageBonus += ceil(vars.value2 * (t.attackCount - 1) / 2);\n\t}\n}\n\nfunction onDamage(a) {\n\tvars.attackCount++;\n\tif (canUseDefenseStance()) {\n\t\tskill.unit.heal(skill, skill.unit.getPercentHealth(vars.value4));\n\t}\n}\n\nfunction onPostSkill() {\n\tvars.attackCount = 0;\n}",
