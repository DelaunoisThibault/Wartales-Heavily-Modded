							}
						],
						"apCost": 1
					},
					"script": "function onEval(a) {\n\tif( !a.target.isEngaged() || a.target.isAnimal || !skill.unit.canSwapPositionWith(a.target) ) {\n\t\tdontAllow();\n\t}\n}\n\nfunction onSkill() {\n\tfor (t in skill.getTargets()){\n\t\tvar prevEngaged = t.target.engagedUnit;\n\t\tt.target.disengage(false);\n\n\t\tvar prevPos = t.target.getPosition();\n\t\tvar currentPos = skill.unit.getPosition();\n\t\tskill.unit.swapPositionWith(t.target, 0);\n\t\tskill.unit.engage(prevEngaged);\n\n\t\tif(canUseAttackStance()){\n\t\t\tskill.unit.castSkill(Skill.OpportunityAttack, {unit : prevEngaged}, skill);\n\t\t}\n\t\tif (canUseDefenseStance()){\n\t\t\tskill.unit.addStatus(Status.Deflection);\n\t\t\tt.target.addStatus(Status.Deflection);\n\t\t}\n\n\t\tif(skill.level == 2){\n\t\t\tskill.unit.addStatus(Status.Riposte);\n\t\t}\n\t}\n}",
