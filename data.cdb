				{
					"id": "BountyAlazar",
					"title": "Vaincre",
					"description": [
						{
							"t": "<b>::roaming::</b> représente ce que la Fraternité punit sévèrement : les traîtres."
						},
						{
							"t": "Il n'existe rien de pire que d'anciens membres de la Fraternité qui ont rompu leur serment. Traquez-les et tuez-les."
						}
					],
					"amount": 1,
					"maxAmount": 1,
					"goldBonus": 0,
					"maxOcc": 2,
					"weight": 2,
					"minDist": 100,
					"maxDist": 400,
