					"script": "function onHit(a) {\n\ta.target.pushback({ unit : skill.unit }, getPushback(a), a);\n\tif (a.target.isAnimal) {\n\t\tif (!a.target.hasStatus(Status.SpawnInfluence)) {\n\t\t\ta.target.addStatus(Status.SpawnInfluence, vars.nbRound);\n\t\t}\n\t}\n}\n\nfunction getPushback( a ) {\n\treturn vars.distPush;\n}\n\nfunction getAITargetScore(a) {\n\treturn 100 * a.target.getStatusCount(Status.Terror);\n}\n\nfunction onPostSkill() {\n\tfor (f in getFoes(skill.unit))\n\t\tif (f.hasStatus(Status.SpawnInfluence))\n\t\t\tf.setFoe();\n}\n\nfunction onStatusRemoved(s) {\n\tif (s.kind == Status.SpawnInfluence)\n\t\ts.unit.resetSide();\n}",
