					"script": "function onCenserInhaled(c) {\n\tc.st.target.addStatus(Status.FirmStand);\n}\n\nfunction onCenserPurgedHit(c) {\n\tif (c.st.target.side == skill.unit.side) {\n\t\tif (!c.st.target.isEngaged())\n\t\t\tc.st.target.addStatus(Status.OnYourGuard);\n\t\treturn;\n\t}\n\tif (c.st.target.isEngaged()) {\n\t\tvars.nbI = c.inhalation;\n\t\tskill.unit.castSkill(Skill.PanicSmell_Skill, { unit : c.st.target }, c.st._ev);\n\t}\n}\n\nfunction onCenserEval(c) {\n\tif (c.st.target.side == skill.unit.side) {\n\t\tif (c.st.target.isEngaged())\n\t\t\tc.st.dontShowPreview();\n\t\telse c.st.attackCount = 0;\n\t} else if (!c.st.target.isEngaged())\n\t\tc.st.dontShowPreview();\n}\n\nfunction getCenserPushback(a, c) {\n\tif (a.target.side == skill.unit.side || !a.target.isEngaged()) return 0.;\n\treturn vars.n * c;\n}\n\nfunction getPushbackOrigin(a) {\n\treturn { skill : a._ev }\n}",
