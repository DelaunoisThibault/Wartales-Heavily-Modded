						"y": 2
					}
				},
				{
					"id": "BeltAccOutlawsBook",
					"name": "",
					"desc": "[CritHitPercent] et [CritHitDamageBonusPercent] augmentés de ::val::% par niveau de soupçon de la troupe.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"val": 10
						}
					},
					"script": "function onSkillEval(s) {\n\tvar wanted = min(getWantedLevel(), 5);\n\tfor (t in s.getTargets()) {\n\t\tt.criticalHitPercent += vars.val * wanted;\n\t\tt.criticalHitDamageBonus += vars.val * wanted;\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "BeltAccCloseOther",
					"name": "",
					"desc": "[CritHitPercent] et [DamageBonusPercent] sont augmenté de ::val::% si l'unité est adjacente à des alliés de classe différentes.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"val": 5
						}
					},
					"script": "function onSkillEval(e){\n\tvar classes = [];\n\tfor (a in getMeleeUnits(skill.unit)){\n\t\tif (a.side != skill.unit.side)\n\t\t\tcontinue;\n\t\tif (!classes.contains(a.kind))\n\t\tclasses.push(a.kind);\n\t}\n\tif (classes.length > 1) {\n\t\tfor (t in e.getTargets()){\n\t\t\tt.criticalHitPercent += vars.val;\n\t\t\tt.baseDamageBonus += vars.val;\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "AnimAccAllyMelee",
					"name": "",
					"desc": "[DamageBonusPercent] augmentés de ::value1::% si adjacent à un allié au combat.",
