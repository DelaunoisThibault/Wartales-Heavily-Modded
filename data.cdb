						"isAttack": true,
						"hitFx": "prefabs/fx/fight/Explosion/Grenade/SprayingBomb.fx"
					},
					"script": "function onEval(a) {\n\tif( a.target.kind == UnitClass.Mosquito ) {\n\t\ta.preventCriticalHit = true;\n\t\ta.dmg = a.target.getPercentHealth(vars.value1);\n\t} else {\n\t\ta.cancelAttack = true;\n\t}\n}\n\nfunction onSkill() {\n\tvar capturedUnits = [];\n\tvar onlyCapture = true;\n\tfor( a in skill.getTargets() ) {\n\t\tif( a.target.kind == UnitClass.Mosquito && a.target.health <= a.target.getPercentHealth(vars.value1) ) {\n\t\t\tcapturedUnits.push(a);\n\t\t\ta.cancelAttack = true;\n\t\t} else {\n\t\t\tonlyCapture = false;\n\t\t}\n\t}\n\tif (onlyCapture) {\n\t\tplayAttack();\n\t} else {\n\t\tattack();\n\t}\n\tfor( a in capturedUnits ) {\n\t\tcaptureTarget(a);\n\t}\n}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
						"size": 96,
						"x": 5,
						"y": 7
					},
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "ValorousAxeThrow",
					"name": "Lancer de hache valeureux",
					"desc": "Après avoir utilisé une compétence coûtant de la Bravoure, cette unité inflige [DMG] à l’ennemi le plus éloigné dans un rayon de [DIST] mètres, même si elle est engagée.\n\nCoup critique assuré contre la Meute Fantôme.",
					"mode": 2,
					"range": {
						"baseDistance": 6
					},
					"props": {
						"dmgAttribute": 2,
						"flags": 64,
						"preventEngage": true,
						"specialAnim": "ThrowLeft"
					},
					"script": "function onEval(a) {\n\tif( a.target.isGhost ) {\n\t\ta.criticalHitPercent = 100;\n\t}\n}\n\nfunction onSkillPlayed(s) {\n\tvar dTmp = -1.;\n\tvar foeTmp = null;\n\tif(s.apCost < 1)\n\t\treturn;\n\tfor( u in getFoes(skill.unit, true) ) {\n\t\tvar d = getDistance(skill.unit, u);\n\t\tif(d > dTmp && d <= skill.distance && !u.isInFog()) {\n\t\t\tdTmp = d;\n\t\t\tfoeTmp = u;\n\t\t}\n\t}\n\tif (foeTmp != null) {\n\t\tspawnFx();\n\t\tattackTarget(foeTmp);\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_03_96PX.png",
						"size": 96,
						"x": 17,
						"y": 4
					},
					"minDmg": 2
				},
