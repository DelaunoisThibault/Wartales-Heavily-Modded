					"script": "function onDeath(a) {\n\tif(!a.target.isObject && a.target.side != skill.unit.side && a.unit == skill.unit ) {\n\t\tgainsSanity(vars.sanity);\n\t\tskill.unit.cancelStatus(Status.A2SanityStatus02);\n\t}\n}\n\nfunction onEndBattle() {\n\tgainsSanity(-vars.sanity);\n}",
