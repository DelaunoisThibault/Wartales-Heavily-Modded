				},
				{
					"id": "Disengage",
					"name": "Désengagement",
					"desc": "Se désengage. Déclenche une attaque d'opportunité de l'adversaire qui ignore la [Guard].",
					"mode": 4,
					"range": {},
					"props": {
						"vars": {
							"allowed": true
						},
						"tooltipStatus": [
							{
								"st": "OpportunityAttack"
							}
						],
						"baseAction": false
					},
					"script": "function onSkill() {\n\tskill.unit.disengage(true);\n}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons96PX.png",
						"size": 96,
						"x": 11,
						"y": 2
