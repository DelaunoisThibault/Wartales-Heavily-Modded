					"script": "function onHit(a) {\n\tif (a.target.isEngaged())\n\t\ta.target.pushback(getPushbackOrigin(a), getPushback(a), a);\n}\n\nfunction getPushback(a) {\n\treturn skill.unit.getSkillVar(Skill.PanicSmell, \"n\") * skill.unit.getSkillVar(Skill.PanicSmell, \"nbI\");\n}\n\nfunction getPushbackOrigin(a) {\n\treturn { skill : a.castOrigin }\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"minDmg": 3
				},
				{
					"id": "RiotersPassive1",
					"name": "Ardeur insurgée",
					"desc": "[DamageBonusPercent] augmentés de ::v1::% contre les unités qui ont [Burning].\n[DamageTakenPercent] des unités avec [Burning] réduits de ::v1::%.\n\nL'effet devient plus puissant en fonction du [E3Chaos].",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 2
						},
						"descPassiveGroup": "[GROUPTYPE] : Chaque fois que la [Health] d'une unité subit des dégâts, elle gagne ::value1:: [AnimalMarkedBonus]",
						"tooltipStatus": [
							{
								"st": "AnimalMarkedBonus"
							}
						]
					},
					"script": "function onDamageDone(s) {\n\tif (s.damageHealth)\n\t\tdoAddRage();\n}\n\nfunction onDamageTaken(s) {\n\tif (s.dmg > 0 && (s.damageHealth || skill.unit.armor == 0))\n\t\tdoAddRage();\n}\nfunction doAddRage() {\n\tif (skill.unit.addStatus(Status.AnimalMarkedBonus, vars.value1))\n\t\tspawnFx();\n}",
					"notes": "",
					"done": 0,
					"icon": {
