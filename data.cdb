						"x": 3,
						"y": 7
					}
				},
				{
					"id": "Covered",
					"name": "À couvert !",
					"desc": "Chaque fois que cette unité subit des dégâts, elle gagne [Cover]. Une seule unité peut bénéficier de ce statut.",
					"mode": 2,
					"range": {},
					"props": {
						"tooltipStatus": [
							{
								"st": "Cover"
							}
						]
					},
					"script": "function onDamageTaken(a){\n    if (a.unit.side == a.target.side) return;\n    if (!a.target.hasStatus(Status.Cover)) {\n        for (u in getAllies(a.target))\n            if (u.hasStatus(Status.Cover)) {\n                u.cancelStatus(Status.Cover);\n                break;\n            }\n        a.target.addStatus(Status.Cover);\n    } else if (!isGameMaster(a.unit))\n        for (u in getAllies(a.target, false, true))\n            if (u.hasStatus(Status.Champion)) {\n                u.consumeStatus(Status.Loaded, 1);\n                if (u.getStatusCount(Status.Loaded) == 0)\n                    u.addStatus(Status.Empty);\n                u.tryCrossbowShot(a.unit, skill);\n                u.reloadCrossbow(skill);\n            }\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_04_96PX.png",
