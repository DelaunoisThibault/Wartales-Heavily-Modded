									"tipText": "Boire",
									"cost": {
										"itemCost": [
											{
												"item": "Beer",
												"qty": 1,
												"orSameType": true
											}
										]
									},
									"gains": {},
									"props": {}
								}
							],
							"personality": "PersCompassionate"
						},
						{
							"introDialog": [
								{
									"text": "[MX]Est-ce que j'ai fait des erreurs ? Peut-être.\nEst-ce que mes compagnons ont des raisons de m'en vouloir ? Sans doute.\nMais est-ce que je mérite d'être exclu comme ça ? Ils évitent même mon regard !"
								},
								{
									"text": "[FX]Est-ce que j'ai fait des erreurs ? Peut-être.\nEst-ce que mes compagnons ont des raisons de m'en vouloir ? Sans doute.\nMais est-ce que je mérite d'être exclue comme ça ? Ils évitent même mon regard !"
								}
							],
							"choices": [],
							"personality": "PersPragmatic"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Toute la troupe s'est liguée contre moi ! Ça ne peut pas continuer ainsi, il faut que je fasse quelque chose, ou ils vont finir par me tuer dans mon sommeil !"
								}
							],
							"choices": [],
