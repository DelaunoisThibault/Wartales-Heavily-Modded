					"range": {},
					"props": {
						"globalEvents": true,
						"vars": {
							"value1": 10
						}
					},
					"script": "function onBeginAction() {\n\tif( isMeleeWithAlly(skill.unit) ) {\n\t\tskill.unit.addStatusPersist(Status.Unity, skill);\n\t} else skill.unit.cancelStatus(Status.Unity, skill);\n}",
					"notes": "",
					"iconeDone": true,
