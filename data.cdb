				{
					"id": "CenserHealOnPurge",
					"name": "Purge guérisseuse",
					"desc": "Lorsque cette unité <b>purge</b>, elle soigne les alliés à moins de ::range:: mètres de ::value1::% de leur santé maximale et leur retire leurs malus.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 10,
							"range": 5
						}
					},
					"script": "function onCenserPurged(c) {
						for ( a in getAllies(skill.unit) ) {
							if (getDistance(skill.unit, a) < vars.range){
								a.heal( skill, ceil(a.stats.health*vars.value1/100) );
								for( st in a.getAllStatus() ) {
									if( st.isMalus && !st.isInjury ) {
										st.cancel();
									}
								}
							}
						}
					}",
					"notes": "",
					"done": 1,
