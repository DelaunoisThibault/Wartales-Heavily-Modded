				{
					"id": "ProtectTheCelestiumConsole",
					"name": "Protéger la console du Célestium !",
					"desc": "Quand la console du Célestium subit une attaque, ::value1::% des dégâts sont redirigés vers cette unité.\nSi cette unité a déjà joué ce tour, les dégâts de cette attaque sont réduits de ::value2::%.",
					"mode": 6,
					"range": {},
					"props": {
						"vars": {
							"value1": 50,
							"value2": 50
						},
						"globalEvents": true
					},
					"script": "function onSkillEval(a) {
						if ( hasPlayed(skill.unit) ){
							for ( t in a.getTargets() ){
								if ( isValidUnit(t.target) ) {
									for ( t in a.getTargets() ) t.baseDamageBonus -= vars.value2;
									return;
								}
							}
						}
					}
					function onBeforeHit(a) {
						if (isValidUnit(a.target)) {
							var d = ceil(a.dmg * vars.value1 / 100);
							a.dmg -= d;
							skill.unit.damages(skill, d);
						}
					}
					function isValidUnit(u) {
						if( isPlayer(skill.unit) ) return false;
						if (u == skill.unit) return false;
						if (u.side != skill.unit.side) return false;
						if (u.kind != UnitClass.CelestiumConsole ) return false;
						return true;
					}",
