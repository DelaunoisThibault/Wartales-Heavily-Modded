				{
					"id": "E3CitySkill",
					"name": "",
					"desc": "",
					"mode": 8,
					"range": {},
					"props": {
						"vars": {
							"count": 1,
							"timelinePos": 0
						},
						"globalEvents": true
					},
					"script": "function onBeginRound() {\n\tvar c = getEventCount();\n\tif (c == 0) return;\n\n\tvar nb = max(1, floor((getPlayerUnits().length - 1) / c));\n\tnb = min(nb, 13);\n\tvars.count = nb;\n\tvars.timelinePos = floor((getTimelineLength() - 1) / nb) - 1;\n\n\tvar sk = [Skill.E3FireSkillZone, Skill.E3TomatoSkillZone, Skill.E3CobblestoneSkillZone];\n\tfor (_ in 0...nb) {\n\t\tcastRandom(pickRandom(sk));\n\t\tvars.count--;\n\t}\n}\n\nfunction getEventCount () { // nb of allies for one event in battle\n\tif (isChaosValid()) {\n\t\tvar chaos = getChaos();\n\t\tif (chaos < 20)\n\t\t\treturn 0;\n\t\tif (chaos < 50)\n\t\t\treturn 8;\n\t\tif (chaos < 70)\n\t\t\treturn 4;\n\t}\n\treturn 2;\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
