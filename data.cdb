				},
				{
					"id": "ConfessionOrmanceFinished1",
					"data": [
						{
							"introDialog": [
								{
									"text": "[XX]Est-ce qu'on a bien fait de laisser Sigurdr en charge d'Ormance ? Il s'est avéré un allié plus fiable que je ne le pensais, mais les mots de Liv continuent de me trotter dans la tête. Un Skelmar peut-il se contenter d'un seul Comté ?"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"trait": [
												{
													"inf": "BardBorn",
													"target": 0
												}
											],
											"text": "[XX]Refouler ses doutes et fêter leur victoire sur les Skelmars."
										}
									],
									"tipText": "Célébrer",
									"cost": {},
									"gains": {
										"relation": [
