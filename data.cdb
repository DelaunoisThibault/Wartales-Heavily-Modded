											{
												"qty": -3,
												"inf": "ActionPoint"
											}
										]
									}
								}
							],
							"personality": "PersAggressive"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Faire face à la Meute Fantôme est au-dessus de mes forces ! Je ne contrôlais plus rien, je ne me suis même pas rendu compte que je fuyais !"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Analyser le combat et en tirer une stratégie."
										}
									],
									"tipText": "Réfléchir",
									"cost": {},
									"props": {},
									"gains": {
										"tiredness": 0.2,
										"item": [
											{
												"qty": -3,
												"inf": "Happiness"
											},
											{
												"qty": -2,
												"inf": "ActionPoint"
											}
										]
									}
								}
							],
							"personality": "PersPragmatic"
						},
						{
							"introDialog": [
								{
									"text": "[MX]La prochaine fois, je ne me laisserai pas faire ! La terreur ne prendra pas le contrôle, j’éliminerai les monstres de la Meute Fantôme comme un vrai Traqueur, et j’obtiendrai un beau renfort d’armure. Il faut juste que je cesse de trembler d’ici là."
								},
								{
									"text": "[FX]La prochaine fois, je ne me laisserai pas faire ! La terreur ne prendra pas le contrôle, j’éliminerai les monstres de la Meute Fantôme comme une vraie Traqueuse, et j’obtiendrai un beau renfort d’armure. Il faut juste que je cesse de trembler d’ici là."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Trouver l'apaisement dans la prière."
										}
									],
									"tipText": "Prier",
									"cost": {
										"itemCost": [
											{
												"item": "Influence",
												"qty": 40
											}
										]
									},
									"props": {},
									"gains": {
										"attributePoint": [
											{
												"target": 0,
												"bonus": "Willpower"
											}
										]
									}
								}
							],
							"personality": "PersOptimist"
						},
						{
							"introDialog": [
								{
									"text": "[MX]Ces yeux rouges… je les vois dès que j’essaie de dormir, j’ai l’impression de sentir la présence de la Meute dans chaque bosquet. Je refuse de retourner affronter ces monstres, tant pis si les autres me prennent pour un lâche !"
								},
								{
									"text": "[FX]Ces yeux rouges… je les vois dès que j’essaie de dormir, j’ai l’impression de sentir la présence de la Meute dans chaque bosquet. Je refuse de retourner affronter ces monstres, tant pis si les autres me prennent pour une lâche !"
