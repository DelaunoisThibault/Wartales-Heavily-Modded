				},
				{
					"id": "PitH1_BossLightning",
					"name": "Prémonition",
					"desc": "Met hors-combat l'unité ennemie la plus éloignée.",
					"mode": 4,
					"range": {},
					"props": {
						"hitFx": "prefabs/fx/environment/lightning/BattleLightning.fx",
						"flags": 8194
					},
					"script": "function onSkill() {\n\tvar foes = getFoes(skill.unit, false);\n\tvar t = null;\n\tvar maxDist = 0.0;\n\tfor( u in foes ) {\n\t\tif( !u.isAlive() ) continue;\n\t\tvar d = getDistance(u, skill.unit);\n\t\tif( d > maxDist ) {\n\t\t\tt = u;\n\t\t\tmaxDist = d;\n\t\t}\n\t}\n\n\tattackTarget(t);\n}\n\nfunction onEval(a) {\n\ta.dmg = a.forcedDmg = a.target.health + a.target.armor;\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_03_96PX.png",
						"size": 96,
						"x": 0,
						"y": 10
					}
				},
				{
					"id": "PitH1_BossPassive",
					"name": "Décharge",
					"desc": "Si l'unité est frappée par un éclair, elle perd ::value1::% de sa [MaxHealth] au lieu de mourir.\nSi l'unité a [PitH1_5_Loaded], elle perd ::value1::% de sa [MaxHealth] supplémentaire, fait apparaître des éclairs autour d'elle et perd [PitH1_5_Loaded].",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 15,
							"nbCasts": 2
						},
						"globalEvents": true
					},
					"script": "function isLightning(s) {\n\treturn switch( s ) {\n\t\tcase Skill.PitH1_BossLightning, Skill.PitH1_LightningBolt, Skill.Lightning, Skill.SportLightning, Skill.CelestiumLightning: true;\n\t\tdefault: false;\n\t}\n}\n\nfunction onSkillEval(a) {\n\tif( !isLightning(a.kind) )\n\t\treturn;\n\tvar ts = a.getTargets().filter(t -> t.target == skill.unit);\n\tif( ts.length == 0 ) return;\n\tvar t = ts[0];\n\n\tvar p = vars.value1 * (skill.unit.hasStatus(Status.PitH1_5_Loaded) ? 2 : 1);\n\tt.dmg = t.forcedDmg = skill.unit.getPercentHealth(p);\n}\n\nfunction onBeforeHit(a) {\n\tif( a.target != skill.unit || !isLightning(a.skillKind) )\n\t\treturn;\n\tif( skill.unit.hasStatus(Status.PitH1_5_Loaded) ) {\n\t\tfor( _ in 0...vars.nbCasts )\n\t\t\tcastSkill(Skill.PitH1_LightningBoltBossZone, { unit: skill.unit }, skill, true );\n\t\tskill.unit.consumeStatus(Status.PitH1_5_Loaded);\n\t}\n}",
