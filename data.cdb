							"value2": 25
						}
					},
					"script": "function onSkillEval(a) {
						var p = 100 * (skill.unit.health / skill.unit.stats.health);
						for( t in a.getTargets() ) {
							if (t.target == skill.unit && p <= vars.value2) {
								t.baseDamageBonus -= vars.value1;
								for( st in skill.unit.getAllStatus() ) {
									if( st.kind == Status.Poison || st.kind == Status.Bleeding || st.kind == Status.Burning) {
										st.cancel();
									}
								}
							}
						}
					}
					function onStatus(s) {
						var p = 100 * (skill.unit.health / skill.unit.stats.health);
						if ( p <= vars.value2) {
							if (s.unit != skill.unit) return;
							if (s.kind != Status.Poison && s.kind != Status.Bleeding && s.kind != Status.Burning) return;
							spawnFx();
							s.cancel();
						}
					}",
					"notes": "",
					"icon": {
