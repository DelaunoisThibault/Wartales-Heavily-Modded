					"iconeDone": true,
					"done": 2
				},
				{
					"id": "PrisonnerPurge",
					"name": "Purge de peine",
					"desc": "Inflige [DMG] aux ennemis dans la zone et soigne de ::value1::% de leur [Health] maximum les alliés dans la zone. \nUniquement utilisable par des manipulateurs d'encensoirs. \nSelon le type d'unité, un effet différent est appliqué : \nCorbeau : Applique ::value2:: [Poison]s aux ennemis touchés, \nAbraseur : Inflige une seconde ligne de dégâts d'un montant égal à la moitié de la première ligne de dégâts aux ennemis touchés, \nEmbaumeur : Applique ::value2:: [Fever]s aux ennemis touchés, \nVate : Le soin sur les alliés est doublé, \nLogisticien : Applique [Fragility] pendant ::value3:: round aux ennemis dans la zone, \nMagister : Applique [Relentlessness] aux alliés engagés dans la zone.",
					"mode": 5,
					"range": {
						"type": 0,
						"radius": 4,
						"allowedTargets": 0,
						"baseDistance": 0
					},
					"props": {
						"dmgAttribute": 1,
						"cursor": "CursorHeal",
						"tooltipStatus": [
							{
								"st": "Poison"
							},
							{
								"st": "Fever"
							},
							{
								"st": "Fragility"
							},
							{
								"st": "Relentlessness"
							}
						],
						"vars": {
							"allowed": false,
							"dmgBonus": 0,
							"value1": 10,
							"value2": 2,
							"value3": 1,
							"dist": 4,
							"secondDmgDone": 0
						},
						"isAttack": true,
						"apCost": 1,
						"specialAnim": "ActivateWide",
						"extraFx": "prefabs/fx/fight/Thaumaturge/Purge_IB.fx",
						"preventEngage": true
					},
					"script": "function onBeginAction() {
						vars.allowed = false;
						if( skill.unit.hasSkill(Skill.Purge) ) {
							vars.allowed = true;
						}
					}
					function onEval(a) {
						if( !skill.unit.hasSkill(Skill.Purge) ) {
							dontAllow();
						}
						vars.secondDmgDone = a.dmg / 2;
					}
					function onHit(a){
						if( skill.unit.kind == UnitClass.Raven ){
							a.target.addStatus(Status.Poison, vars.value2);
						}
						if( skill.unit.kind == UnitClass.Embalmer ){
							a.target.addStatus(Status.Fever, vars.value2);
						}
						if( skill.unit.kind == UnitClass.Abrader ){
							a.target.damages(skill, vars.secondDmgDone);
						}
						if( skill.unit.kind == UnitClass.Logistician ){
							a.target.addStatus(Status.Fragility, vars.value3, true);
						}
					}
					function onPostSkill(){
						if( skill.unit.kind == UnitClass.Vate ){
							vars.value1 = 20;
						} else {
							vars.value1 = 10;
						}
						for( u in getAllies(skill.unit) ) {
							if( getDistance(skill.unit, u) <= vars.dist ) {
								u.heal(skill, u.getPercentHealth(vars.value1));
								if( skill.unit.kind == UnitClass.A2Thaumaturge ){
									if( u.isEngaged() ){
										u.addStatus(Status.Relentlessness);
									}
								}
							}
						}
					}",
					"notes": "",
					"done": 2,
					"minDmg": 6,
					"maxDmg": 8,
					"icon": {
						"file": "ui/Icons/BattleIcons_04_96PX.png",
						"size": 96,
						"x": 18,
						"y": 13
