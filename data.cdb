						"isAttack": true,
						"flagsAI": 8
					},
					"script": "function onSkill() {\n\tif( waitNextTurn() ) {\n\t\tvars.oppAttack  = 0;\n\t\tcreateZone();\n\t\treturn;\n\t}\n\tcancelZone();\n}\n\nfunction onMoveEvent(m) {\n\tm.stop(isFoe(m.unit) && !m.unit.hasStatus(Status.Champion));\n\tskill.unit.castSkill(Skill.OpportunityAttack, {unit : m.unit}, skill);\n}\nfunction onBeforeHit(a) {\n\tif (a.unit == skill.unit && a.castOrigin != null && a.castOrigin.kind == Skill.SpearsWall) {\n\t\tvars.oppAttack ++;\n\t\tif( vars.oppAttack == vars.value3 ) {\n\t\t\tcancelZone();\n\t\t}\n\t}\n}\n\nfunction onMove(m) {\n\tif( m.unit.side == skill.unit.side ) return;\n\tvar z = getZone();\n\tif( z == null || z.getKind() != skill.kind ) return;\n\tm.addZoneEvent(z,onMoveEvent);\n}",
