					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"todo": false
						}
					},
					"script": "function onBeforeSkill(a) {\n\tvar ap = a.apCost;\n\tif (ap > 0) {\n\t\tskill.unit.addStatus(Status.FreneticPower, ap);\n\t\tvars.todo = true;\n\t} else {\n\t\tvars.todo = false;\n\t}\n}\n\nfunction onSkillPlayed(a) {\n\tif (vars.todo) {\n\t\tvars.todo = false;\n\t\tcheckNeutral();\n\t}\n}\n\nfunction checkNeutral() {\n\tvar c = skill.unit.getStatusCount(Status.FreneticPower);\n\tvar v = getStatusValue(Status.FreneticPower);\n\tif (c > v && proba(ceil((v * (c - v))))) {\n\t\tif (skill.unit.engagedUnit != null) skill.unit.disengage();\n\t\tskill.unit.setNeutral();\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "PathogenicPreparation",
					"name": "Préparation d'agents pathogènes",
					"desc": "Applique ::poisonvalue:: [Poison], ::corrosionvalue:: [Corrosion], [Bleeding] et [Burning] à la cible.\n\n[Inhalation1] : Si cette compétence applique un statut déjà sur la cible, déclenche les dégâts de ce statut.\n\n[Inhalation2] : Applique ::poisonvalue2:: [Poison] et ::corrosionvalue2:: [Corrosion] supplémentaires",
					"mode": 1,
					"range": {
						"baseDistance": 8,
						"allowedTargets": 0
					},
					"props": {
						"tooltipStatus": [
							{
								"st": "Poison"
							},
							{
								"st": "Corrosion"
							},
							{
								"st": "Bleeding"
							},
							{
								"st": "Burning"
							}
						],
						"vars": {
							"poisonvalue": 2,
							"corrosionvalue": 2,
							"poisonvalue2": 2,
							"corrosionvalue2": 2,
							"meters": 4
						},
						"apCost": 1,
						"specialAnim": "Throw",
						"isAttack": true,
						"throwFx": "prefabs/fx/fight/Explosion/SmokeBomb/BlindingPowderTrowTrail.fx",
						"hitFx": "prefabs/fx/fight/Explosion/SmokeBomb/SmokeBomb.fx",
						"fxSuffix": 0
					},
					"script": "var toApply = [];\nfunction onHit(a) {\n\tif ( skill.unit.getStatusCount(Status.Inhalation) >= 1){\n\t\tfor (st in [Status.Poison, Status.Corrosion, Status.Bleeding, Status.Burning]) {\n\t\t\tif (a.target.hasStatus(st))\n\t\t\t\ttoApply.push(st);\n\t\t}\n\t}\n\tvar b = skill.unit.getStatusCount(Status.Inhalation) >= 2;\n\ta.target.addStatus(Status.Poison, (b ? vars.poisonvalue2 : 0 ) + vars.poisonvalue);\n\ta.target.addStatus(Status.Corrosion, (b ? vars.corrosionvalue2 : 0 ) + vars.corrosionvalue);\n\ta.target.addStatus(Status.Bleeding);\n\ta.target.addStatus(Status.Burning);\n\n\tif (skill.level == 2) {\n\t\tskill.unit.castSkill(Skill.PathogenicPreparation_Zone, {unit : a.target, skill : skill}, skill);\n\t}\n\n}\n\nfunction onPostSkill() {\n\tfor(st in toApply) {\n\t\tskill.target.applyDot(st);\n\t}\n\n\tif (skill.unit.getStatusCount(Status.Inhalation) >= 3) {\n\t\tskill.unit.castSkill(Skill.Censer_lvl5_2_skill, { unit : skill.unit }, skill);\n\t}\n\ttoApply=[];\n\n}",
