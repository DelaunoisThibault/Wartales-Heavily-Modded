					"script": "function onBeginAction() {\n\tif( !skill.unit.isEngaged() ) {\n\t\tvars.engaged = false;\n\t}\n}\n\nfunction onSkillPlayed(s) {\n\tif( !vars.engaged && skill.unit.isEngaged() ) {\n\t\tvars.engaged = true;\n\t\tskill.unit.addStatus(Status.Fervor, vars.value1);\n\t\tspawnFx();\n\t}\n}",
