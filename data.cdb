									"props": {}
								}
							],
							"personality": "PersDefault"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Pourquoi est-ce qu'on est revenus ici ? Je me souviens d’avoir perdu connaissance, et...\nComment sommes-nous sortis de la Sylve ? Qu'est-ce qu'il se passe dans cette forêt ?!"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Se retirer pour pleurer."
										}
									],
									"tipText": "S'isoler",
									"cost": {},
									"gains": {
										"status": [
											{
												"inf": "Sulky",
												"target": 0
											}
										]
									},
									"props": {}
								}
							],
							"personality": "PersCompassionate"
						},
						{
							"introDialog": [
								{
									"text": "[XX] Bon sang ! Je ne me souviens de rien !\nOn marchait au milieu de la Sylve, il y avait toutes ces choses autour de nous, et…\nPar saint Jéru ! Qu’est-ce qu’il nous est arrivé ?"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Noyer le traumatisme dans la boisson."
										}
									],
									"tipText": "Boire",
									"cost": {
										"itemCost": [
											{
												"item": "Beer",
												"qty": 1,
												"orSameType": true
											}
										]
									},
									"gains": {},
									"props": {}
								}
							],
							"personality": "PersAggressive"
						},
						{
							"introDialog": [
								{
									"text": "[XX] Nous avons eu de la chance de nous en tirer ! Les gens de Rigel disent qu'on peut devenir fous pour toujours dans cette forêt !\nOn doit faire plus attention. La prochaine fois pourrait être la dernière."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Se montrer plus attentif, jusqu'à l'excès."
										}
