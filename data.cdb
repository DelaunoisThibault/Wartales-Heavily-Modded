				{
					"id": "FinalChampionsPassif",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"vars": {
							"p2": false
						},
						"usableWhenLocked": true
					},
					"script": "function onSkillPlayed(a) {\n\tif (vars.p2) return;\n\tvar has = false;\n\tfor (t in a.getTargets()){\n\t\tif (t.target == skill.unit){\n\t\t\thas = true;\n\t\t\tbreak;\n\t\t}\n\t}\n\tif (!has) return;\n\tcheckLife();\n}\n\nfunction onEndTurn(){\n\tif (!isCurrentTurn(skill.unit)) return;\n\tcheckLife();\n}\n\nfunction checkLife(){\n\tif (vars.p2) return;\n\tif (skill.unit.health > 1) return;\n\tfor (s in skill.unit.getAllStatus()){\n\t\tif (s.kind != Status.PreventEngage){\n\t\t\tskill.unit.cancelStatus(s.kind);\n\t\t}\n\t}\n\tskill.unit.addStatus(Status.Recovery);\n\tvars.p2 = true;\n\tvar nbChamps = 0;\n\tfor (u in getAllUnits()){\n\t\tif (u.isAlive() && isFoe(u)){\n\t\t\tnbChamps++;\n\t\t}\n\t}\n\tif (nbChamps < 4){\n\t\tarenaNextWave();\n\t} else {\n\t\tallChampsReco();\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "CommandersResilience",
					"name": "Résilience de la Commandante",
					"desc": "Gagne [CommanderResilience] à chaque round.",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"tooltipStatus": [
							{
								"st": "CommanderResilience"
							},
							{
								"st": "CommanderRage"
							}
						],
						"vars": {
							"healthPercent": 100
						}
					},
					"script": "function onBeginRound(){\n\tskill.unit.addStatus(Status.CommanderResilience, ceil(skill.unit.stats.maxHealth * vars.healthPercent / 100));\n}\n\nfunction onBeforeHit(a){\n\tif (a.target != skill.unit) return;\n\tif (!skill.unit.hasStatus(Status.CommanderResilience)) return;\n\tvar statusCount = skill.unit.getStatusCount(Status.CommanderResilience);\n\tif (statusCount > a.dmg){\n\t\tfeedbackHiltrerdShield(skill.unit, a.dmg);\n\t\tskill.unit.consumeStatus(Status.CommanderResilience, a.dmg);\n\t\ta.dmg = 0;\n\t} else {\n\t\tfeedbackHiltrerdShield(skill.unit, statusCount);\n\t\ta.dmg -= statusCount;\n\t\tskill.unit.cancelStatus(Status.CommanderResilience);\n\t}\n}\n\nfunction onEndRound(){\n\tif (skill.unit.hasStatus(Status.CommanderResilience)){\n\t\tskill.unit.cancelStatus(Status.CommanderResilience);\n\t\tskill.unit.addStatus(Status.CommanderRage);\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_03_96PX.png",
