					"script": "function onEval(t) {\n\tt.baseDamageBonus += vars.bonus * t.target.getStatusCount(Status.Poison);\n}\n\nfunction onHit(a) {\n\tpoisonned(a.target);\n\tfor (t in getAllUnits()) {\n\t\tif (t.isMelee(a.target))\n\t\t\tpoisonned(t);\n\t}\n}\n\nfunction onDamage(a) {\n\tif( a.isCritical && !vars.done ) {\n\t\tvars.done = true;\n\t}\n}\n\nfunction onPostSkill() {\n\tif(vars.done)\n\t\tattack();\n\tvars.done = false;\n}\n\nfunction poisonned(t) {\n\tt.addStatus(Status.Poison, vars.nPoison);\n\tt.addStatus(Status.ToxicMiasm, vars.nMiasm);\n}",
