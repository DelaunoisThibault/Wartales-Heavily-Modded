											}
										]
									},
									"props": {}
								}
							],
							"personality": "PersAggressive"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Les autres me détestent.\nJe vois bien leurs regards en coin. Ils s'arrêtent de parler quand j'arrive, et ricanent dès que j'ai le dos tourné.\nSaint Jéru ! Qu'ai-je fait pour mériter ça ?"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Plonger dans le déni et la boisson."
