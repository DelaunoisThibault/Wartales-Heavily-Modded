				{
					"id": "ConfessionBelerionFinished",
					"data": [
						{
							"introDialog": [
								{
									"text": "[XX]J'espère que je survivrai assez longtemps pour raconter à mes petits-enfants nos aventures à Bélérion ! On a appris à naviguer, rencontré le descendant des empereurs d'Edoran, combattu des pirates et vaincu le Serpent de Mer. Bon sang ! Si j'avais imaginé ça quand on a donné du bois au charpentier de Tiltrën..."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"trait": [
												{
													"inf": "BardBorn",
													"target": 0
												}
											],
											"text": "[XX]Fêter la fin du voyage dans l'Archipel."
										}
									],
									"tipText": "Célébrer",
									"cost": {},
									"gains": {
										"relation": [
											{
