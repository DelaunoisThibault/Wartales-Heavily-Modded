				},
				{
					"id": "TheBeastMark",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"vars": {
							"value": 0
						}
					},
					"script": "function onStatusRemoved(s) {\n\tif(s.unit == skill.unit && s.kind == Status.TheBeastMark) {\n\t\tvars.value += s.count;\n\t}\n}\n\nfunction onSkillPlayed(s) {\n\tif (vars.value > 0) {\n\t\tskill.unit.damages(skill, ceil(vars.value * getStatusValue(Status.TheBeastMark)), true);\n\t\tvars.value = 0;\n\t\tif (!skill.unit.hasStatus(Status.TheBeastMark)) {\n\t\t\tskill.unit.cancelStatus(Status.TheBeastMarkManager);\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "BloodChargeStatus",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value": 5
						}
					},
					"script": "function onDamageDealt(a) {\n\tvar v : Float = vars.value * skill.unit.getStatusCount(Status.BloodCharge);\n\tv = a.dmg * (v / 100);\n\tskill.unit.heal(skill, ceil(v));\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "ToxicMiasm",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "function onEndTurn() {\n\tapply();\n}\n\nfunction apply() {\n\tvar sid = Status.ToxicMiasm;\n\tvar did = Status.Poison;\n\tfor (u in getUnits()) {\n\t\tif (isCurrentTurn(u)) {\n\t\t\tif (u == skill.unit) {\n\t\t\t\tvar count = skill.unit.getStatusCount(sid);\n\t\t\t\tfor (mu in getMeleeUnits(skill.unit))\n\t\t\t\t\tmu.addStatus(did, round(count * getStatusValue(sid)));\n\t\t\t\tskill.unit.consumeStatus(sid);\n\t\t\t} else if (u.isMelee(skill.unit)) {\n\t\t\t\tu.addStatus(did, round(skill.unit.getStatusCount(sid) * getStatusValue(sid)));\n\t\t\t\tskill.unit.consumeStatus(sid);\n\t\t\t}\n\t\t\treturn;\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "CorrosiveSmoke",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "function onEndTurn() {\n\tvar sid = Status.CorrosiveSmoke;\n\tvar did = Status.Corrosion;\n\tfor (u in getUnits()) {\n\t\tif (isCurrentTurn(u)) {\n\t\t\tif (u == skill.unit) {\n\t\t\t\tvar count = skill.unit.getStatusCount(sid);\n\t\t\t\tfor (mu in getMeleeUnits(skill.unit))\n\t\t\t\t\tmu.addStatus(did, round(count * getStatusValue(sid)));\n\t\t\t\tskill.unit.consumeStatus(sid);\n\t\t\t} else if (u.isMelee(skill.unit)) {\n\t\t\t\tu.addStatus(did, round(skill.unit.getStatusCount(sid) * getStatusValue(sid)));\n\t\t\t\tskill.unit.consumeStatus(sid);\n\t\t\t}\n\t\t\treturn;\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "FirmStand",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "var arr = [];\n\nfunction onAfterPushback(t) {\n\tif (t.target.side != skill.unit.side) {\n\t\tarr.push(t.target);\n\t}\n}\n\nfunction onSkillPlayed(s) {\n\tif (arr.length > 0) {\n\t\tfor (t in arr)\n\t\t\tskill.unit.opportunityAttack(t, skill);\n\t\tarr = [];\n\t}\n}\n\nfunction onSkillEval(s) {\n\tfor (t in s.getTargets()) {\n\t\tif (t.castOrigin != null && t.castOrigin.kind == Skill.FirmStand && t.unit == skill.unit) {\n\t\t\tt.baseDamageBonus += round(skill.unit.getStatusCount(Status.FirmStand) * getStatusValue(Status.FirmStand));\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "HealingSmoke",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {},
					"script": "function onEndRound() {\n\tskill.unit.heal(skill, skill.unit.getPercentHealth(getStatusValue(Status.HealingSmoke)));\n\tskill.unit.consumeStatus(Status.HealingSmoke);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "AllySupport",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {},
					"script": "function onEndRound() {\n\tif (skill.unit.getStatusCount(Status.AllySupport) >= getStatusValue(Status.AllySupport)) {\n\t\tfor (s in skill.unit.getAllStatus())\n\t\t\tif (s.isMalus)\n\t\t\t\tskill.unit.cancelStatus(s.kind);\n\t}\n\tskill.unit.cancelStatus(Status.AllySupport);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "TacticalAid",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "function onSkillEval(s) {\n\tif (s.unit.side == skill.unit.side && s.unit != skill.unit && s.unit.isMelee(skill.unit)) {\n\t\tfor (t in s.getTargets()) {\n\t\t\tt.criticalHitPercent += round(getStatusValue(Status.TacticalAid));\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "FleeRetreat",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {},
					"script": "function onSkillPlayed(s) {\n\tif (skill.unit.isEngaged())\n\t\tskill.unit.disengage();\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "Commanded",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "function onDamageDealt(a) {\n\tif (a.unit.side != skill.unit.side) return;\n\tif (a.unit == skill.unit) return;\n\tif (a.target.side == skill.unit.side) return;\n\tif (!a.unit.isRanked) return;\n\tif (getDistance(a.unit, skill.unit) > getStatusValue(Status.Commanded)) return;\n\tfor (f in getFoes(skill.unit))\n\t\tif (skill.unit.canOpportunityAttack(f)) {\n\t\t\tskill.unit.opportunityAttack(f, skill);\n\t\t\treturn;\n\t\t}\n}\n\nfunction onSkillEval(s) {\n\tif (s.unit == skill.unit && s.castOrigin != null && s.castOrigin.kind == skill.kind && s.kind == Skill.OpportunityAttack) {\n\t\tfor (t in s.getTargets())\n\t\t\tt.criticalHitPercent = 100;\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "RustyStatus",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {},
					"script": "function onBeginAction() {\n\tif (skill.unit.armor > 0 )\n\t\tskill.unit.addStatus(Status.RustyMalus);\n\telse\n\t\tskill.unit.consumeStatus(Status.RustyMalus);\n\n}\n\nfunction onDamageTaken(a) {\n\tif (a.target.armor <= 0 )\n\t\ta.target.consumeStatus(Status.RustyMalus);\n}\n\nfunction onEndTurn() {\n\tskill.unit.addStatus(Status.Corrosion);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "OnTheRun",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {},
					"script": "function onBeginAction() {\n\tif (skill.unit.isEngaged()) {\n\t\tskill.unit.cancelStatus(Status.OnTheRun);\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
