					"script": "function onEval(a){\n\ta.attackCount = getNbHits();\n}\n\nfunction onDamage(a) {\n\tvars.attackCount++;\n\tif (canUseDefenseStance() && vars.attackCount == getNbHits()){\n\t\ta.target.addStatus(Status.Weakening, vars.value2, true);\n\t}\n}\n\nfunction onPostSkill(){\n\tvars.attackCount = 0;\n}\n\nfunction getNbHits(){\n\tvar v = vars.value1;\n\tif (canUseAttackStance()){\n\t\tv += 1;\n\t}\n\treturn v;\n}",
