				{
					"id": "A1ArenaRuleBear",
					"name": "",
					"desc": "Au début du second round, un ours des neiges est lâché dans l'arène.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"done": false
						}
					},
					"script": "function onBeginRound() {\n\tif (!vars.done && getRound() > 1 ) {\n\t\tspawnRenfort(UnitClass.WhiteBear, 1, false);\n\t\tvars.done = true;\n\t}\n}",
					"notes": "",
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "DLC1ArenaRuleFist",
					"name": "",
					"desc": "Au moins un participant doit être équipé d'une arme de pugilat. La mort d'un pugiliste entraîne immédiatement la défaite.",
					"mode": 2,
					"range": {},
					"props": {},
					"script": "",
					"notes": "hard coded",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "DLC1ArenaRuleEngaged",
					"name": "",
					"desc": "Tant qu’une unité est engagée, elle a [Rivalry].",
					"mode": 2,
					"range": {},
					"props": {
						"tooltipStatus": [
							{
								"st": "Rivalry"
							}
						],
						"vars": {
							"hadStatus": false
						}
					},
					"script": "function onBeginAction() {\n\tif ( skill.unit.isEngaged() ) {\n\t\tskill.unit.addStatus(Status.Rivalry);\n\t}\n}\n\nfunction onStatus(a) {\n\tif (a.kind == Status.Engaged) {\n\t\tif (skill.unit.hasStatus(Status.Rivalry)) {\n\t\t\tvars.hadStatus = true;\n\t\t} else {\n\t\t\tvars.hadStatus = false;\n\t\t\tskill.unit.addStatus(Status.Rivalry);\n\t\t}\n\t}\n}\n\nfunction onStatusRemoved(a) {\n\tif (a.kind == Status.Engaged && !vars.hadStatus) {\n\t\tskill.unit.cancelStatus(Status.Rivalry);\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "DLC1ArenaRuleCriticalRage",
					"name": "",
					"desc": "Les coups critiques infligés à une unité lui font gagner ::value1:: [AnimalMarkedBonus].",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 2
						},
						"tooltipStatus": [
							{
								"st": "AnimalMarkedBonus"
							}
						]
					},
					"script": "function onDamageDealt(a) {\n\tif( a.isCritical ) {\n\t\ta.target.addStatus(Status.AnimalMarkedBonus, vars.value1);\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "A2ArenaRule1",
					"name": "",
					"desc": "Les alliés qui terminent leur tour sans être [IsInLight] gagnent [Nervousness] pendant ::val:: tours.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"val": 2
						}
					},
					"script": "function onEndTurn() {\n\tif (!skill.unit.hasStatus(Status.IsInLight) && isPlayer(skill.unit)) {\n\t\tskill.unit.addStatus(Status.Nervousness, vars.val, true);\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "A2ArenaRule2",
					"name": "",
					"desc": "S'il y a moins d'alliés que d'ennemis à la fin du tour d'un allié, il gagne [Nervousness] pendant ::val:: tours.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"val": 1
						}
					},
					"script": "function onEndTurn() {\n\tif (!isPlayer(skill.unit)) return;\n\tif (getAllies(skill.unit, true).length < getFoes(skill.unit).length)\n\t\tskill.unit.addStatus(Status.Nervousness, vars.val, true);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "A2ArenaRule3",
					"name": "",
					"desc": "La [Guard] des unités avec [Nervousness] est réduite à 0.",
					"mode": 2,
					"range": {},
					"props": {},
					"script": "function onBeginAction() {\n\tfor (u in getUnits()) {\n\t\tif (u.hasStatus(Status.Nervousness)) {\n\t\t\tif (!u.hasForceAttribute(Attribute.Guard))\n\t\t\t\tu.forceAttribute(Attribute.Guard, 0);\n\t\t} else {\n\t\t\tif (u.hasForceAttribute(Attribute.Guard))\n\t\t\t\tu.removeForceAttribute(Attribute.Guard);\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "ArenaUnitToEngage",
					"name": "",
					"desc": "<b>[TARGET]</b> doit être engagé à la fin du Round.",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"battleObjective": {
							"rewardAP": 3,
							"arenaConditions": 16
						}
					},
					"script": "function onInit() {\n\tvar units = [];\n\tfor (u in getFoeUnits()){\n\t\tif (!u.hasStatus(Status.PreventEngage)){\n\t\t\tunits.push(u);\n\t\t}\n\t}\n\tvar selectedUnit = units[randInt(0, units.length-1)];\n\tselectedUnit.addStatus(Status.Arena_DemandTarget, 1);\n}\n\nfunction onEndRound() {\n\tvar isAlive = false;\n\tfor( u in getFoeUnits() ) {\n\t\tif( u.hasStatus(Status.Arena_DemandTarget) ) {\n\t\t\tisAlive = true;\n\t\t\tif( u.isEngaged()) {\n\t\t\t\tsuccessObjective();\n\t\t\t} else {\n\t\t\t\tfailObjective();\n\t\t\t}\n\t\t}\n\t}\n\tif(!isAlive){\n\t\tsuccessObjective();\n\t}\n}",
					"notes": "",
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "ArenaUnitNoDamage",
					"name": "",
					"desc": "<b>[TARGET]</b> ne doit pas subir de dégâts.",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"battleObjective": {
							"rewardAP": 3
						}
					},
					"script": "function onInit() {\n\tvar units = getPlayerUnits();\n\tvar selectedUnit = units[randInt(0, units.length-1)];\n\tselectedUnit.addStatus(Status.Arena_DemandTarget, 1);\n}\n\nfunction onDamageTaken(a) {\n\tif (a.target.hasStatus(Status.Arena_DemandTarget)) {\n\t\tfailObjective();\n\t}\n}\n\nfunction onEndRound() {\n\tvar found = false;\n\tfor ( u in getPlayerUnits() ) {\n\t\tif (u.hasStatus(Status.Arena_DemandTarget)) {\n\t\t\tfound = true;\n\t\t\tbreak;\n\t\t}\n\t}\n\tif (found) {\n\t\tsuccessObjective();\n\t} else {\n\t\tfailObjective();\n\t}\n}",
					"notes": "",
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "ArenaAllyContact",
					"name": "",
					"desc": "Chaque compagnon doit finir son tour au contact d'un allié.",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"battleObjective": {
							"rewardAP": 3,
							"arenaConditions": 4
						}
					},
					"script": "function onEndTurn() {\n\tvar isGood = false;\n\tif (isPlayer(skill.unit)) {\n\t\tfor (u in getAllies(skill.unit)) {\n\t\t\tif (u.isMelee(skill.unit)) {\n\t\t\t\tisGood = true;\n\t\t\t}\n\t\t}\n\t\tif (isGood) {\n\t\t\tif (!skill.unit.hasStatus(Status.Arena_DemandAlreadyContribute)) {\n\t\t\t\tskill.unit.addStatus(Status.Arena_DemandAlreadyContribute);\n\t\t\t}\n\t\t}\n\t\telse {\n\t\t\tfailObjective();\n\t\t}\n\t}\n}\n\nfunction onEndRound() {\n\tvar isGood = true;\n\tfor (u in getPlayerUnits()) {\n\t\tif (u.isAlive() && !u.hasStatus(Status.Arena_DemandAlreadyContribute)) {\n\t\t\tfailObjective();\n\t\t\tisGood = false;\n\t\t}\n\t}\n\tif (isGood) {\n\t\tsuccessObjective();\n\t}\n}",
					"notes": "",
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "ArenaEnemyContact",
					"name": "",
					"desc": "Chaque compagnon doit finir son tour au contact d'un ennemi.",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"battleObjective": {
