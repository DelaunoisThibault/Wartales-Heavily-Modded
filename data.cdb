							"personality": "PersDefault"
						},
						{
							"introDialog": [
								{
									"text": "[XM] Comment a-t-on pu laisser cela arriver à ::name:: ?\nIl n’a plus rien d’humain ! Je ne le reconnais plus !\nÔ saint Jéru ! Faites qu’il reste encore un peu de lui à l’intérieur de ce corps !"
								},
								{
									"text": "[XF] Comment a-t-on pu laisser cela arriver à ::name:: !\nElle n’a plus rien d’humain ! Je ne la reconnais plus !\nÔ saint Jéru ! Faites qu’il reste encore un peu d'elle à l’intérieur de ce corps !"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Maudire le tragique destin de ::name::."
										}
									],
									"tipText": "Pleurer",
									"cost": {},
									"gains": {
										"item": [
											{
												"inf": "Happiness",
												"qty": -2
											}
										]
									},
									"props": {}
								}
							],
							"personality": "PersCompassionate"
						},
						{
							"introDialog": [
								{
									"text": "[XM] ::name:: a changé, et pas seulement physiquement. Sa manière de parler, de manger, de se comporter… plus rien n'est comme avant. C’est comme si nous avions accueilli une toute nouvelle personne. J’espère que nous ne faisons pas une erreur en le gardant avec nous."
								},
								{
									"text": "[XF] ::name:: a changé, et pas seulement physiquement. Sa manière de parler, de manger, de se comporter…plus rien n'est comme avant. C’est comme si nous avions accueilli une toute nouvelle personne. J’espère que nous ne faisons pas une erreur en la gardant avec nous."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Prévenir toute attaque nocturne en s'assurant que ::name:: a assez mangé."
