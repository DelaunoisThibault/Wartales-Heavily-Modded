				{
					"id": "Rally",
					"name": "Rassemblement",
					"desc": "[InhalationTrigger] : Soigne ::heal::% de la [MaxHealth] de cette unité, puis gagne [AllySupport] pour chaque allié à moins de ::meters:: mètres.\n\n[PurgeTrigger] : Gagne [AllySupport] pour chaque allié dans la zone, puis inflige [DMG] aux ennemis dans la zone augmenté de ::value::% par application de [AllySupport].",
					"mode": 2,
					"range": {
						"allowedTargets": 5,
						"radius": 5,
						"type": 0
					},
					"props": {
						"tooltipStatus": [
							{
								"st": "AllySupport"
							}
						],
						"vars": {
							"rage": 2,
							"heal": 20,
							"value": 30,
							"meters": 4
						},
						"dmgAttribute": 1
					},
					"script": "function getCenserHealPercent(c) {\n\treturn vars.heal / 100;\n}\n\nfunction onCenserInhaled(c) {\n\tc.st.target.heal(skill, c.st.target.getPercentHealth(getCenserHealPercent(c.inhalation) * 100.));\n\tfor (u in getAllies(c.st.target))\n\t\tif (getDistance(c.st.target, u) < vars.meters)\n\t\t\tc.st.target.addStatus(Status.AllySupport);\n}\n\nvar us = [];\nfunction onCenserPurgedHit(c) {\n\tif (c.st.target.side != skill.unit.side)\n\t\tus.push(c.st.target);\n\telse\n\t\tskill.unit.addStatus(Status.AllySupport);\n}\n\nfunction onCenserEval(c) {\n\tif (c.st.target.side == c.st.unit.side)\n\t\tc.st.attackCount = 0;\n\telse\n\t\tc.st.baseDamageBonus += vars.value * skill.unit.getStatusCount(Status.AllySupport);\n}\n\nfunction onSkillPlayed(s) {\n\tfor (u in us)\n\t\tskill.unit.castSkill(Skill.FlatteringScent_Skill, { unit : u }, skill);\n\tus = [];\n}\n\nfunction onSkillEval(s) {\n\tif (s.unit == skill.unit && s.kind == Skill.FlatteringScent_Skill){\n\t\tfor (t in s.getTargets())\n\t\t\tt.baseDamageBonus += vars.value * skill.unit.getStatusCount(Status.AllySupport);\n\t}\n}",
					"notes": "",
