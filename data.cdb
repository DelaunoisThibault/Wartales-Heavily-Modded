					},
					"mapDescriptions": []
				},
				{
					"id": "BountyBelerion",
					"title": "Vaincre",
					"description": [
						{
							"t": "<b>::roaming::</b> répand la mort sur les eaux de Bélérion. La Garde demande de l'aide."
						},
						{
							"t": "Les marchands de Gosenberg sont prêts à payer pour éliminer <b>::roaming::</b>."
						},
						{
							"t": "<b>::roaming::</b> s'est échappé de la Prison de Bélérion et compte bien se venger de la Garde. Il faut arrêter ces pirates."
						},
						{
							"t": "Plusieurs capitaines pirates se sont cotisés pour offrir une récompense à celui qui les débarrassera de <b>::roaming::</b>."
						}
					],
					"amount": 1,
					"maxAmount": 1,
					"goldBonus": 0,
