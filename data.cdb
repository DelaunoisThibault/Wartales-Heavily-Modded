				{
					"id": "BeltAccTroubled",
					"name": "Haleine de pirate",
					"desc": "Tant qu'un ennemi est engagé avec cette unité, il a [Troubled].",
					"mode": 2,
					"range": {},
					"props": {
						"tooltipStatus": [
							{
								"st": "Troubled"
							}
						],
						"globalEvents": true
					},
					"script": "var u : battle.skill.UnitView = null;\n\nfunction onBeginAction() {\n\treplaceUnit();\n}\n\nfunction onPostSkill(){\n\treplaceUnit();\n}\n\nfunction replaceUnit(){\n\tvar unit = skill.unit.isEngaged() ? skill.unit.engagedUnit : null;\n\tif (u != unit){\n\t\tif (u != null && u.hasStatus(Status.Troubled))\n\t\t\tu.cancelStatus(Status.Troubled);\n\t\tu = unit;\n\t}\n\tif (unit != null && !u.hasStatus(Status.Troubled))\n\t\tu.addStatus(Status.Troubled);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "BeltAccSeaSerpent",
					"name": "Sécrétion du Serpent des Mers",
					"desc": "Chaque fois qu'une compétence inflige des dégâts, applique [Irritation].",
