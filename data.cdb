					"script": "function onPostSkill() {\n\tvar r = skill.radius;\n\tvar n = 0;\n\tfor (a in getAllies(skill.unit)) {\n\t\tif (getDistance(skill.unit, a) < r) {\n\t\t\tn++;\n\t\t}\n\t}\n\tif (n > 0) {\n\t\tskill.unit.addStatus(Status.AnimalMarkedBonus, n * vars.value);\n\t}\n}\n\nfunction onEval(a) {\n\tif (a.target.side == skill.unit.side) {\n\t\ta.cancelAttack = true;\n\t}\n}",
