					"script": "function onBeginAction() {\n\tcomputeStackBonus();\n}\n\nfunction onSkillEval(s) {\n\tvar bonus = computeStackBonus();\n\tfor( t in s.getTargets() ) {\n\t\tt.baseDamageBonus += bonus;\n\t}\n}\n\nfunction computeStackBonus() {\n\tvar nb = 0;\n\tfor( st in skill.unit.getAllStatus() ) {\n\t\tif( st.isBonus ) {\n\t\t\tnb++;\n\t\t}\n\t}\n\tvars.stackBonus = nb * vars.value1;\n\treturn vars.stackBonus;\n}",
