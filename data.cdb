						"priority": 4
					},
					"done": true
				},
				{
					"id": "ConfessionLudernFinished2",
					"data": [
						{
							"introDialog": [
								{
									"text": "[XX]Les méthodes d'Alazar sont radicales, c'est sûr, mais faut bien lutter contre le fanatisme ! Si les reliques des Anciens peuvent faire progresser la Connaissance, de quel droit Harag les garderait enfermées dans un Tombeau ?"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"trait": [
												{
													"inf": "BardBorn",
													"target": 0
												}
											],
											"text": "[XX]Fêter la victoire de la Connaissance sur l'obscurantisme."
										}
									],
									"tipText": "Célébrer",
									"cost": {},
									"gains": {
										"relation": [
											{
												"qty": 1,
												"target": 2
											}
										],
										"item": [
											{
												"inf": "Happiness",
