							}
						],
						"vars": {
							"n": 4,
							"n2": 5
						}
					},
					"script": "function onCenserInhaled(c) {\n\tif (!c.st.target.consumeStatus(Status.Poison))\n\t\tc.st.target.heal(skill, c.st.target.getPercentHealth(vars.n2));\n}\n\nfunction onCenserPurgedHit(c) {\n\tc.st.target.addStatus(Status.ToxicMiasm, c.inhalation);\n}",
