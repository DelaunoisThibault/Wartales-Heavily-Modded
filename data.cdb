				{
					"id": "ConfessionOrmanceFinished4",
					"data": [
						{
							"introDialog": [
								{
									"text": "[MX]Eh bien ! Si je m’étais attendu à voir la Comtesse Montrevel et Sigurdr assiéger Roc-Gaillard main dans la main… ! Y’en a qui n’ont pas perdu leur temps pendant qu’on libérait les baronnies !"
								},
								{
									"text": "[FX]Eh bien ! Si je m’étais attendue à voir la Comtesse Montrevel et Sigurdr assiéger Roc-Gaillard main dans la main… ! Y’en a qui n’ont pas perdu leur temps pendant qu’on libérait les baronnies !"
								}
							],
							"choices": [
