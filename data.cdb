					"script": "function onEndRound() {\n\tfor( u in getPlayerUnits() ) {\n\t\tif( u.isWerewolf || u.isAnimal ) continue;\n\t\tif( u.engagedUnit != null && u.engagedUnit.isWerewolfForm ) {\n\t\t\tgainsSanity(-vars.sanity);\n\t\t\tbreak;\n\t\t}\n\t}\n}",
