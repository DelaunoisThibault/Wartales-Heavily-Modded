				{
					"id": "AnimAccWarCollarRageEffect",
					"name": "Enragement perpétuel",
					"desc": "À la fin de son tour, cette unité perd ::value1::% de sa [Health] maximum pour gagner ::value2:: [AnimalMarkedBonus].",
					"mode": 2,
					"range": {},
					"props": {
