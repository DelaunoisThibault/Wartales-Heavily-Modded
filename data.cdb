					"range": {},
					"props": {
						"tooltipStatus": [
							{
								"st": "Weakening"
							}
						],
						"vars": {
							"value1": 30,
							"value2": 1
						}
					},
					"script": "function onDamageDealt(a) {\n    var chance = vars.value1;\n    if(a.isPatience())\n        chance *= 2;\n\tif ( proba(vars.value1) ) {\n\t\ta.target.addStatus(Status.Weakening, vars.value2);\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "OilCloudy",
					"name": "",
					"desc": "Chaque fois qu'une compétence de précision inflige des dégâts, à ::value1::% de chances de ricocher sur un ennemi à moins de ::value2:: mètres de la cible.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 10,
							"value2": 4,
							"factor": 1
						}
					},
					"script": "function onDamageDealt(a) {\n    if(a.isPrecisionSkill() && proba(vars.value1)){\n        var potentialTargets = getFoes(a.unit);\n        var target = null;\n        var minDist = 999999.;\n        for(t in potentialTargets){\n            if( t == a.target ){\n                continue;\n            }\n            var dist = getDistance(t, a.target);\n            if(dist < minDist && dist < vars.value2){\n                minDist = dist;\n                target = t;\n            }\n        }\n        if(target != null){\n            var dmg = ceil(a.dmgDealt * vars.factor);\n            target.damages(skill, dmg);\n        }\n    }\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "OilApothecary",
					"name": "",
					"desc": "Chaque fois que cette unité termine son tour adjacente à un allié sans être engagée, elle le soigne de ::value1::% de sa [MaxHealth].",
