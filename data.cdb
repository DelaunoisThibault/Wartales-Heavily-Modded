					},
					"script": "function onBeginAction() {\n\tvar u = getAllies(skill.unit, true);\n\tvar eu = getFoes(skill.unit);\n\tif( u.length < eu.length ) {\n\t\tif( !skill.unit.hasStatus(Status.Protection) || !skill.unit.hasStatus(Status.Brutality) ) {\n\t\t\tspawnFx();\n\t\t}\n\t\tskill.unit.addStatusPersist(Status.Protection, skill);\n\t\tskill.unit.addStatusPersist(Status.Brutality, skill);\n\t} else {\n\t\tskill.unit.cancelStatus(Status.Protection, skill);\n\t\tskill.unit.cancelStatus(Status.Brutality, skill);\n\t}\n}",
