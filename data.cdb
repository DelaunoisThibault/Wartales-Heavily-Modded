				{
					"id": "CurativePreparation",
					"name": "Préparation curative",
					"desc": "Soigne un allié de ::value1::% de sa [Health] maximum et lui retire ses malus.\n\n[Inhalation1] : Ricoche sur l'allié le plus proche de la cible dans la limite de ::dist:: mètres.\n\n[Inhalation2] : La cible gagne [Deflection].",
					"mode": 0,
					"range": {
						"baseDistance": 8,
						"allowedTargets": 1,
						"radius": 4
					},
					"props": {
						"vars": {
							"value1": 30,
							"value2": 1,
							"dist": 3
						},
						"cursor": "CursorHeal",
						"apCost": 1,
						"specialAnim": "Throw",
						"throwFx": "prefabs/fx/fight/Explosion/SmokeBomb/BlindingPowderTrowTrail.fx",
						"hitFx": "prefabs/fx/fight/Explosion/SmokeBomb/SmokeBomb.fx",
						"tooltipStatus": [
							{
								"st": "Deflection"
							}
						]
					},
					"script": "function onSkill() {\n\tplay();\n\tfor ( t in skill.getTargets()){\n\t\tvar inhCount =  skill.unit.getStatusCount(Status.Inhalation);\n\t\tvar malus : Array<st.Status> = getMalus(t.target, true);\n\n\t\tif (skill.unit.getStatusCount(Status.Inhalation) >= 2) {\n\t\t\tt.target.addStatus(Status.Deflection);\n\t\t}\n\t\tt.target.heal(skill, t.target.getPercentHealth(vars.value1), true);\n\t}\n}\n\nfunction onSkillEval(a) {\n    if( skill.unit.getStatusCount(Status.Inhalation) >= 1) {\n\t\tfor ( t in a.getTargets()) {\n\t\t\tvar closest = getClosest(t.target);\n\t\t\tif (closest != null) a.addTarget(closest, true);\n\t\t}\n    }\n}\n\nfunction onPostSkill() {\n\tif (skill.unit.getStatusCount(Status.Inhalation) >= 3) {\n\t\tskill.unit.castSkill(Skill.Censer_lvl5_2_skill, { unit : skill.unit }, skill);\n\t}\n}\n\nfunction getRangeRadius(r) {\n\treturn skill.unit.getStatusCount(Status.Inhalation) < 1 ? 0 : r;\n}\n\nfunction getHealPercent() { return vars.value1/100; }\n\nfunction getClosest(u) {\n\tvar closest = null;\n\tvar minDist = 1000.0;\n\tfor (a in getAllies(u)) {\n\t\tvar dist = getDistance(u, a);\n\t\tif ( dist < minDist && dist < vars.dist) {\n\t\t\tclosest = a;\n\t\t\tminDist = dist;\n\t\t}\n\t}\n\treturn closest;\n}\n\nfunction getMalus(u, removeAll) {\n\tvar malus = [];\n\tfor( st in u.getAllStatus() ) {\n\t\tif( st.isMalus ) {\n\t\t\tmalus.push(st);\n\t\t\tif (removeAll)\n\t\t\t\tu.cancelStatus(st.kind);\n\t\t}\n\t}\n\treturn malus;\n}",
