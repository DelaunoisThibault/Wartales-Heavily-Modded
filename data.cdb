					"script": "function onSkillEval(s) {\n    for (t in s.getTargets())\n        if (t.target.isObject)\n            t.forcedDmg = 1;\n}\n\nfunction onBeginRound() {\n    if (getRound() == 1)\n        skill.unit.castSkill(Skill.BossPitE1_ZoneSkill, {unit : skill.unit}, skill);\n}",
