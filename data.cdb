					"script": "function onBeginRound(){\n\tif (getRound() == 1)\n\t\tskill.unit.addStatus(Status.AttackStance);\n}\n\nfunction onBeginAction(){\n\tif (skill.unit.hasSkill(Skill.Adaptation)){\n\t\tvars.allowed = true;\n\t\treturn;\n\t}\n\tvars.allowed = !hasPlayedSkillInRound(skill.unit, Skill.DefenseStance);\n}\n\nfunction onSkill(){\n\tskill.unit.cancelStatus(Status.DefenseStance);\n\tskill.unit.addStatus(Status.AttackStance);\n}",
