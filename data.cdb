					"done": 2,
					"iconeDone": true
				},
				{
					"id": "BeltAccHealCostly",
					"name": "Suture",
					"desc": "Subit ::val1::% de [MaxHealth] puis se soigne de ::val2:: fois les dégâts subis. Inutilisable si l'unité a encore de l'[Armor].",
					"mode": 4,
					"range": {},
					"props": {
						"specialAnim": "Heal",
