				{
					"id": "BountySkelmar",
					"title": "Vaincre",
					"description": [
						{
							"t": "<b>::roaming::</b> a réchappé à la Garde et continue à faire régner la terreur à Ormance. Quelqu’un doit les arrêter."
						},
						{
							"t": "<b>::roaming::</b> a refusé de quitter Ormance et s’acharne à piller le Comté. Le bourgmestre de Lycie offre une récompense pour leur élimination."
						},
						{
							"t": "Prétendument converti à la religion de la Lumière, <b>::roaming::</b> a pourtant été vu en train de piller une église. L’Inquisition exige son extermination."
						},
						{
							"t": "Bien qu’isolé, <b>::roaming::</b> n’a pas renoncé à la conquête d’Ormance. La Garde demande à ce qu’on les ramène définitivement à la réalité."
						}
					],
					"amount": 1,
					"maxAmount": 1,
					"goldBonus": 0,
