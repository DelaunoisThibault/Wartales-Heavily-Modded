						"flags": 128,
						"globalEvents": true
					},
					"script": "function onZoneIn(a) {\n\tif (!a.target.hasStatus(Status.Blind)){\n\t\ta.target.addStatus(Status.Blind, 1, false, skill);\n\t}\n}\n\nfunction onZoneMoveEnd(a) {\n\tif (!a.target.hasStatus(Status.Blind)){\n\t\ta.target.addStatus(Status.Blind, 1, false, skill);\n\t}\n}\n\nfunction onZoneOut(a) {\n\tif (a.target.hasStatusPersist(Status.Blind, skill)){\n\t\ta.target.cancelStatus(Status.Blind);\n \t}\n}\n\nfunction onZoneRemove(a) {\n\tfor ( t in a.getTargets()) {\n\t\tif (t.hasStatusPersist(Status.Blind, skill)){\n\t\t\tt.cancelStatus(Status.Blind);\n\t\t}\n\t}\n}",
					"notes": "",
