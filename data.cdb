					"script": "function onBeginAction() {\n\tvar levelfactor = skill.level == 2 ? 2 : 1;\n\tvar charge = skill.unit.getStatusCount(Status.BloodCharge) * levelfactor;\n\tvar protection = skill.unit.getStatusCount(Status.FurProtection_Guard);\n\tvar diff = charge - protection;\n\tif (diff > 0 ) {\n\t\tskill.unit.addStatus(Status.FurProtection_Guard, diff);\n\t} else if (diff < 0) {\n\t\tskill.unit.consumeStatus(Status.FurProtection_Guard, -diff);\n\t}\n}",
