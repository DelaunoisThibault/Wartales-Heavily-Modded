						],
						"globalEvents": true
					},
					"script": "function onDamageDealt(a) {\n\tif (a.unit == skill.unit)\n\t\ta.target.addStatus(Status.Irritation);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "BeltAccLighter",
					"name": "Briquet",
					"desc": "Quand cette unité applique [Burning], déclenche immédiatement les effets de [Burning] à la cible.",
					"mode": 2,
					"range": {},
					"props": {
						"tooltipStatus": [
