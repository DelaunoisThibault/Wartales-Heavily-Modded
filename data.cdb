						"globalEvents": true
					},
					"script": "function onBeforeHit(a) {
						if( a.target == skill.unit && isPlayer(skill.unit) && !skill.unit.hasSkill(Skill.ImmortalityWerewolf) && !skill.unit.hasSkill(Skill.LichSuperiority) ){
							var d = ceil(a.dmg * vars.value3 / 100);
							a.dmg -= d;
						}
					}
					function onSkillEval(z) {
						for (t in z.getTargets()){
							if (t.target == skill.unit && isPlayer(skill.unit) && !skill.unit.hasSkill(Skill.ImmortalityWerewolf) && !skill.unit.hasSkill(Skill.LichSuperiority)){
								t.baseDamageBonus -= vars.value3;
							}
							if ( z.unit == skill.unit && isPlayer(skill.unit) && !skill.unit.hasSkill(Skill.LichSuperiority) ){
								t.baseDamageBonus += vars.value2;
							}
						}
					}",
