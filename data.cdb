						"throwModel": "chars/Weapons/LeftHand_Dagger_01.fbx"
					},
					"script": "function onSkillPlayed(s) {\n\tif (s.kind == Skill.KnockOut) return;\n\tvar minD : Float = skill.distance;\n\tvar minFoe = null;\n\tif ( skill.unit.isEngaged() ){\n\t\tminFoe = skill.unit.engagedUnit;\n\t}\n\telse for( u in getFoes(skill.unit, true) ) {\n\t\tvar d = getDistance(skill.unit, u);\n\t\tif( d < minD && !u.isInFog()) {\n\t\t\tminD = d;\n\t\t\tminFoe = u;\n\t\t}\n\t}\n\tif (minFoe != null) {\n\t\tspawnFx();\n\t\tattackTarget(minFoe);\n\t\tif ( skill.level == 2 ) {\n\t\t\tskill.unit.movePoints = skill.unit.getMaxMovePoints();\n\t\t}\n\t}\n}",
