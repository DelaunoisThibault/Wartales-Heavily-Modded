				{
					"id": "Turnaround",
					"name": "Volte-face",
					"desc": "Inflige [DMG] à la cible, l'attire en mêlée pour l’engager puis échange sa place avec elle.",
					"mode": 0,
					"range": {
						"baseDistance": 5
