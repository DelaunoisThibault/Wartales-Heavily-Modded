						"vars": {
							"done": false,
							"todo": false,
							"value": 4
						},
						"tooltipStatus": [
							{
								"st": "Reload"
							}
						]
					},
					"script": "function onSkillPlayed(a) {\n\tif (vars.todo && !vars.done) {\n\t\tvars.done = true;\n\t\tskill.unit.reloadCrossbow(skill);\n\t}\n}\n\nfunction onDamageDealt(t) {\n\tif (!vars.todo && t.target.side != skill.unit.side) {\n\t\tvar b = true;\n\t\tfor (a in getAllies(t.target)) {\n\t\t\tif (!a.isObject && getDistance(t.target, a) < vars.value) {\n\t\t\t\tb = false;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t\tif (b) {\n\t\t\tvars.todo = true;\n\t\t}\n\t}\n}\n\nfunction onEndRound() {\n\tvars.done = false;\n\tvars.todo = false;\n}\n\nfunction getAITargetScore(a) {\n\tfor ( t in getAllies(a.target)) {\n\t\tif (getDistance(t, a.target) < vars.value){\n\t\t\treturn 0;\n\t\t}\n\t}\n\treturn 200;\n}",
