				{
					"id": "BeltAccLycanTransformExplosive",
					"name": "Solution transformante explosive",
					"desc": "Lorsque l'[Armor] de cette unité lycanthrope est détruite, elle se transforme et gagne [Fury].",
					"mode": 2,
					"range": {},
					"props": {
