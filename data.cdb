				{
					"id": "WarResilience",
					"name": "Résilience martiale",
					"desc": "Les [DamageBonusPercent] et [CritHitPercent] de cette unité augmentent proportionnellement à sa vie manquante.\nLes [DamageTakenPercent] et [CritHitPercent] subis de cette unité sont réduits proportionnellement à sa vie manquante. (Max : ::max::%).",
					"mode": 2,
					"range": {},
					"props": {
						"descPassiveGroup": "[GROUPTYPE] : [DamageBonusPercent] et [CritHitPercent] augmentés proportionnellement à la vie manquante.\n[DamageTakenPercent] et [CritHitPercent] subis reduits proportionnellement à la vie manquante. (Max : ::max::%)",
						"globalEvents": true,
						"vars": {
							"value": 1,
							"max": 50
						}
					},
					"script": "function onSkillEval(a) {\n\tvar percent = floor(100 * (1 - skill.unit.health / skill.unit.stats.health));\n\tif (percent > vars.max)\n\t\tpercent = vars.max;\n\tfor (t in a.getTargets()) {\n\t\tif (a.unit == skill.unit) {\n\t\t\tt.baseDamageBonus += percent;\n\t\t\tt.criticalHitPercent += percent;\n\t\t}\n        if (t.target == skill.unit) {\n            t.baseDamageBonus -= percent;\n            t.criticalHitPercent -= percent;\n\t    }\n\t}\n}",
