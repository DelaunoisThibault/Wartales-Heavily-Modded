					"script": "function onDamageTaken(a) {\n    check(a);\n}\n\nfunction onDamageDone(a) {\n    check(a);\n}\n\nfunction check(a) {\n    if (vars.done) return;\n    if (a.target != skill.unit) return;\n    if (!a.damageHealth && a.damagedHealth == 0) return;\n    var valids = [];\n    if (a.target.engagedUnit != null)\n        valids.push(a.target.engagedUnit);\n    else\n        for (u in getFoes(a.target))\n            if (u.isMelee(a.target))\n                valids.push(u);\n    if (valids.length == 0) return;\n    vars.done = true;\n    skill.unit.castSkill(skill.level == 2 ? Skill.AxeSpe5Skill3_2 : Skill.AxeSpe5Skill3_1, {unit : valids[randInt(0, valids.length - 1)]}, skill);\n}\n\nfunction onBeginRound() {\n    vars.done = false;\n}",
