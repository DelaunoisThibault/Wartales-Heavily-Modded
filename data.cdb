						"fxSuffix": 3,
						"isAttack": true
					},
					"script": "function onBeginBattle(){
						vars.damageBonusValid = false;
					}
					function onEval(a) {
						for( st in a.target.getAllStatus() ) {
							if( st.isBonus ) {
								vars.damageBonusValid = true;
								break;
							}
						}
						if( vars.damageBonusValid ) {
							a.baseDamageBonus += vars.value1;
						}
					}
					function onEndTurn(){
						vars.damageBonusValid = false;
					}",
