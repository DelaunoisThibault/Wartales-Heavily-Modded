				{
					"id": "ProtectiveLeaders",
					"name": "Lieutenants protecteurs",
					"desc": "[DamageReducePercent] réduits de ::value1::% pour chaque leader allié en vie. Ne peut pas être engagé tant qu’un leader allié est en vie.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 25
						},
						"globalEvents": true
					},
					"script": "function onSkillEval(s) {\n    var n = 0;\n    for (t in s.getTargets())\n        if (t.target == skill.unit) {\n            for (u in getAllies(skill.unit))\n                if (u.hasStatus(Status.Leader))\n                    t.baseDamageBonus -= vars.value1;\n            return;\n        }\n}\n\nfunction onBeginAction() {\n    for (u in getAllies(skill.unit))\n        if (u.hasStatus(Status.Leader)){\n            if (!skill.unit.hasStatus(Status.PreventEngage))\n                skill.unit.addStatus(Status.PreventEngage);\n            return;\n        }\n    if (skill.unit.hasStatus(Status.PreventEngage))\n        skill.unit.cancelStatus(Status.PreventEngage);\n}",
