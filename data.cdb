				{
					"id": "SkillRepositioning",
					"name": "Se repositionner",
					"desc": "Réinitialise le mouvement.\nCette unité ne peut plus utiliser de compétences ou d’actions de base.",
					"mode": 4,
					"range": {},
					"props": {
