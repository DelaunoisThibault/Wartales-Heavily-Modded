						"extraFx": "prefabs/fx/fight/Attack/AttackPower_B.fx",
						"isAttack": true,
						"hitFx": "prefabs/fx/fight/Attack/Attack_B.fx",
						"flagsAI": 8
					},
					"script": "function onSkill() {\n\tif( waitNextTurn() ) {\n\t\tvars.value2 = 0;\n\t\tcreateZone();\n\t\treturn;\n\t}\n\tcancelZone();\n}\n\nfunction onMoveEvent(m) {\n\tskill.unit.castSkill(Skill.OpportunityAttack, {unit : m.unit}, skill);\n}\n\nfunction onBeforeHit(a) {\n\tif (a.unit == skill.unit && a.castOrigin != null && a.castOrigin.kind == Skill.Barrage) {\n\t\tvars.value2++;\n\t\tif( vars.value2 == vars.value1 ) {\n\t\t\tcancelZone();\n\t\t}\n\t}\n}\n\nfunction onMove(m) {\n\tif( m.unit.side == skill.unit.side ) return;\n\tvar z = getZone();\n\tif( z == null || z.getKind() != skill.kind ) return;\n\tm.addZoneEvent(z, onMoveEvent);\n}",
