							"newStance": false
						}
					},
					"script": "function onSkillPlayed(s) {\n\n\t\tif ((s.kind == Skill.AttackStance || s.kind == Skill.DefenseStance) && !vars.newStance) {\n\t\t\tvars.newStance = true;\n\t\t} else if (s.isStanceAttack() && vars.newStance) {\n\t\t\tskill.unit.addStatus(Status.AnimalMarkedBonus, vars.value1);\n\t\t\tvars.newStance = false;\n\t}\n}",
