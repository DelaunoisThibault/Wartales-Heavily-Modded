				{
					"id": "Blind",
					"name": "Cécité",
					"desc": "Se désengage.",
					"mode": 4,
					"range": {},
					"props": {
						"apCost": 0,
						"needDisengaged": false,
						"itemCost": {
							"item": "BlindingPowder",
