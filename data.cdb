					"script": "function onHit(s){\n\tif (s.unit != skill.unit) return;\n\ts.target.pushback({ unit : skill.unit }, vars.value1, s);\n}\n\nfunction onAfterPushback(s) {\n\tif (s.unit != skill.unit) return;\n\tvar d = s.pushbackData;\n\tif (d.touchObstacle || d.touchUnit || d.crossAoe)\n\t\tskill.unit.reloadMovePoints();\n}",
