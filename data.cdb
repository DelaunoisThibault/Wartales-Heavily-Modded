						"y": 7
					}
				},
				{
					"id": "BeastRoarBossFight",
					"name": "Hurlement de la Bête",
					"desc": "Applique [Terror] à tous les ennemis humains, [BeastInfluence] à tous les ennemis animaux et [Fury] à tous les alliés.\nAppelle des renforts. ::value1::",
					"mode": 4,
					"range": {},
					"props": {
						"vars": {
							"value1": 1,
							"maxRenforts": 20,
							"maxRenfortsRatio": 1.5,
							"minRenforts": 6,
							"renfortsRatioLow": 0.5,
							"renfortsRatioHigh": 0.5
						},
						"tooltipStatus": [
							{
								"st": "Terror"
							},
							{
								"st": "BeastInfluence"
							},
							{
								"st": "Fury"
							}
						],
						"specialAnim": "Roar",
						"isAttack": true,
						"extraFx": "prefabs/fx/Event/TheBeast/TheBeastRoar.fx"
					},
					"script": "var renfortPatternLow = [\n\tUnitClass.GhostBear,\n\tUnitClass.GhostBoar,\n\tUnitClass.GhostBoar,\n\tUnitClass.GhostBoar,\n\tUnitClass.GhostWolf,\n\tUnitClass.GhostWolf,\n\tUnitClass.GhostWolf\n];\n\nvar renfortPatternHigh = [\n\tUnitClass.GhostBear,\n\tUnitClass.GhostBoar,\n\tUnitClass.GhostBoar,\n\tUnitClass.GhostBoar,\n\tUnitClass.GhostWolf,\n\tUnitClass.GhostWolf,\n\tUnitClass.GhostWolf,\n\tUnitClass.Nightmare\n];\n\nfunction getMaxRenforts(): Int {\n\tvar unitDifference = max(getFoes(skill.unit).length - getAllies(skill.unit).length, getAllies(skill.unit).length - getFoes(skill.unit).length);\n\tvar maxUnits = getFoes(skill.unit).length * vars.maxRenfortsRatio;\n\n\tvar maxRenforts: Int = floor(maxUnits - unitDifference);\n\ttrace(\"Beast Renfort Debug\");\n\ttrace(\"-------------------\");\n\ttrace(\"Unit Difference: \" + unitDifference);\n\ttrace(\"Max Units:       \" + maxUnits);\n\ttrace(\"Max Renforts:    \" + maxRenforts);\n\treturn maxRenforts;\n}\n\nfunction renfortClamp(value, maxRenfort) {\n\treturn floor(clamp(value, vars.minRenforts, maxRenfort));\n}\n\nfunction onSkill() {\n\tplay(\"Roar\");\n\ttrace(\"Beast Roar\");\n\n\tfor (u in getUnits()) {\n\t\tu.addStatus(isFoe(u) ? Status.Fury : (u.isAnimal && !u.isWerewolf) ? Status.BeastInfluence : Status.Terror);\n\t}\n\n\tvar count = getPlayerUnits().filter( t -> !t.isObject).length;\n\tvar maxRenfort = getMaxRenforts();\n\tif (skill.level < 2) {\n\t\tcount = renfortClamp(count * vars.renfortsRatioLow, maxRenfort);\n\t\ttrace(\"Actual Renforts: \" + count);\n\t\tspawnRenfortBeastP2(renfortPatternLow, count);\n\t} else {\n\t\tcount = renfortClamp(count * vars.renfortsRatioHigh, maxRenfort);\n\t\ttrace(\"Actual Renforts: \" + count);\n\t\tspawnRenfortBeastP2(renfortPatternHigh, floor(count * vars.renfortsRatioHigh));\n\t}\n\ttrace(\"Actual Renforts: \" + count);\n\ttrace(\"End Beast Renfort Debug\");\n\ttrace(\"-----------------------\");\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
						"size": 96,
						"x": 4,
						"y": 7
					}
				},
