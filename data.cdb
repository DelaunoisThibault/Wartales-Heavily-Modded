					"name": "Volonté de propagation de la peste",
					"desc": "Chaque fois que cette unité tue un ennemi, réinitialise le [Movement]. Augmente également les dégâts infligés à la prochaine cible de ::value1::%.",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"vars": {
							"killedTarget": false,
							"value1": 75
						}
					},
					"script": "function onBeginBattle() {
						vars.killedTarget = false;
					}
					function onDeath(a) {
						if( a.unit == skill.unit ) {
							skill.unit.movePoints = skill.unit.getMaxMovePoints();
							vars.killedTarget = true;
						}
					}
					function onSkillEval(a) {
						if( vars.killedTarget == true ) {
							for( t in a.getTargets() ) {
								t.baseDamageBonus += vars.value1;
							}
						}
					}
					function onDamageDealt(a) {
						if(vars.killedTarget && a.unit == skill.unit && a.target.isAlive()){
							vars.killedTarget = false;
						}
					}",
