								"st": "AnimalMarkedBonus"
							}
						],
						"needDisengaged": true,
						"apCost": 0,
						"flagsAI": 2
					},
					"script": "function onEval(a) {\n\ta.dmg = a.forcedDmg = a.target.getPercentHealth(vars.damage);\n\ta.preventCriticalHit = true;\n\tif (a.dmg >= a.target.health){\n\t\tdontAllow();\n\t}\n}\n\nfunction onSkillEval(a){\n\tif(a.isOpportunityAttack() && a.castOrigin != null && a.castOrigin.kind == skill.kind && vars.triggered){\n\t\tfor(t in a.getTargets()){\n\t\t\tt.baseDamageBonus += t.target.isAnimal ? vars.value2 : vars.value1;\n\t\t}\n\t}\n}\n\nfunction onPostSkill(){\n\tvars.triggered = false;\n}\n\nfunction onSkill() {\n\tattack();\n\tfor( t in skill.getTargets() ) {\n\t\tt.target.addStatus(Status.AnimalMarkedBonus, vars.status);\n\t\tif (t.target.isEngaged()) {\n\t\t\tvars.triggered = true;\n\t\t\tt.target.opportunityAttack(t.target.engagedUnit, skill);\n\t\t}\n\t}\n}\n\nfunction getAITargetScore( a ) {\n\tif ( a.target.isEngaged() && a.target.engagedUnit.side != skill.unit.side) {\n\t\treturn a.target.engagedUnit.isAnimal ? 1000 : 500;\n\t}\n\treturn -500;\n}",
					"notes": "Prioritize already played units in AIDirector.hx::findBestSE()(l.1035) case AIScore_SkillSpecific",
