					"script": "var targetEngaged = false;\n\nfunction onEval(a){\n\tif (a.target.isEngaged()) {\n\t\ttargetEngaged = true;\n\t}\n}\n\nfunction onDamage(a){\n\tif (a.target.isEngaged() && a.target.engagedUnit != a.unit){\n\t\t\ta.target.disengage();\n\t\t\ta.unit.engage(a.target);\n\t}\n\tif (!targetEngaged) {\n\t\ta.unit.addStatus(Status.Fervor, vars.value1);\n\t}\n}",
