							"props": {},
							"desc": "[DamageBonusPercent] et  [CritHitPercent] augmentés de ::value1::% contre les unités ayant au moins un Malus.\nEn retour, elles infligent ::value1::% de [DamageBonusPercent] de moins à cette unité."
						}
					],
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "ArmorBreaker",
					"name": "Brise-armure",
					"desc": "[DamageBonusPercent] infligés à l'[Armor] augmentés de ::value1::%.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 35
						}
					},
					"script": "function onSkillEval(a) {\n\tfor( t in a.getTargets() ) {\n\t\tif( t.target.armor > 0 ) {\n\t\t\tt.baseDamageBonus += vars.value1;\n\t\t}\n\t}\n}\n\nfunction onDamageDealt(a) {\n\tif( skill.level == 2 && a.target.armor <= 0 && a.damagedArmor > 0 ) {\n\t\tvar brutality = skill.unit.addStatusPersist(Status.Brutality, skill);\n\t\tvar inspiration = skill.unit.addStatusPersist(Status.Inspiration, skill);\n\t\tif( brutality || inspiration )\n\t\t\tspawnFx();\n\t}\n}",
					"notes": "",
