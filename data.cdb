					"script": "function onEval(t) {\n    var p = skill.getPosition();\n    var q = t.target.getPosition();\n    if ( p.x == q.x && p.y == q.y) {\n        t.cancelAttack = true;\n        return;\n    }\n\tt.preventCriticalHit = true;\n\tvar origin = getOriginTarget();\n\tvar val = skill.getOriginLevel() == 2 ? vars.value2 : vars.value;\n    t.dmg = round(origin.dmgDealt * val / 100);\n    t.damageRange = round(origin.damageRange * val / 100);\n}\n\nfunction onZoneHit(){\n    if( skill.getOriginLevel() == 2 && isConsecutiveShot() )\n        createSkillZone(Skill.FireZone);\n}",
