					},
					"script": "function onSkillPlayed(s) {\n\tif((s.kind == Skill.CaptainSkill || s.kind == Skill.LieutenantSkill) && s.unit == skill.unit && isPlayer(s.unit)){\n\t\tfor(t in s.getTargets()){\n\t\t\tif(isPlayer(t.target)){\n\t\t\t\tt.target.addStatus(Status.Inspiration);\n\t\t\t}\n\t\t}\n\t}\n}",
					"notes": "",
