					"script": "function onBeginAction() {\n\tif( !skill.unit.isEngaged() ) {\n\t\tvars.engaged = false;\n\t}\n}\n\nfunction onSkillPlayed(s) {\n\tif( skill.unit.isEngaged() && !vars.engaged ) {\n\t\tvars.engaged = true;\n\t\tvar engagedUnit = skill.unit.engagedUnit;\n\t\tif (engagedUnit.isWerewolfForm) {\n\t\t\tskill.unit.addStatus(Status.Fury);\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 2,
					"icon": {
						"file": "ui/Icons/BattleIcons_04_96PX.png",
						"size": 96,
						"x": 16,
						"y": 11
					},
					"iconeDone": true
				},
				{
					"id": "E3SaveCivilianObjective",
					"name": "",
					"desc": "Sauvez les ::total:: civils.\n- Sauvés : ::saved::\n- Tués : ::killed::",
					"mode": 8,
					"range": {},
					"props": {
						"battleObjective": {
							"isSecondaryObjective": true
						},
						"vars": {
							"total": 3,
							"killed": 0,
							"saved": 0,
							"remain": 0
						},
						"globalEvents": true
					},
					"script": "function onGen() {\n\tvar p = getProbaE3Civil();\n\tif (p < 100) {\n\t\tif (!isFoeGroupType(GroupType.Rioters) && !isFoeGroupType(GroupType.Outlaws)) return false;\n\t\tif (!proba(p)) return false;\n\t}\n\tvars.total = min(ceil(0.3*getPlayerUnits().length), 15);\n\tspawnAdditionnal(UnitClass.E3Civil, vars.total, true);\n\tfor( u in getAllUnits() ) {\n\t\tif( getObjectSkill(u) == Skill.Door_E3Burning ) {\n\t\t\tvars.total += u.getSkillVar(Skill.Door_E3Burning, \"nbCivils\");\n\t\t}\n\t\tvars.remain = vars.total;\n\t}\n\treturn true;\n}\n\nfunction checkProgress() {\n\tif (vars.killed >= vars.total) {\n\t\tsetSuccessObjective(false);\n\t} else if (vars.saved >= vars.total) {\n\t\tsetSuccessObjective(true);\n\t}\n\tvars.remain = vars.total - (vars.saved + vars.killed);\n\tupdateObjectiveDesc();\n}\n\nfunction onDeath(a) {\n\tif (a.target.kind == UnitClass.E3Civil) {\n\t\tif (a.target.hasFleed()) {\n\t\t\tvars.saved++;\n\t\t\tcounter(Counter.E3CivilSaved, getCurrentUnit());\n\t\t\tcounter(Counter.TeamCivilSaved);\n\t\t} else {\n\t\t\tvars.killed++;\n\t\t}\n\t\tcheckProgress();\n\t} else if( getObjectSkill(a.target) == Skill.Door_E3Burning ) {\n\t\tvar tu : Int = a.target.getSkillVar(Skill.Door_E3Burning, \"nTurns\");\n\t\tif (tu <= 0) {\n\t\t\tvar civs = a.target.getSkillVar(Skill.Door_E3Burning, \"nbCivils\");\n\t\t\tvars.killed += civs;\n\t\t\tcheckProgress();\n\t\t}\n\t}\n}\n\nfunction onEndBattle() {\n\tfor( u in getAllUnits() ) {\n\t\tif( getObjectSkill(u) == Skill.Door_E3Burning) {\n\t\t\tvar tu : Int = u.getSkillVar(Skill.Door_E3Burning, \"nTurns\");\n\t\t\tif (tu > 0) {\n\t\t\t\tvars.killed += u.getSkillVar(Skill.Door_E3Burning, \"nbCivils\");\n\t\t\t}\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "E3PreventEscapeRioters",
					"name": "",
					"desc": "Empêchez les [Rioters] d'atteindre la zone de fuite.\n- Enfuis : ::fled::\n- Restants : ::remain::",
					"mode": 8,
					"range": {},
					"props": {
						"battleObjective": {
							"isSecondaryObjective": true
						},
						"vars": {
							"total": 0,
							"killed": 0,
							"fled": 0,
							"captured": 0,
							"remain": 0
						},
						"globalEvents": true
					},
					"script": "function checkProgress() {\n\tvar tot = 0;\n\tfor (u in getAllFoeUnits()) {\n\t\tif (checkUnit(u)) {\n\t\t\ttot++;\n\t\t}\n\t}\n\tvars.total = tot;\n\tif (vars.fled >= vars.total) {\n\t\tsetSuccessObjective(false);\n\t} else if (vars.killed  + vars.captured >= vars.total) {\n\t\tsetSuccessObjective(true);\n\t}\n\tvars.remain = vars.total - (vars.killed + vars.captured);\n\tupdateObjectiveDesc();\n}\n\nfunction onGen() {\n\tcheckProgress();\n\treturn true;\n}\n\nfunction onBeginRound() {\n\tcheckProgress();\n}\n\nfunction onDeath(a) {\n\tif (checkUnit(a.target)) {\n\t\tif (a.target.hasFleed()) {\n\t\t\tvars.fled++;\n\t\t} else if (a.target.isCaptured()) {\n\t\t\tvars.captured++;\n\t\t} else {\n\t\t\tvars.killed++;\n\t\t}\n\t\tcheckProgress();\n\t}\n}\n\nfunction checkUnit(u) {\n\treturn !u.isObject && isFoe(u) && !isNeutral(u);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "E3ProtectAllies",
					"name": "",
					"desc": "Protégez vos alliés.\n[E3Chaos] <bad>+::chaos::</bad> à chaque fois qu'un allié meurt",
					"mode": 8,
					"range": {},
					"props": {
						"battleObjective": {
							"isSecondaryObjective": true
						},
						"globalEvents": true,
						"vars": {
							"chaos": 15
						}
					},
					"script": "function onGen() {\n\tif (!isChaosValid()) return false;\n\treturn isAllyGroupType(GroupType.TheGuard) || isAllyGroupType(GroupType.Legion);\n}\n\nfunction onDeath(a) {\n\tif (isAlly(a.target) && a.target.kind != UnitClass.E3Civil) {\n\t\taddE3Chaos(vars.chaos);\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "E3WantedRioter",
					"name": "",
					"desc": "Capturez l'unité [E3Wanted] et livrez-la à la prison.",
					"mode": 8,
					"range": {},
					"props": {
						"globalEvents": true,
						"battleObjective": {
							"isSecondaryObjective": true
						}
					},
					"script": "function onGen() {\n\tif (!isChaosValid()) return false;\n\tif (!isFoeGroupType(GroupType.Rioters)) return false;\n\tif (getChaos() < getConstInt(Constant.E3_WantedObjChaos, 0)) return false;\n\tif (!proba(getConstInt(Constant.E3_WantedObjChaos, 1))) return false;\n\tvar fs = getFoeUnits().filter(u -> u.canBeCaptured());\n\tif (fs.length == 0) return false;\n\tpickRandom(fs).addStatus(Status.E3Wanted);\n\treturn true;\n}\n\nfunction onDeath(a) {\n\tif (a.target.hasStatus(Status.E3Wanted)) {\n\t\tsetSuccessObjective(a.target.isCaptured());\n\t\tupdateObjectiveDesc();\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "E3ProportionnalForces",
					"name": "",
					"desc": "Gardez ::percent_pFoes:: [Rioters] en vie.\n- Actuel : ::percent_alive::",
					"mode": 8,
					"range": {},
					"props": {
						"globalEvents": true,
						"battleObjective": {
							"isSecondaryObjective": true
						},
						"vars": {
							"pFoes": 10,
							"alive": 100,
							"nbKilled": 0
						}
					},
					"script": "function onGen() {\n\tif (!isFoeGroupType(GroupType.Rioters)) return false;\n\tif (getAllyGroupType() != null) return false;\n\tif (getChaos() >= getConstInt(Constant.E3_ProportionnalForcesObjChaos, 0)) return false;\n\tif (!proba(getConstInt(Constant.E3_ProportionnalForcesObjChaos, 1))) return false;\n\treturn true;\n}\n\nfunction onBeginRound() {\n\tcheckProgress();\n}\n\nfunction onDeath(a) {\n\tif (checkUnit(a.target)) {\n\t\tvars.nbKilled++;\n\t\tcheckProgress();\n\t}\n}\n\nfunction checkUnit(u) {\n\treturn !u.isObject && isFoe(u) && !isNeutral(u);\n}\n\nfunction checkProgress() {\n\tvar tot = 0;\n\tfor (u in getAllFoeUnits()) {\n\t\tif (checkUnit(u)) {\n\t\t\ttot++;\n\t\t}\n\t}\n\tvars.alive = round((tot - vars.nbKilled) / tot * 100);\n\tif (vars.alive < 10) {\n\t\tsetSuccessObjective(false);\n\t} else {\n\t\trestoreObjective();\n\t}\n\tupdateObjectiveDesc();\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
