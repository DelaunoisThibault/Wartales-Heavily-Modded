				{
					"id": "BraveVictory",
					"name": "Victoire valeureuse",
					"desc": "Chaque fois que cette unité tue un ennemi, obtenez <apt>::value1::</apt>.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 1
						},
						"globalEvents": true
					},
					"script": "function onDeath(a) {\n\tif(!a.target.isObject && a.target.side != skill.unit.side && a.unit == skill.unit ) {\n\t\tskill.unit.gainsActionPoint(vars.value1);\n\t\tspawnFx();\n\t}\n}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons96PX.png",
