						"globalEvents": true,
						"vars": {
							"nbRenfortPerPlayer": 0.3,
							"percentSmall": 1,
							"maxRenfort": 20
						}
					},
					"script": "function onBeginRound() {\n\tif(getRound() != 1) return;\n\tfor (u in getUnits()) {\n\t\tif (u.isElement(cast \"A2InnSouthPeasant\")) {\n\t\t\tlockCamera(true);\n\t\t\twait(0.5);\n\t\t\tsetCameraTarget(u);\n\t\t\twerewolfTransformation(u);\n\t\t\tlockCamera(false);\n\t\t\tvar n = getPlayerUnits().length * vars.nbRenfortPerPlayer;\n\t\t\tif (n > vars.maxRenfort)\n\t\t\t\tn = vars.maxRenfort;\n\t\t\tspawnRenfort(UnitClass.CivilSylve, ceil(n * (1 - vars.percentSmall)), false, true, Status.WerewolfGeneBeta);\n\t\t\tspawnRenfort(UnitClass.CivilSylve, ceil(n * vars.percentSmall), false, true, Status.WerewolfGeneGamma);\n\t\t\treturn;\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
