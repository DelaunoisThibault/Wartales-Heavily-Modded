					"range": {},
					"props": {
						"globalEvents": true,
						"tooltipStatus": [
							{
								"st": "Fragility"
							},
							{
								"st": "Protection"
							}
						]
					},
					"script": "function onBeginAction() {\n\tif( !skill.unit.isEngaged() ) {\n\t\tskill.unit.applyToSkillAdjacents(true, Skill.SenseOfSacrifice, 1,\n\t\t\tfunction (u : battle.Unit) {u.addStatusPersist(Status.Protection, skill);},\n\t\t\tfunction (u : battle.Unit) {u.cancelStatus(Status.Protection, skill);});\n\n\t\tif( isMeleeWithAlly(skill.unit) ) {\n\t\t\tskill.unit.addStatusPersist(Status.Fragility, skill);\n\t\t} else skill.unit.cancelStatus(Status.Fragility, skill);\n\t}\n}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
						"size": 96,
						"x": 12,
						"y": 6
