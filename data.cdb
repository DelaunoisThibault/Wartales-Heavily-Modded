					"script": "function onStatus(s) {
						if( s.kind == Status.Poison || s.kind == Status.Bleeding ) {
							spawnFx();
							s.cancel();
						}
					}
					function onDamageDealt(a) {
						a.target.addStatus(Status.Burning);
					}
					function onBeginBattle(){
						if( !skill.unit.hasStatus(Status.Burning) ){
							skill.unit.addStatus(Status.Burning);
						}
					}
					function onBeginRound(){
						if( !skill.unit.hasStatus(Status.Burning) ){
							skill.unit.addStatus(Status.Burning);
						}
					}
					function onBeginTurn(){
						if( !skill.unit.hasStatus(Status.Burning) ){
							skill.unit.addStatus(Status.Burning);
						}
					}
					function onBeginAction(){
						if( !skill.unit.hasStatus(Status.Burning) ){
							skill.unit.addStatus(Status.Burning);
						}
					}
					function onEndTurn(){
						if( !skill.unit.hasStatus(Status.Burning) ){
							skill.unit.addStatus(Status.Burning);
						}
					}",
