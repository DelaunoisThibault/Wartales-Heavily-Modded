						"isAttack": true,
						"specialAnim": "AttackWide"
					},
					"script": "function onHit(a){\n\ta.target.pushback({ unit : skill.unit }, getPushback(a), a);\n\tskill.unit.addStatus(Status.PitH1_5_Loaded);\n}\n\nfunction getPushback(a){\n\treturn vars.value1;\n}",
