					"script": "function onSkill() {
						for ( t in skill.getTargets() ) {
							if( t.target != null && !t.target.hasStatus(Status.NotCapturableUnit) && !t.target.hasStatus(Status.Skilled) &&  !t.target.hasStatus(Status.Leader) && !t.target.hasStatus(Status.Gladiator) && !t.target.hasStatus(Status.Champion) ) {
