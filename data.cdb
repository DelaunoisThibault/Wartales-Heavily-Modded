					"script": "function onCenserInhaled(c) {\n\tc.st.target.addStatus(Status.ProtectiveFog);\n}\n\nfunction onCenserPurgedHit(c) {\n\tif (c.st.target.side == skill.unit.side && c.st.target.isEngaged())\n\t\tc.st.target.addStatus(Status.Relentlessness);\n\telse if (c.inhalation >= vars.n && c.st.target.side != skill.unit.side)\n\t\tc.st.target.addStatus(Status.Weakening);\n}\n\nfunction onCenserEval(c) {\n\tif (c.st.target.side == skill.unit.side && !c.st.target.isEngaged())\n\t\tc.st.dontShowPreview();\n\telse if (c.st.target.side != skill.unit.side && c.inhalation < vars.n)\n\t\tc.st.dontShowPreview();\n}",
