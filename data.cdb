							"nTurn": 2,
							"meters": 3
						}
					},
					"script": "function canEngage(t) {\n\treturn skill.unit.getStatusCount(Status.Inhalation) < vars.n;\n}\n\nfunction onEndTurn() {\n\tif (skill.level <= 1) {\n\t\treturn;\n\t}\n\n\tvar as = [];\n\tfor (a in getFoes(skill.unit)) {\n\t\tif (skill.level <= 1 && a.isMelee(skill.unit)) {\n\t\t\tas.push(a);\n\t\t} else if (skill.level >= 2 && getDistance(a, skill.unit) <= vars.meters) {\n\t\t\tas.push(a);\n\t\t}\n\t}\n\tif (as.length > 0)\n\t\tfor (a in as) {\n\t\t\ta.addStatus(Status.IrritantSmoke, vars.nTurn, true);\n\t\t}\n}\n\nfunction onDamageTaken(a) {\n\tif (skill.level == 2 && skill.unit.getStatusCount(Status.Inhalation) >= vars.n && a.unit.isMelee(skill.unit)) {\n\t\ta.unit.addStatus(Status.IrritantSmoke, vars.nTurn, true);\n\t}\n}",
