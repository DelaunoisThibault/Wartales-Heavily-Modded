				{
					"id": "PitH1_2_Determined_Order",
					"name": "Destinée",
					"desc": "L'ordre des tours alliés sont prédéterminés alors que ceux des ennemis sont cachés. Tous les alliés ont accès à la compétence <skill>SwapTurn</skill>.",
					"mode": 2,
