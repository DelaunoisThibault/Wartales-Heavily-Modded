					"id": "DeadlyContract",
					"name": "Contrat mortel",
					"desc": "Au début du combat, applique [Fragility] à l'ennemi le plus proche.\nLe malus est transféré à l'ennemi le plus proche à sa mort.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 1
						},
						"globalEvents": true,
						"tooltipStatus": [
							{
								"st": "Fragility"
							}
						]
					},
					"script": "function onBeginRound() {\n\tif (getRound() > 1) return;\n\tvar arr = [];\n\tfor (t in getFoes(skill.unit))\n\t\tarr.push({ dist : getDistance(skill.unit, t), target : t });\n\tarr.sort((u1, u2) -> u1.dist < u2.dist ? -1 : u1.dist > u2.dist ? 1 : 0);\n\tvar b = false;\n\tif (arr.length > 0) {\n\t\tb = true;\n\t\tarr[0].target.addStatusPersist(Status.Fragility, skill);\n\t}\n\tif (skill.level == 2 && arr.length > 1) {\n\t\tb = true;\n\t\tarr[1].target.addStatusPersist(Status.Fragility, skill);\n\t}\n\tif (b)\n\t\tspawnFx();\n}\n\nfunction onDeath(a) {\n\tif (a.target.hasStatusPersist(Status.Fragility, skill)) {\n\t\tvar arr = [];\n\t\tfor (t in getAllies(a.target))\n\t\t\tif (!t.hasStatusPersist(Status.Fragility, skill))\n\t\t\t\tarr.push({ dist : getDistance(a.target, t), target : t });\n\t\tarr.sort((u1, u2) -> u1.dist < u2.dist ? -1 : u1.dist > u2.dist ? 1 : 0);\n\t\tif (arr.length > 0) {\n\t\t\tspawnFx();\n\t\t\tarr[0].target.addStatusPersist(Status.Fragility, skill);\n\t\t}\n\t}\n}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons96PX.png",
						"size": 96,
						"x": 16,
						"y": 5
					},
					"levels": [
						{
							"props": {},
							"desc": "Au début du combat, applique [Fragility] aux deux ennemis les plus proches.\nLe malus est transféré à l'ennemi le plus proche à sa mort."
						}
					],
					"iconeDone": true,
					"done": 2
				},
