				{
					"id": "AncientBearSpiritualConnection",
					"name": "Connexion Spiritualle ancestrale",
					"desc": "Cette unité est soignée de ::value1::% par unité animale alliée vivante sur le terrain à la fin de son tour. L'effet est doublé si l'unité a le statut [Berserk]. Bonus actuel : ::healStackBonus::%. \nApplique le status [SpiritualAnimalReinforcement] à tous les animaux alliés.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 1,
							"value2": 1,
							"healAnimalsValue": 10,
							"berserk": false,
							"healStackBonus": 0
						},
						"tooltipStatus": [
							{
								"st": "Berserk"
							},
							{
								"st": "SpiritualAnimalReinforcement"
							}
						]
					},
					"script": "function onBeginBattle() {
						var nb = 0;
						for( u in getAllies(skill.unit) ) {
							if( u.isAnimal ) {
								nb++;
							}
						}
						vars.healStackBonus = vars.value1 * (nb * vars.value2);
						vars.berserk = false;
					}
					function onBeginRound() {
						for( u in getAllies(skill.unit) ) {
							if( u.isAnimal ) {
								if( !u.hasStatus(Status.SpiritualAnimalReinforcement) ) {
									u.addStatusPersist(Status.SpiritualAnimalReinforcement, skill);
								}
							}
						}
					}
					function onStatus(s) {
						if (s.unit != skill.unit) return;
						if (s.kind != Status.Berserk ) return;
						if( !vars.berserk ) {
							vars.value2 = 2;
							vars.berserk = true;
						}
					}
					function onEndTurn() {
						var nb = 0;
						for( u in getAllies(skill.unit) ) {
							if( u.isAnimal ) {
								nb++;
								if( skill.level == 2 ) {
									u.heal(skill, ceil(u.stats.health*vars.healAnimalsValue/100));
									spawnFx();
								}
							}
						}
						vars.healStackBonus = vars.value1 * (nb * vars.value2);
						skill.unit.heal(skill, ceil(skill.unit.stats.health*vars.healStackBonus/100));
					}
					function onDeath(a) {
						if( a.target == skill.unit ) {
							for( u in getAllies(skill.unit) ) {
								u.cancelStatus(Status.SpiritualAnimalReinforcement);
							}
						}
					}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
						"size": 96,
						"x": 7,
						"y": 13
					},
					"levels": [
						{
							"props": {},
							"desc": "Cette unité est soignée de ::value1::% par unité animale alliée vivante sur le terrain à la fin de son tour. L'effet est doublé si l'unité a le statut [Berserk]. Bonus actuel : ::healStackBonus::%. \nApplique le status [SpiritualAnimalReinforcement] à tous les animaux alliés et les soigne de ::healAnimalsValue::% à la fin de son tour."
						}
					],
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "ResurrectionOfTheOldOne",
					"name": "Résurrection de l'ancien",
					"desc": "Quand cette unité doit subir un coup mortel, les dégâts sont réduits à 0. \nSi elle subit le statut [Dying], elle se soigne entièrement. \n\nLa première fois qu'elle doit subir un coup mortel, gagne [Berserk].",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 110,
							"value2": 20,
							"berserkStatus": false
						},
						"tooltipStatus": [
							{
								"st": "Berserk"
							}
						],
						"usableWhenLocked": true
					},
					"script": "function onBeforeHit(a) {
						if( isPlayer(skill.unit) ){
							var p = skill.unit.health;
							if (a.target == skill.unit && a.dmg >= p) {
								var d = ceil(a.dmg * vars.value1 / 100);
								a.dmg -= d;
								if( !skill.unit.hasStatus(Status.Berserk) ){
									skill.unit.addStatus(Status.Berserk);
									if( skill.level == 2 ){
										skill.unit.heal(skill,  ceil(skill.unit.stats.health) );
									}
								}
							}
						}
					}
					function onStatus(s) {
						if( isPlayer(skill.unit) ){
							if (s.unit == skill.unit){
								if (s.kind == Status.Dying){
									skill.unit.heal(skill,  ceil(skill.unit.stats.health) );
								}
							}
						}
					}",
					"notes": "",
					"iconeDone": true,
					"levels": [
						{
							"props": {},
							"desc": "Quand cette unité doit subir un coup mortel, les dégâts sont réduits à 0. \nSi elle subit le statut [Dying], elle se soigne entièrement. \n\nLa première fois qu'elle doit subir un coup mortel, gagne [Berserk] et se soigne entièrement."
						}
					],
