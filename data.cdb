				{
					"id": "UnpredictableBehaviourBattle",
					"name": "Comportement imprévisible",
					"desc": "Nul ne saurait prédire ce qui pourrait arriver.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"killProba": 5,
							"neutralProba": 3,
							"adjBonusProba": 20,
							"adjMalusProba": 5,
							"reset": false
						}
					},
					"script": "function onDamageTaken(s) {\n    if (s.target == skill.unit && skill.unit.isMelee(s.unit) && (skill.unit.engagedUnit == null || skill.unit.engagedUnit == s.unit) && !s.unit.hasStatus(Status.Champion) ) {\n        if (proba(vars.killProba))\n            skill.unit.castSkill(Skill.OpportunityKill, {unit : s.unit}, skill);\n    }\n}\n\nfunction onBeginRound(){\n    if (proba(vars.neutralProba)) {\n        if (skill.unit.engagedUnit != null) skill.unit.disengage();\n        skill.unit.setNeutral();\n\t\tskill.unit.addStatus(Status.UnpredictableStatus);\n        vars.reset = true;\n    }\n}\n\nfunction onEndRound() {\n    if (vars.reset) {\n        skill.unit.resetSide();\n\t\tskill.unit.consumeStatus(Status.UnpredictableStatus);\n        vars.reset = false;\n    }\n}\n\nfunction onEndTurn() {\n    var targets = getAllies(skill.unit).filter(u -> u.isMelee(skill.unit));\n    for (t in targets) {\n        var rnd = random(0, 100);\n        if (rnd < vars.adjBonusProba)\n            t.addStatus(Status.CatLove);\n        else if(rnd < vars.adjBonusProba + vars.adjMalusProba)\n            t.addStatus(Status.Scratched);\n    }\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"icon": {
