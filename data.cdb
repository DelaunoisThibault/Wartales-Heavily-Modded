							}
						],
						"globalEvents": true
					},
					"script": "function onBeginAction() {\n\tcheckCond();\n}\n\nfunction onSkillPlayed(s) {\n\tcheckCond();\n}\n\nfunction checkCond() {\n\tif (skill.unit.armor == 0) {\n\t\twerewolfTransformation(skill.unit);\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "BeltAccBurnStop",
					"name": "Brûlure du pénitent",
					"desc": "Les dégâts de [Burning] sont augmentés de ::value::%. L'unité perd ensuite ses applications de [Burning].",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value": 300
						}
					},
					"script": "function onDotEval(d) {\n\tif (d.kind == Status.Burning){\n\t\td.dmg = d.dmg * (1 + (vars.value/100));\n\t\tskill.unit.consumeAllStatus(Status.Burning);\n\t}\n}",
