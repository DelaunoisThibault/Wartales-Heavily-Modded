					"script": "function onBeginAction() {
						if ( !vars.played ) {
							skill.unit.addStatusPersist(Status.Pyrophobia, skill);
							skill.unit.addStatusPersist(Status.PoisonHeal, skill);
							vars.played = true;
						}
