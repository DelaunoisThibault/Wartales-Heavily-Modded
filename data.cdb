					"text": "Patience",
					"desc": "Se déclenche si la cible a déjà joué ce round."
				},
				{
					"id": "Initiative",
					"iconeDone": true,
					"text": "Initiative",
					"desc": "Se déclenche si la cible n'a pas encore joué ce round."
				},
				{
					"id": "ConsecutiveShot",
					"iconeDone": true,
					"text": "Tir Consécutif",
					"desc": "Se déclenche si une compétence de précision a déjà été effectuée par cette unité à ce round."
				},
				{
					"id": "InhalationTrigger",
					"text": "Inhalation",
					"iconeDone": true,
					"desc": "Se déclenche quand l'unité utilise la compétence <skill>Inhalation</skill>."
				},
				{
					"id": "PurgeTrigger",
					"text": "Purge",
					"desc": "Se déclenche quand l'unité utilise la compétence <skill>Purge</skill>.",
					"iconeDone": true
				},
				{
					"id": "Inhalation1",
					"text": "1 Inhalation",
					"iconeDone": true,
					"desc": "Se déclenche si l'unité a 1 [Inhalation] ou plus."
				},
				{
					"id": "Inhalation2",
					"text": "2 Inhalations",
					"iconeDone": true,
					"desc": "Se déclenche si l'unité a 2 [Inhalation] ou plus."
				},
				{
					"id": "Inhalation3",
					"text": "3 Inhalations",
					"iconeDone": true,
					"desc": "Se déclenche si l'unité a 3 [Inhalation] ou plus."
				}
			],
