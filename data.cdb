						"vars": {
							"boostVar": 0,
							"value1": 10,
							"value2": 15
						},
						"globalEvents": true
					},
					"script": "function onSkillEval(a) {
						var p = 100 * (skill.unit.health / skill.unit.stats.health);
						var percentLife = round(skill.unit.stats.health / skill.unit.health);
						for( t in a.getTargets() ) {
							if( p == 100 ){
								vars.boostVar = percentLife;
							} else if(p < 100 && p >= 50) {
								vars.boostVar = percentLife * vars.value1;
							} else {
								vars.boostVar = percentLife * vars.value2;
							}
							if (t.target == skill.unit) {
								if(vars.boostVar < 90){
									t.baseDamageBonus -= vars.boostVar;
								} else {
									t.baseDamageBonus -= 90;
								}
							}
							if (a.unit == skill.unit) {
								t.baseDamageBonus += vars.boostVar;
							}
						}
						
					}",
