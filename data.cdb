				{
					"id": "PitG1_2_KingOfTheHillZone",
					"name": "Capture de zone",
					"desc": "Les unités de l'équipe la plus nombreuse dans la zone centrale ont [Brutality] et [Protection].",
					"mode": 5,
					"range": {
						"allowedTargets": 4
					},
					"props": {
						"tooltipStatus": [
							{
								"st": "Protection"
							},
							{
								"st": "Brutality"
							}
						]
					},
					"script": "function onZoneIn(t) {\n\tt.target.addStatusPersist(Status.PitG1_InsideHill, skill);\n\tcheckBonuses();\n}\n\nfunction onZoneOut(t) {\n\tt.target.cancelStatus(Status.PitG1_InsideHill, skill);\n\tcheckBonuses();\n}\n\nfunction checkBonuses() {\n\tvar pc = 0;\n\tvar fc = 0;\n\tvar us = getUnits();\n\tfor (u in us)\n\t\tif (u.hasStatus(Status.PitG1_InsideHill))\n\t\t\tisPlayer(u) ? pc++ : fc++;\n\tif (pc != fc) {\n\t\tvar forP = pc > fc;\n\t\tfor (u in us)\n\t\t\tif (u.hasStatus(Status.PitG1_InsideHill) && isPlayer(u) == forP) {\n\t\t\t\tu.addStatusPersist(Status.Protection, skill);\n\t\t\t\tu.addStatusPersist(Status.Brutality, skill);\n\t\t\t} else {\n\t\t\t\tu.cancelStatus(Status.Protection, skill);\n\t\t\t\tu.cancelStatus(Status.Brutality, skill);\n\t\t\t}\n\t} else\n\t\tfor (u in us)\n\t\t\tif (!u.hasStatus(Status.PitG1_InsideHill)) {\n\t\t\t\tu.cancelStatus(Status.Protection, skill);\n\t\t\t\tu.cancelStatus(Status.Brutality, skill);\n\t\t\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_03_96PX.png",
						"size": 96,
						"x": 11,
						"y": 16
					}
				},
