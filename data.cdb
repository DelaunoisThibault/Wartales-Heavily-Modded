				{
					"id": "EffortAura",
					"name": "Aura de dernier effort",
					"desc": "A la fin du tour de cette unité, celle-ci et les alliés proches gagnent autant de [Fervor] qu'ils ont de Malus.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 4
						},
						"tooltipStatus": [
							{
								"st": "Fervor"
							}
						]
					},
					"script": "function onEndTurn() {
						var nb = 0;
						for( u in getAllies(skill.unit) ) {
							if( getDistance(skill.unit, u) <= vars.value1 ) {
								for( st in u.getAllStatus() ) {
									if( st.isMalus ) {
										nb++;
									}
								}
								u.addStatus(Status.Fervor, nb+vars.value1);
								nb = 0;
							}
						}
						for ( st in skill.unit.getAllStatus() ) {
							if( st.isMalus ) {
								nb++;
							}
						}
						skill.unit.addStatus(Status.Fervor, nb+vars.value1);
					}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
