					"script": "function onEndTurn() {\n\tfor (u in getMeleeUnits(skill.unit)) {\n\t\tif (u != skill.unit && u.side == skill.unit.side) {\n\t\t\tskill.unit.addStatus(Status.Loaded);\n\t\t\tbreak;\n\t\t}\n\t}\n}\n\nfunction onDamageDealt(a) {\n\tif(!vars.todo) {\n\t\tfor (u in getMeleeUnits(a.target)) {\n\t\t\tif (u != skill.unit && u.side == skill.unit.side) {\n\t\t\t\tvars.todo = true;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunction onSkillPlayed(s) {\n    if (!vars.done && vars.todo) {\n\t\tskill.unit.addStatus(Status.Fury);\n\t\tskill.unit.reloadCrossbow(skill);\n\t\tvars.done = true;\n    }\n}\n\nfunction onEndRound() {\n\tvars.done = false;\n\tvars.todo = false;\n}",
