				},
				{
					"id": "DissentingRegeneration",
					"name": "Régénération contestataire",
					"desc": "Tant que cette unité a un malus et moins de ::value2::% de sa santé maximale, elle récupère ::value1::% de sa [Health] maximum à la fin de chaque tour.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 20,
							"value2": 50
						},
						"descPassiveGroup": "[GROUPTYPE] : Tant qu'une unité a un malus et moins de ::value2::% de sa santé maximale, elle récupère ::value1::% de sa [Health] maximum à la fin de chaque tour."
					},
					"script": "function onEndTurn() {
						var hasMalus = false;
						for(m in skill.unit.getAllStatus()){
							if(m.isMalus){
								hasMalus = true;
								break;
							}
						}
						var p = 100 * (skill.unit.health / skill.unit.stats.health);
						if (hasMalus && p < vars.value2) {
							skill.unit.heal(skill, ceil(skill.unit.stats.health*vars.value1/100) , null);
						}
					}",
					"notes": "",
