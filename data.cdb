					function onDamageDealt(a) {
						var diceroll = random(0, 100);
						if( diceroll <= vars.value1 && a.target.side != skill.unit.side ) {
							a.target.addStatus(Status.AcceleratedNecrosis, vars.value2);
						}
					}
					function onStatus(s) {
						if( s.unit == skill.unit && s.kind == Status.Plagued_Injured ){
							s.cancel();
						}
