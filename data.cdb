				}
			],
			"lines": [
				{
					"id": "TutoPlaceHolder",
					"title": "This is a placeholder",
					"props": {},
					"texts": [
						{
							"desc": "First part of the description"
						},
						{
							"desc": "Second part of the description",
							"img": "ui/tuto/placeholder.jpg"
						}
					],
					"__ignoreLoc__": true
				},
				{
					"id": "TutoForge",
					"title": "Apprenez à Forger !",
					"props": {},
					"texts": [
						{
							"desc": "Les plaques de métal chauffent : appuyez sur [LMB] quand une plaque devient rouge pour forger votre objet.",
							"img": "ui/tuto/forge1.jpg"
						},
						{
							"desc": "En appuyant sur [LMB] quand la plaque de métal émet des étincelles, vous créerez un objet de qualité supérieure !",
							"img": "ui/tuto/forge2.jpg"
						},
						{
							"desc": "Si toutes les plaques ont été frappées au bon moment, vous aurez une chance de créer un objet de qualité exceptionnelle !",
							"img": "ui/tuto/forge3.jpg"
						}
					]
				},
				{
					"id": "TutoLockpick",
					"title": "Apprenez à Crocheter !",
					"props": {},
					"texts": [
						{
							"desc": "Tournez le crochet puis appuyez sur [LMB] pour l'enfoncer dans la serrure.",
							"img": "ui/tuto/lockpick1.jpg"
						},
						{
							"desc": "Plus le crochet est proche de l'ouverture, plus il se relève. À l'inverse, s'il tressaute, il risque de se briser rapidement.",
							"img": "ui/tuto/lockpick2.jpg"
						}
					]
				},
				{
					"id": "TutoFishing",
					"title": "Apprenez à Pêcher !",
					"props": {},
					"texts": [
						{
							"desc": "Utilisez un de vos hameçons pour lancer votre ligne dans l'eau avec [LMB].",
							"img": "ui/tuto/fishing1.jpg"
						},
						{
							"desc": "Une fois la prise ferrée, laissez appuyé [LMB] de façon à maintenir la tension du fil dans la zone centrale. Empêchez le poisson de s'échapper !",
							"img": "ui/tuto/fishing2.jpg"
						}
					]
				},
				{
					"id": "TutoMining",
					"title": "Apprenez à Miner !",
					"props": {},
					"texts": [
						{
							"desc": "Placez votre curseur au niveau du cercle de minage.",
							"img": "ui/tuto/mining1.jpg"
						},
						{
							"desc": "Appuyez sur [LMB] quand le cercle vert se superpose au cercle gris pour récupérer plus de minerais !",
							"img": "ui/tuto/mining2.jpg"
						}
					]
				},
				{
					"id": "TutoRetreat",
					"title": "Combat et retraite",
					"props": {},
					"texts": [
						{
							"desc": "Si un combat vous paraît trop difficile, vous pouvez battre en retraite grâce au bouton Retraite. Vos compagnons subiront des dégâts mais survivront !",
							"img": "ui/tuto/retreat.jpg"
						}
					]
				},
				{
					"id": "TutoTerror",
					"title": "Terreur !",
					"props": {},
					"texts": [
						{
							"desc": "Quand une unité s’enfuit à cause de la Terreur, elle disparaît du combat mais ne quitte pas votre troupe pour autant. Vous la retrouverez après le combat.",
							"img": "ui/tuto/terror.jpg"
						}
					]
				},
				{
					"id": "TutoFall",
					"title": "Un Compagnon à la mer !",
					"props": {},
					"texts": [
						{
							"desc": "Quand une unité tombe à l'eau, elle disparaît du combat mais ne quitte pas votre troupe pour autant. Vous la retrouverez après le combat.",
							"img": "ui/tuto/fall.jpg"
						}
					]
				},
				{
					"id": "TutoRats",
					"title": "Invasion de rats !",
					"props": {},
					"texts": [
						{
							"desc": "Tuez la Matriarche pour mettre fin au combat.",
							"img": "ui/tuto/rats1.jpg"
						},
						{
							"desc": "À chaque fin de Round, la Matriarche va appeler de nombreux rats en renforts.",
							"img": "ui/tuto/rats2.jpg"
						},
						{
							"desc": "Tentez de détruire le plus d’Excroissances pestiférées possible avant de tuer la Matriarche pour obtenir plus de récompenses !",
							"img": "ui/tuto/rats3.jpg"
						}
					]
				},
				{
					"id": "TutoElite",
					"title": "Élite !",
					"props": {},
					"texts": [
						{
							"desc": "Les Élites sont des ennemis uniques qui jouent plusieurs fois dans le Round. Observez l’ordre du tour avec attention pour établir votre stratégie.",
							"img": "ui/tuto/elite.jpg"
						}
					]
				},
				{
					"id": "TutoImportantUnit",
					"title": "Personnage important !",
					"props": {},
					"texts": [
						{
							"desc": "Certains personnages sont importants. S'ils meurent, le combat prendra fin. Les personnages alliés importants doivent être protégés, et les ennemis importants capturés.",
							"img": "ui/tuto/accompany.jpg"
						}
					]
				},
				{
					"id": "TutoHideout",
					"title": "Repaire !",
					"props": {},
					"texts": [
						{
							"desc": "Un Repaire est un lieu infesté d’ennemis. Plus il a de crânes actifs, plus il est dangereux.",
							"img": "ui/tuto/hideout1.jpg"
						},
						{
							"desc": "Pour réduire le nombre d’ennemis du Repaire, cherchez des groupes avec un crâne dans la région. Les éliminer facilitera votre attaque finale.",
							"img": "ui/tuto/hideout2.jpg"
						}
					]
				},
				{
					"id": "TutoTired",
					"title": "Fatigue !",
					"props": {},
					"texts": [
						{
							"desc": "Votre groupe fatigue. Si vous continuez à marcher, vos compagnons risquent de mourir d’épuisement ! Vous devriez vous reposer.",
							"img": "ui/tuto/tired.jpg"
						}
					]
				},
				{
					"id": "TutoRest",
					"title": "Se reposer !",
					"props": {},
					"texts": [
						{
							"desc": "Dans votre camp, vous pourrez lancer un Repos à l’aide du Feu de camp. Nourrissez et payez votre troupe pour éviter tout mécontentement !",
							"img": "ui/tuto/rest1.jpg"
						},
						{
							"desc": "Se reposer permet de régénérer entièrement votre jauge de Fatigue, restaure des Points de Bravoure et fait avancer le temps.",
							"img": "ui/tuto/rest2.jpg"
						}
					]
				},
				{
					"id": "TutoCombatFirst",
					"title": "Combat !",
					"props": {},
					"texts": [
						{
							"desc": "À votre tour, vous pouvez jouer n’importe quelle unité que vous n’avez pas encore jouée pendant le round.",
							"img": "ui/tuto/combatfirst1.jpg"
						},
						{
							"desc": "Vous pouvez savoir quel ennemi va jouer ensuite. Établissez une stratégie !",
							"img": "ui/tuto/combatfirst2.jpg"
						}
					]
				},
				{
					"id": "TutoEngagement",
					"title": "Engagement !",
					"props": {},
					"texts": [
						{
							"desc": "Quand vous attaquez un ennemi libre au corps-à-corps, vous l’engagez.",
							"img": "ui/tuto/engagement1.jpg"
						},
						{
							"desc": "Une unité engagée peut attaquer seulement son adversaire engagé et a plus de chances de subir des coups critiques. Profitez de cet avantage avec vos autres unités !",
							"img": "ui/tuto/engagement2.jpg"
						},
						{
							"desc": "Une unité engagée expose son dos. Vous pouvez l’attaquer dans son dos pour obtenir un bonus pendant votre attaque.",
							"img": "ui/tuto/engagement3.jpg"
						}
					]
				},
				{
					"id": "TutoEncircling",
					"title": "Encerclement !",
					"props": {},
					"texts": [
						{
							"desc": "Quand vous encerclez avec deux alliés une unité ennemie déjà engagée, vous obtenez un bonus !",
							"img": "ui/tuto/encircling.jpg"
						}
					]
				},
				{
					"id": "TutoSupport",
					"title": "Support !",
					"props": {},
					"texts": [
						{
							"desc": "Quand vous encerclez avec deux alliés une unité alliée déjà engagée, vous obtenez un bonus !",
							"img": "ui/tuto/support.jpg"
						}
					]
				},
				{
					"id": "TutoDying",
					"title": "Unité mourante !",
					"props": {},
					"texts": [
						{
							"desc": "Une unité mourante est seulement capable de se déplacer. Si vous la soignez avant qu’elle ne subisse des dégâts, elle pourra combattre de nouveau. Dans le cas contraire, elle trépassera définitivement.",
							"img": "ui/tuto/dying.jpg"
						}
					]
				},
				{
					"id": "TutoBonusPoints",
					"title": "Points de bravoure temporaires !",
					"props": {},
					"texts": [
						{
							"desc": "Certaines actions vous permettent d'obtenir des [ActionPointBonus]. Ils sont à utiliser avant la fin du combat et ne seront pas conservés après celui-ci.",
							"img": "ui/tuto/bonuspoints.jpg"
						}
					]
				},
				{
					"id": "TutoRuin",
					"title": "Lumière !",
					"props": {},
					"texts": [
						{
							"desc": "Dans un Tombeau, vous aurez besoin de Lumière conférée par des torches pour explorer.",
							"img": "ui/tuto/ruin1.jpg"
						},
						{
							"desc": "Si votre Lumière s'éteint totalement, votre troupe paniquera et ressortira du Tombeau.",
							"img": "ui/tuto/ruin2.jpg"
						}
					]
				},
				{
					"id": "TutoCapture",
					"title": "Capture !",
					"props": {},
					"texts": [
						{
							"desc": "Quand il reste moins de la moitié de sa Santé à un ennemi, vous pouvez utiliser des Chaînes ou de la Corde pour le capturer !",
							"img": "ui/tuto/capture1.jpg"
						},
						{
							"desc": "Placez une de vos unités à côté d'un ennemi engagé pour tenter de le capturer.",
							"img": "ui/tuto/capture2.jpg"
						},
						{
							"desc": "Vous pouvez acheter des Chaînes ou de la Corde dans les prisons.",
							"img": "ui/tuto/capture3.jpg"
						}
					]
				},
				{
					"id": "TutoPassiveFaction",
					"title": "Passifs de faction",
					"props": {},
					"texts": [
						{
							"desc": "À ce niveau, les ennemis développent des stratégies de combat plus poussées et spécialisées !"
						}
					]
				},
				{
					"id": "TutoFlee",
					"title": "Mode Fuite !",
					"props": {},
					"texts": [
						{
							"desc": "En mode Fuite, vous devez atteindre la zone de fuite puis fuir avec chacun de vos personnages mais la Retraite est impossible !",
							"img": "ui/tuto/modereach1.jpg"
						},
						{
							"desc": "Une fois dans la zone, utilisez la compétence Fuir.",
							"img": "ui/tuto/modereach2.jpg"
						}
					]
				},
				{
					"id": "TutoForsakenWorld",
					"title": "Village abandonné (exploration)",
					"props": {},
					"texts": [
						{
							"desc": "Constituez une troupe de reconnaissance pour explorer un village en faisant le moins de bruit possible pour ne pas attirer les pestiférés.",
							"img": "ui/tuto/forsakenworld.jpg"
						}
					]
				},
				{
					"id": "TutoForsakenFight",
					"title": "Village abandonné (combat)",
					"props": {},
					"texts": [
						{
							"desc": "Bloquez les entrées pour éviter que les pestiférés n'entrent dans le bâtiment et ne vous submergent !",
							"img": "ui/tuto/forsakenfight1.jpg"
						},
						{
							"desc": "Utilisez la compétence Trouver une issue pour charger la jauge et fuir le bâtiment !",
							"img": "ui/tuto/forsakenfight2.jpg"
						}
					]
				},
				{
					"id": "TutoLute",
					"title": "Apprenez à jouer du luth !",
					"props": {},
					"texts": [
						{
							"desc": "Appuyez sur [LMB] au bon moment sur les notes de chaque corde pour jouer correctement la partition."
						},
						{
							"desc": "Votre récompense dépendra de la qualité de votre représentation !"
						}
					]
				},
				{
					"id": "TutoWoodCut",
					"title": "Apprenez à couper du bois !",
					"props": {},
					"texts": [
						{
							"desc": "Placez votre curseur au niveau du cercle de bûcheronnage.",
							"img": "ui/tuto/woodcut1.jpg"
						},
						{
							"desc": "Appuyez sur [LMB] quand le cercle vert se superpose au cercle gris pour récupérer plus de bois !",
							"img": "ui/tuto/woodcut2.jpg"
						}
					]
				},
				{
					"id": "TutoSteal",
					"title": "Vol !",
					"props": {},
					"texts": [
						{
							"desc": "Vous pouvez voler des objets avec [RMB].\nChaque vol augmente le soupçon de la Garde à votre encontre."
						}
					]
				},
				{
					"id": "TutoStormkapp",
					"props": {},
					"title": ""
				},
				{
					"id": "TutoSport",
					"title": "Jouer à la Rouste",
					"props": {},
					"texts": [
						{
							"desc": "Emparez-vous du ballon et portez-le jusqu'à la zone d'embut adverse pour marquer un point.\nLa partie compte 8 Rounds. Toutes les unités au sol se relèvent au début de chaque nouveau round.\nToute unité déjà jouée qui reçoit le ballon peut rejouer.",
							"img": "ui/tuto/sport1.jpg"
						}
					]
				},
				{
					"id": "TutoCaptainDuel",
					"title": "Duel de Capitaine !",
					"props": {},
					"texts": [
						{
							"desc": "Les paroles du capitaine adverse annoncent sa prochaine action. Interprétez ses mots correctement et trouvez la riposte appropriée :\n\n- Si vous Attaquez alors qu'il Insulte, vous le touchez.\n- Si vous Parez alors qu'il Attaque, vous évitez le coup.\n- Si vous Insultez alors qu'il Pare, vous prenez l’Avantage.",
							"img": "ui/tuto/duel1.jpg"
						},
						{
							"desc": "L’Avantage permet de toucher l'ennemi :\n\n- Si vous Attaquez en même temps que lui.\n- Si vous réussissez une Parade.\n\nIl est impossible d'utiliser la même action deux fois d'affilée.",
							"img": "ui/tuto/duel2.jpg"
						}
					]
				},
				{
					"id": "TutoCaptainDuelHelp",
					"title": "Duel de Capitaine !",
					"props": {},
					"texts": [
						{
							"desc": "Les paroles du capitaine adverse annoncent sa prochaine action. Interprétez ses mots correctement et trouvez la riposte appropriée.",
							"img": "ui/tuto/duel1.jpg"
						}
					]
				},
				{
					"id": "TutoStartCaptainDuel",
					"title": "Provoquer un duel !",
					"props": {},
					"texts": [
						{
							"desc": "Le capitaine ennemi n'a plus d'[Armor]. Vous pouvez le provoquer en duel avec une unité en mêlée.",
							"img": "ui/tuto/captain.jpg"
						},
						{
							"desc": "Le duel est optionnel. Il est une manière plus noble de vaincre un capitaine ennemi."
						}
					]
				},
				{
					"id": "TutoNavigation",
					"title": "Navigation marine !",
					"props": {},
					"texts": [
						{
							"desc": "Le navire avance automatiquement si les voiles sont sorties.",
							"img": "ui/tuto/navigation1.jpg"
						},
						{
							"desc": "Sa vitesse dépend de la direction du vent, visible sur le compas et sur la carte marine. Pour avancer plus rapidement, vous pouvez sortir les rames, mais cela fatiguera votre troupe.",
							"img": "ui/tuto/navigation2.jpg"
						},
						{
							"desc": "En subissant des collisions, des tirs ou des intempéries, votre navire se détériorera. Vous pourrez le réparer ou l’améliorer dans n'importe quel Dock.",
							"img": "ui/tuto/navigation3.jpg"
						}
					]
				},
				{
					"id": "TutoSeaFight",
					"title": "Combat en mer !",
					"props": {},
					"texts": [
						{
							"desc": "*Chutes*:\n- Une unité poussée par-dessus bord reste suspendue et ne peut plus utiliser de compétences.\n- Elle peut seulement être secourue par un allié ou achevée par un ennemi en mêlée.",
							"img": "ui/tuto/seafall.jpg"
						},
						{
							"desc": "*Abordage*:\n- Les cordes permettent d’aborder le navire ennemi.\n- L’unité qui les utilise disparaît dans le gréement et retombe à distance au round suivant, occasionnant des dégâts et poussées aux unités proches.",
							"img": "ui/tuto/boarding.jpg"
						}
					]
				},
				{
					"id": "TutoBallista",
					"title": "Tirs de baliste !",
					"props": {},
					"texts": [
						{
							"desc": "Contrôles :\n- Continuez de diriger votre navire normalement.\n- Orientez la baliste avec [KEY_BallistaLeft] et [KEY_BallistaRight].\n- Tirez avec [KEY_BallistaFire].\n- Changez de projectile avec [KEY_BallistaProjectileChange].",
							"img": "ui/tuto/ballista.jpg"
						},
						{
							"desc": "Toucher un navire ennemi le ralentira et affaiblira son équipage. L'effet d'un projectile ne peut être appliqué qu'une seule fois à un navire ennemi."
						}
					]
				},
				{
					"id": "TutoBallistaFight",
					"title": "La baliste en combat !",
					"props": {},
					"texts": [
						{
							"desc": "La baliste blesse et repousse toutes les unités dans sa ligne de mire.\n\nPour être utilisée, elle doit d’abord être rechargée. Une unité ne peut recharger et actionner la baliste dans le même tour.",
							"img": "ui/tuto/ballistafight.jpg"
						}
					]
				},
				{
					"id": "TutoUltimate",
					"title": "Coup d'éclat !",
					"props": {},
					"texts": [
						{
							"desc": "Lorsqu'un compagnon atteint le niveau 12, il peut choisir une compétence \"Coup d'éclat\". Ces compétences vous permettront d'établir de nouvelles stratégies dans vos combats."
						},
						{
							"desc": "Attention à bien les utiliser car leur utilisation est limitée. Votre troupe peut réaliser un seul Coup d'éclat par round. Chaque compagnon a la possibilité d'utiliser son Coup d'éclat qu'une seule fois par combat."
						}
					]
				},
				{
					"id": "TutoDifficulty",
					"title": "Changement de la difficulté !",
					"props": {},
					"texts": [
						{
							"desc": "Nous avons réévalué la difficulté de Wartales lors de la dernière mise à jour !"
						},
						{
							"desc": "En suivant vos retours, la difficulté a été augmentée de façon à ce que le jeu ne soit pas trop facile passé le niveau 5. Entre nouveaux ennemis et nouvelles compétences, les groupes adverses vous donneront du fil à retordre. Il est possible que vous deviez redoubler de prudence en combat et peut-être repenser votre composition d'équipe. Désormais, votre sens de la tactique et de la stratégie aura un impact encore plus décisif."
						},
						{
							"desc": "Vous pouvez dès à présent changer la difficulté du jeu en cours de jeu, dans les options. Si le combat vous apparaît trop difficile, n'hésitez pas à battre en Retraite et à réduire la difficulté le temps de trouver vos marques."
						},
						{
							"desc": "Pour plus de précisions, vous pouvez consulter le patchnote de la mise à jour qui recense tous les changements liés à la difficulté."
						}
					]
				},
				{
					"id": "TutoStolenItems",
					"title": "Objets volés disparus",
					"props": {},
					"texts": [
						{
							"desc": "Tant qu'elle sera à vos trousses, la Garde se souviendra de ce que vous avez volé. Un objet volé que vous consommez, vendez, jetez ou utilisez dans une fabrication continuera de compter dans le montant de votre amende jusqu'à ce que vous ne soyez plus recherchés."
						},
						{
							"desc": "Blanchir un objet est le seul autre moyen de réduire le montant de votre amende."
						}
					]
				},
				{
					"id": "TutoTavern",
					"title": "Gestion de taverne",
					"props": {},
					"texts": [
						{
							"desc": "La taverne est un établissement géré par la troupe, qui peut générer des revenus à chaque repos. Pour qu’une taverne fonctionne, il lui faut du personnel, des équipements, et un menu bien fourni.",
							"img": "ui/tuto/tavern.jpg"
						},
						{
							"desc": "La réputation de la taverne est mesurée par le Prestige <img src=\"icon/TavernPrestige\" />. Il permet de débloquer des équipements et d'agrandir la taverne. Plus la clientèle est nombreuse, variée et satisfaite, plus le Prestige <img src=\"icon/TavernPrestige\" /> augmente.",
							"img": "ui/tuto/tavern_prestige.jpg"
						},
						{
							"desc": "Les principaux moyens d'attirer les clients et d'encourager les dépenses sont le Confort <img src=\"icon/TavernComfort\" />, la Sécurité <img src=\"icon/TavernSecurity\" /> et la Satisfaction <img src=\"icon/Happiness\" />, qui sera calculée après chaque service.",
							"img": "ui/tuto/tavern_satisfaction.jpg"
						}
					]
				},
				{
					"id": "TutoTavernBrewing",
					"title": "Cave de brassage",
					"props": {},
					"texts": [
						{
							"desc": "Chaque tonneau permet de produire de l'alcool si un brasseur y est assigné. La production est calculée à chaque service et coûte des ressources. Elle dépend du niveau du brasseur, du type d’alcool et de son degré de vieillissement <img src=\"icon/QualityStar\" />.",
							"img": "ui/tuto/tavern_brewing.jpg"
						},
						{
							"desc": "Lorsqu'un tonneau est mis en réserve, si un brasseur y est assigné, il gagne peu à peu des degrés de vieillissement <img src=\"icon/QualityStar\" /> qui augmentent sa valeur. Vieillir un alcool ne coûte pas de ressources.",
							"img": "ui/tuto/tavern_aging.jpg"
						},
						{
							"desc": "Pour obtenir de nouvelles recettes, vous pouvez explorer le compendium ou, si votre prestige est suffisant, voler les recettes secrètes des tavernes rivales.",
							"img": "ui/tuto/tavern_infiltration.jpg"
						}
					]
				},
				{
					"id": "TutoTavernCooking",
					"title": "Four",
					"props": {},
					"texts": [
						{
							"desc": "La production de nourriture dépend de la capacité du marmiton, mais aussi de la demande. Si elle est faible, alors le marmiton produira peu. Pour augmenter les chances de vente, fixez des prix raisonnables et choisissez des plats qui plaisent à votre clientèle.",
							"img": "ui/tuto/tavern_cooking.jpg"
						},
						{
							"desc": "Pour obtenir de nouvelles recettes, vous pouvez explorer le compendium, acheter des recettes dans les tavernes des différentes régions ou, si votre prestige est suffisant, voler leurs recettes secrètes.",
							"img": "ui/tuto/tavern_infiltration.jpg"
						}
					]
				},
				{
					"id": "TutoTavernEquipment",
					"title": "Commande d'équipements",
					"props": {},
					"texts": [
						{
							"desc": "Les équipements de taverne peuvent être déplacés, achetés ou revendus depuis cette fenêtre. Augmenter le Prestige <img src=\"icon/TavernPrestige\" /> de la taverne permet de débloquer de nouveaux types d'équipements.",
							"img": "ui/tuto/tavern_equipment.jpg"
						},
						{
							"desc": "Lorsque la version améliorée d’un équipement est disponible, il est possible de l’acheter directement, ou d'améliorer un équipement déjà possédé."
						}
					]
				},
				{
					"id": "TutoTavernStaff",
					"title": "Gestion du personnel",
					"props": {},
					"texts": [
						{
							"desc": "Pour fonctionner, la taverne repose sur différents rôles. Ils peuvent être remplis soit par vos compagnons, soit par des civils recrutés spécialement.",
							"img": "ui/tuto/tavern_staff.jpg"
						},
						{
							"desc": "Si la troupe est loin de la taverne, le transfert d’un compagnon n’est effectif qu'après le prochain service. Les civils, eux, sont disponibles immédiatement mais ne peuvent ni apprendre un nouveau métier, ni être transférés vers la troupe. Lorsqu'un civil est renvoyé, il touche une petite prime."
						},
						{
							"desc": "Le salaire des employés dépend de leur rôle, du Prestige <img src=\"icon/TavernPrestige\" /> de la taverne et de leur niveau de métier. Travailler dans la taverne rapporte de l'expérience de métier.",
							"img": "ui/tuto/tavern_employee.jpg"
						}
					]
				},
				{
					"id": "TutoTavernOverview",
					"title": "Trésorerie",
					"props": {},
					"texts": [
						{
							"desc": "La taverne fonctionne avec une monnaie spéciale : les pièces de cuivre <img src=\"icon/TavernSilver\" />. Elles peuvent être échangées contre des krowns <img src=\"icon/Gold\" />, mais chaque retrait fera évoluer le taux de change en votre défaveur. Le taux remonte légèrement après chaque service.",
							"img": "ui/tuto/tavern_coins.jpg"
						},
						{
							"desc": "Il n’est possible de renflouer la taverne avec des krowns <img src=\"icon/Gold\" /> que lorsque son solde est négatif. Le taux de change est alors fixé à 1 <img src=\"icon/TavernSilver\" /> pour 1 <img src=\"icon/Gold\" />."
						}
					]
				},
				{
					"id": "TutoTavernFactions",
					"title": "Factions",
					"props": {},
					"texts": [
						{
							"desc": "Plus votre taverne est visitée par des factions différentes, plus son Prestige <img src=\"icon/TavernPrestige\" /> augmente. Mais chaque faction a sa propre exigence : si elle n’est pas remplie, la faction ne viendra pas.",
							"img": "ui/tuto/tavern_factions.jpg"
						},
						{
							"desc": "Chaque faction a également ses préférences en termes de cuisine, de boisson, de musique, et d’ambiance. Si ces conditions sont remplies, la faction aura plus de chances d’affluer.",
							"img": "ui/tuto/tavern.jpg"
						},
						{
							"desc": "Plus votre menu reflètera les goûts de vos clients, plus les chances de vente de vos articles seront élevées."
						}
					]
				},
				{
					"id": "TutoTavernRanking",
					"title": "Classement des tavernes",
					"props": {},
					"texts": [
						{
							"desc": "Le classement des tavernes se fait en fonction de leur Prestige <img src=\"icon/TavernPrestige\" />. Dépasser le Prestige de tavernes réputées permet de prétendre à des étoiles <img src=\"icon/TavernStars\" />. En plus d’attirer les clients, celles-ci s’accompagnent de récompenses spéciales.",
							"img": "ui/tuto/tavern_ranking.jpg"
						},
						{
							"desc": "Il est possible d’envoyer des employés en mission d’infiltration dans une taverne rivale. L'effet d'une infiltration dépend du métier de l'infiltré, et ses chances de réussite dépendent à la fois du niveau de métier, du Prestige <img src=\"icon/TavernPrestige\" /> de la taverne visée, et du nombre de jours que dure la mission.",
							"img": "ui/tuto/tavern_infiltration.jpg"
						}
					]
				},
				{
					"id": "TutoStronghold",
					"title": "Bastion",
					"props": {},
					"texts": [
						{
							"desc": "Vous n'êtes pas encore en mesure de vous battre pour la libération de ce bastion. Tant que ce sera le cas, vous subirez des blessures en vous avançant trop près de ce bastion.",
							"img": "ui/tuto/edoran2_stronghold.jpg"
						}
					]
				},
				{
					"id": "TutoRam",
					"title": "Bélier",
					"props": {},
					"texts": [
						{
							"desc": "Une unité alliée s'est assignée au bélier. Vous devez également assigner une de vos unités afin de prendre le contrôle du bélier.",
							"img": "ui/tuto/edoran2_ram.jpg"
						}
					]
				},
				{
					"id": "TutoSiege1",
					"title": "Siège",
					"props": {},
					"texts": [
						{
							"desc": "Vous devez reprendre le bastion. Celui-ci est protégé par des structures que vous pouvez détruire.",
							"img": "ui/tuto/edoran2_castle_1.jpg"
						},
						{
							"desc": "Pour reprendre le bastion, il faut pénétrer dans l'enceinte de la forteresse en détruisant la porte. Les béliers sont bien plus efficaces que les unités pour détruire ces structures.",
							"img": "ui/tuto/edoran2_castle_2.jpg"
						}
					]
				},
				{
					"id": "TutoSiege2",
					"title": "Siège",
					"props": {},
					"texts": [
						{
							"desc": "Vous êtes parvenu à pénétrer dans le bastion. Vous pouvez redéployer vos unités.",
							"img": "ui/tuto/edoran2_castle_3.jpg"
						},
						{
							"desc": "Pour reprendre complètement le bastion, il va falloir vaincre le chef adverse pour hisser le drapeau et le protéger pendant plusieurs rounds.",
							"img": "ui/tuto/edoran2_castle_4.jpg"
						}
					]
				},
				{
					"id": "TutoWarEffort",
					"title": "Effort de guerre",
					"props": {},
					"texts": [
						{
							"desc": "Une fois certains lieux reconstruits, les occupants souhaiteront participer à l'effort de guerre afin d'aider à la libération de la région. Vous pouvez choisir la forme que prendra leur aide directement depuis la carte stratégique sans être à proximité du lieu.",
							"img": "ui/tuto/edoran2_warEffortMap.jpg"
						}
					]
				},
				{
					"id": "TutoManPowerSkill",
					"title": "Compétence de conquête",
					"props": {},
					"texts": [
						{
							"desc": "Vous avez débloqué la compétence de conquête liée à cette sous-région : <skill>Volley</skill>. Chacune de ces compétences peut être utilisée une fois par combat par n'importe laquelle de vos unités et coûte une certaine quantité de <img src=\"item/E2Manpower\"/>[E2Manpower].",
							"img": "ui/tuto/edoran2_manPowerSkill.jpg"
						}
					]
				},
				{
					"id": "TutoConvoy",
					"title": "Convoi de prisonnier",
					"props": {},
					"texts": [
						{
							"desc": "Vous avez intercepté un convoi de prisonniers. Durant ce combat, vous obtenez [E2Manpower] <img src=\"icon/E2Manpower\" /> pour chaque prisonnier libéré.\nLibérez les prisonniers rapidement car les ennemis chercheront à les éliminer en priorité.",
							"img": "ui/tuto/edoran2_convoy.jpg"
						}
					]
				},
				{
					"id": "TutoRenfortsManagement",
					"title": "Gestion des renforts",
					"props": {},
					"texts": [
						{
							"desc": "Une partie de votre troupe arrivera en renfort durant ce combat. Vous pouvez gérer ou voir vos renforts en cliquant sur l'icone de renfort ou sur un emplacement de déploiement vide. La gestion des renforts n'est possible que pendant la phase de déploiement.\nPour replier une unité, il faut cliquer sur celle-ci après l'avoir sélectionnée. Pour déployer une unité, il faut cliquer sur celle-ci dans la fenêtre de gestion des renforts. Il est possible de modifier l'emplacement où sera déployée l'unité en cliquant sur un emplacement de déploiement vide.",
							"img": "ui/tuto/renfort_management_icon.jpg"
						}
					]
				},
				{
					"id": "TutoHunt",
					"title": "Apprenez à chasser !",
					"props": {},
					"texts": [
						{
							"desc": "Votre <b>Pisteur</b> peut examiner les traces laissées par les animaux dans le monde pour lancer une chasse.",
							"img": "ui/tuto/hunt1.png"
						},
						{
							"desc": "Un chemin indique la direction du groupe d'animaux.",
							"img": "ui/tuto/hunt2.png"
						},
						{
							"desc": "En examinant les alentours, vous pourrez trouver une trace supplémentaire qui vous donne un bonus contre le groupe d'animaux chassé.",
							"img": "ui/tuto/hunt3.png"
						}
					]
				},
				{
					"id": "TutoBeastHunt",
					"title": "Chasser la Bête",
					"props": {},
					"texts": [
						{
							"desc": "Examiner les traces laissées par La Bête vous octroie des Connaissances de la Bête <img src=\"icon/DLC_TheBeast\" />.",
							"img": "ui/tuto/beasthunt1.png"
						},
						{
							"desc": "Vous gagnerez aussi des Connaissances de la Bête <img src=\"icon/DLC_TheBeast\" /> en examinant l'outil Piste dans le camp, ou en rencontrant La Bête.",
							"img": "ui/tuto/beasthunt2.png"
						},
						{
							"desc": "Dépensez des Connaissances de la Bête <img src=\"icon/DLC_TheBeast\" /> dans la Carte de Traque pour obtenir un indice sur la position des autres traces, ou pour gagner des bonus uniques.",
							"img": "ui/tuto/beasthunt3.png"
						}
					]
				},
				{
					"id": "TutoBeastInfluence",
					"title": "Influence de la Bête",
					"props": {},
					"texts": [
						{
							"desc": "Les animaux avec le statut Influencé par la Bête se transformeront après 5 applications. Ils deviennent hostiles et quittent la troupe à la fin du combat.",
							"img": "ui/tuto/beastinfluence1.png"
						},
						{
							"desc": "Un animal influencé peut résister à l'influence à la place de toute autre action dans son tour.",
							"img": "ui/tuto/beastinfluence2.png"
						},
						{
							"desc": "Les applications du statut persistent après le combat. Un animal influencé gagne 1 application du statut après chaque repos.",
							"img": "ui/tuto/beastinfluence3.png"
						}
					]
				},
				{
					"id": "TutoBeastInfluenceCamp",
					"title": "Influence de la Bête",
					"props": {},
					"texts": [
						{
							"desc": "Un animal influencé par la Bête gagne une application supplémentaire du statut après chaque repos.",
							"img": "ui/tuto/beastinfluence4.png"
						},
						{
							"desc": "Après 5 applications l'animal se transforme. Vous devrez choisir entre l'abandonner ou l'aider à résister, à vos risques et périls.",
							"img": "ui/tuto/beastinfluence5.png"
						}
					]
				},
				{
					"id": "TutoIR2Intro",
					"title": "Aidez les Maîtres Traqueurs à fuir",
					"props": {},
					"texts": [
						{
							"desc": "Les Maîtres Traqueurs ne peuvent pas fuir tant qu'ils sont engagés.",
							"img": "ui/tuto/ir2intro1.png"
						},
						{
							"desc": "Lorsqu'ils sont désengagés, ils sont pétrifiés par la peur.",
							"img": "ui/tuto/ir2intro2.png"
						},
						{
							"desc": "Utilisez la compétence conditionnelle \"Créer une diversion\" pour les faire fuir le combat.",
							"img": "ui/tuto/ir2intro3.png"
						}
					]
				},
				{
					"id": "TutoFiefIntro",
					"title": "Rénovez la salle du trône",
					"props": {},
					"texts": [
						{
							"desc": "L'icône d'emplacement de quartier vous permet de construire votre [FiefPlace_Throne]. Elle sera le <b>bâtiment central</b> de votre premier quartier : le quartier du Donjon.",
							"img": "ui/tuto/fief/fiefintro1.png"
						},
						{
							"desc": "Chaque quartier contient plusieurs emplacement où vous pourrez construire des bâtiments.",
							"img": "ui/tuto/fief/fiefintro2.png"
						}
					]
				},
				{
					"id": "TutoFiefBuild",
					"title": "Construisez un bâtiment",
					"props": {},
					"texts": [
						{
							"desc": "Construisez un nouveau bâtiment via l'icône d'emplacement de bâtiment.",
							"img": "ui/tuto/fief/fiefbuild1.png"
						},
						{
							"desc": "Ouvrez l'interface de gestion d'un bâtiment via son icône. Certains bâtiments produisent des objets, d'autres octroient des effets spéciaux ou peuvent contenir certains personnages ou services.",
							"img": "ui/tuto/fief/fiefbuild2.png"
						},
						{
							"desc": "Améliorez un bâtiment pour produire plus d'objets ou pour accéder à de meilleurs effets. Le niveau d'un bâtiment ne peut pas dépasser le niveau du quartier dans lequel il a été construit.",
							"img": "ui/tuto/fief/fiefbuild3.png"
						}
					]
				},
				{
					"id": "TutoFiefProd",
					"title": "Produisez des ressources",
					"props": {},
					"texts": [
						{
							"desc": "Chaque objet produit par vos bâtiments participe à satisfaire les <b>besoins</b> de votre population : [Fief_Needs_Food], [Fief_Needs_Defense], [Fief_Needs_Hobbies] et [Fief_Needs_Education].",
							"img": "ui/tuto/fief/fiefprod1.png"
						},
						{
							"desc": "Chaque <b>besoin</b> augmente avec la [Fief_Val_Pop] et est modifié par la <b>composition</b> de celle-ci.",
							"img": "ui/tuto/fief/fiefprod2.png"
						},
						{
							"desc": "À chaque repos, un besoin satisfait augmente le [Fief_Val_Happy]. A l'inverse, un besoin insatisfait le réduit.",
							"img": "ui/tuto/fief/fiefprod3.png"
						}
					]
				},
				{
					"id": "TutoFiefImpots",
					"title": "Prélevez l'impôt",
					"props": {},
					"texts": [
						{
							"desc": "Dans le menu de gestion du fief, vous pouvez définir la quantité d'impôts à prélever sur chaque quartier.",
							"img": "ui/tuto/fief/fiefimpot1.png"
						},
						{
							"desc": "Tous les bâtiments du quartier subissent un malus de production équivalent au taux d'imposition, ce qui impacte négativement le [Fief_Val_Happy] en échange d'un revenu.",
							"img": "ui/tuto/fief/fiefimpot2.png"
						},
						{
							"desc": "Le revenu généré à chaque repos dépend de la quantité de production imposée.",
							"img": "ui/tuto/fief/fiefimpot3.png"
						}
					]
				},
				{
					"id": "TutoFiefMissions",
					"title": "Envoyez des troupes en mission",
					"props": {},
					"texts": [
						{
							"desc": "Envoyez des mercenaires réaliser des contrats via le tableau de missions.",
							"img": "ui/tuto/fief/fiefmission1.png"
						},
						{
							"desc": "Chaque mission recommande la présence de différents types d'armes dans la composition de la troupe qui l'effectuera.",
							"img": "ui/tuto/fief/fiefmission3.png"
						},
						{
							"desc": "Chaque compagnon maniant une des armes recommandées augmente la récompense obtenue.",
							"img": "ui/tuto/fief/fiefmission4.png"
						}
					]
				},
				{
					"id": "TutoFiefGrowPop",
					"title": "Augmentez votre population",
					"props": {},
					"texts": [
						{
							"desc": "À chaque repos, la [Fief_Val_Pop] augmente lorsque le [Fief_Val_Happy] est positif et diminue lorsqu'il est négatif.",
							"img": "ui/tuto/fief/fiefpop1.png"
						},
						{
							"desc": "Plus votre [Fief_Val_Pop] grandit, plus ses <b>besoins</b> augmentent.",
							"img": "ui/tuto/fief/fiefpop2.png"
						},
						{
							"desc": "Les <b>types de population</b> qui composent votre peuple augmentent ou réduisent les besoins.",
							"img": "ui/tuto/fief/fiefpop3.png"
						}
					]
				},
				{
					"id": "TutoFiefLevelUp",
					"title": "Montez de niveau",
					"props": {},
					"texts": [
						{
							"desc": "Votre fief monte de niveau lorsque votre [Fief_Val_Pop] atteint un certain seuil.",
							"img": "ui/tuto/fief/fieflevel1.png"
						},
						{
							"desc": "Vous pouvez alors construire un quartier supplémentaire.",
							"img": "ui/tuto/fief/fieflevel2.png"
						},
						{
							"desc": "Chaque niveau de fief vous donne accès à de nouveaux bâtiments, de nouveaux personnages et services ou de nouvelles fonctionnalités.",
							"img": "ui/tuto/fief/fieflevel3.png"
						}
					]
				},
				{
					"id": "TutoFiefMandate",
					"title": "Utilisez les mandats",
					"props": {},
					"texts": [
						{
							"desc": "Les mandats octroient des effets à leur lancement ou à chaque repos pendant leur durée d'exécution.",
							"img": "ui/tuto/fief/mandat1.png"
						},
						{
							"desc": "Le nombre maximum de mandats actifs dépend du niveau de votre fief.",
							"img": "ui/tuto/fief/mandat2.png"
						},
						{
							"desc": "Vous ne pouvez utiliser certains mandats que lorsqu'une condition est remplie."
						}
					]
				},
				{
					"id": "TutoFiefGovernment",
					"title": "Choisissez un gouvernement",
					"props": {},
					"texts": [
						{
							"desc": "Les gouvernements définissent la structure de votre fief. Ils lui appliquent des effets permanents, débloquent certains mandats et vous permettent de gagner du [Fief_Currency_Power].",
							"img": "ui/tuto/fief/gov3.png"
						},
						{
							"desc": "Débloquez de nouveaux gouvernements en modifiant l'alignement de votre fief ou via certaines audiences.",
							"img": "ui/tuto/fief/gouv1.png"
						},
						{
							"desc": "Vous pouvez changer de gouvernement gratuitement <b>une fois par niveau</b>. Au delà, vous devrez dépenser du [Fief_Currency_Power].",
							"img": "ui/tuto/fief/gouv2.png"
						}
					]
				},
				{
					"id": "TutoFiefAudiences",
					"title": "Résolvez les audiences",
					"props": {},
					"texts": [
						{
							"desc": "Les gens de votre peuple ou des intervenants extérieurs demandent régulièrement audience. Ils attendent dans la salle du trône.",
							"img": "ui/tuto/fief/audience1.png"
						},
						{
							"desc": "Les demandeurs d'audience finissent par s'en aller s'ils attendent trop longtemps. Il peuvent revenir ultérieurement.",
							"img": "ui/tuto/fief/audience2.png"
						},
						{
							"desc": "Les audiences peuvent octroyer des récompenses ou appliquer des effets. Certaines d'entre elles vous donneront des objectifs à remplir.",
							"img": "ui/tuto/fief/audience3.png"
						}
					]
				},
				{
					"id": "TutoFiefAudiencesCampNotice",
					"title": "Audiences disponibles",
					"props": {},
					"texts": [
						{
							"desc": "Quelqu'un dans votre fief demande audience. Rendez-vous à la [FiefPlace_Throne] pour en apprendre plus.",
							"img": "ui/tuto/fief/fiefaudiencecamp.png"
						}
					]
				},
				{
					"id": "A2Lantern",
					"title": "Explorez la Sylve",
					"props": {},
					"texts": [
						{
							"desc": "La Sylve est un endroit sombre, tortueux et dangereux: vous perdez accès à votre boussole, au calendrier et à votre position exacte sur la carte du monde.",
							"img": "ui/tuto/a2/lantern1.png"
						},
						{
							"desc": "Dans la Sylve, vous pouvez allumer votre [AlazarLantern] qui dispose d'une portée d'éclairage et d'une consommation.",
							"img": "ui/tuto/a2/lantern2.png"
						},
						{
							"desc": "Vous pouvez choisir d'évoluer dans l'obscurité la plus totale et trouver certaines choses qui ne se voient qu'une fois la lumière éteinte. Mais prenez garde...",
							"img": "ui/tuto/a2/lantern3.png"
						}
					]
				},
				{
					"id": "A2Sanity",
					"title": "Santé mentale",
					"props": {},
					"texts": [
						{
							"desc": "La Santé mentale est une nouvelle jauge de troupe qui détermine à quel point votre troupe sombre dans la folie.",
							"img": "ui/tuto/a2/sanity1.png"
						},
						{
							"desc": "Au coeur de la Sylve, certains événements pourront affecter votre santé mentale, comme les hallucinations ou des challenges de combat spécifiques.",
							"img": "ui/tuto/a2/sanity2.png"
						},
						{
							"desc": "Si votre Santé mentale atteint 0, vous serez expulsés de la Sylve.",
							"img": "ui/tuto/a2/sanity3.png"
						}
					]
				},
				{
					"id": "A2Science",
					"title": "Science",
					"props": {},
					"texts": [
						{
							"desc": "Vous pouvez effectuer des recherches scientifiques et trouver des améliorations uniques et des recettes inédites.",
							"img": "ui/tuto/a2/research1.png"
						},
						{
							"desc": "Les Greffons sont nécessaires à toute recherche en Alazar : certains se ramassent dans la Sylve, d'autres sur les Lycanthropes, d'autres encore dans l'obscurité.",
							"img": "ui/tuto/a2/research2.png"
						}
					]
				},
				{
					"id": "A2SanityCombat",
					"title": "Santé mentale (combat)",
					"props": {},
					"texts": [
						{
							"desc": "Selon l'état de votre Santé mentale, certaines unités de votre troupe peuvent être affectées par des troubles.",
							"img": "ui/tuto/a2/sanchallenge1.png"
						},
						{
							"desc": "Ces troubles sont des défis spécifiques : réussir ou échouer aura un effet sur votre jauge de Santé mentale.",
							"img": "ui/tuto/a2/sanchallenge2.png"
						}
					]
				},
				{
					"id": "E3Chaos",
					"title": "Le chaos à Isandrin",
					"props": {},
					"texts": [
						{
							"desc": "Le [E3Chaos] représente l'instabilité d'Isandrin. Il augmentera constamment tant que vous n’aurez pas découvert ce qui pousse les habitants de la capitale à se rebeller contre le Général.",
							"img": "ui/tuto/e3/e3chaos1.png"
						},
						{
							"desc": "Pour éviter une nouvelle <b>Crise</b>, vous devez contenir le [E3Chaos] en éliminant des [Rioters] ou encore de réussissant des objectifs de combat secondaires. D’autres moyens de réduire le [E3Chaos] existent, encore faut-il les trouver !",
							"img": "ui/tuto/e3/e3chaos2.png"
						},
						{
							"desc": "Chaque niveau de [E3Chaos] à des effets sur le Comté de Lombelle : les rebelles s’enhardissent ! Ils s’attaquent à la Légion, aux bâtiments de la ville, malmènent les commerçants. Mieux vaut ne pas attendre une <b>Crise</b> pour y remédier.",
							"img": "ui/tuto/e3/e3chaos3.png"
						}
					]
				},
				{
					"id": "E3Crisis",
					"title": "Isandrin est en crise !",
					"props": {},
					"texts": [
						{
							"desc": "Des [Rioters] ont incendié une partie de la ville. Cette <b>Crise</b> met en péril l'équilibre d'Isandrin.",
							"img": "ui/tuto/e3/e3chaos3.png"
						},
						{
							"desc": "Lors d'une <b>Crise</b> les bâtiments en ville sont inaccessibles, et certains personnages disparaissent du Comté.",
							"img": "ui/tuto/e3/e3crisis2.png"
						},
						{
							"desc": "Aidez la [Legion] à vaincre le groupe d'[Rioters] pour ramener l'ordre.",
							"img": "ui/tuto/e3/e3crisis3.png"
						}
					]
				},
				{
					"id": "TutoFireFight",
					"title": "Incendie (combat)",
					"props": {},
					"texts": [
						{
							"desc": "Des civils sont prisonniers des flammes. Vous devez les libérer avant qu'il ne soit trop tard.",
							"img": "ui/tuto/e3/tutofirefight.png"
						}
					]
				},
				{
					"id": "TutoPropaganda",
					"title": "Placarder des affiches",
					"props": {},
					"texts": [
						{
							"desc": "Pour réduire le [E3Chaos] vous pouvez placarder des affiches à la gloire du jeune général.",
							"img": "ui/tuto/e3/tutopropaganda1.png"
						},
						{
							"desc": "Elles seront périodiquement remplacées. Pensez donc à vérifier régulièrement et à les recoller pour réduire le [E3Chaos] de nouveau.",
							"img": "ui/tuto/e3/tutopropaganda2.png"
						}
					]
				},
				{
					"id": "TavernCustomTutorial",
					"title": "Objectifs",
					"props": {
						"reward": {
							"counters": [
								{
									"counter": "TavernSilver",
									"value": 50
								}
