					"script": "function onSkillPlayed(s) {
						if (s.kind == Skill.KnockOut) return;
						var minD : Float = vars.value1;
						var minFoe = null;
						if ( skill.unit.isEngaged() ){
							minFoe = skill.unit.engagedUnit;
						} else for( u in getFoes(skill.unit, true) ) {
							var d = getDistance(skill.unit, u);
							if( d < minD && !u.isInFog()) {
								minD = d;
								minFoe = u;
							}
						}
						if (minFoe != null) {
							spawnFx();
							attackTarget(minFoe);
						}
					}",
