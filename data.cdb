												"inf": "ActionPoint"
											}
										]
									}
								}
							],
							"personality": "PersOptimist"
						},
						{
							"introDialog": [
								{
									"text": "[MX]Jéru sait que je ne veux abandonner personne, mais être recherché par la Garde… ! C’est grave ! Ce n’est pas trois bandits qui nous courent après mais une patrouille de soldats entrainés !"
								},
								{
									"text": "[FX]Jéru sait que je ne veux abandonner personne, mais être recherchée par la Garde… ! C’est grave ! Ce n’est pas trois bandits qui nous courent après mais une patrouille de soldats entrainés !"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Se plaindre pour faire descendre le stress."
										}
									],
									"tipText": "Se plaindre",
									"cost": {},
