					"done": 2
				},
				{
					"id": "BraveSupport",
					"name": "Soutien valeureux",
					"desc": "Chaque fois que cette unité termine son tour adjacent à un allié sans être engagée, obtenez <apt>::value1::</apt>.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 1
						}
					},
					"script": "function onEndTurn() {\n\tif (!skill.unit.isEngaged() && isMeleeWithAlly(skill.unit)) {\n\t\tskill.unit.gainsActionPoint(vars.value1);\n\t\tspawnFx();\n\t}\n}",
					"notes": "",
