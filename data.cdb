					},
					"script": "function onSkill() {\n\tplayAttack();\n\tfor( t in skill.getTargets() ) {\n\t\tif( checkReinforce(t) ) {\n\t\t\tt.target.disengage(true);\n\t\t} else if( skill.level == 2 ) {\n\t\t\tt.target.pushback(getPushbackOrigin(t), getPushback(t), t);\n\t\t}\n\t}\n}\n\nfunction getPushback( a ) {\n\tif( skill.level == 2 ) {\n\t\treturn vars.value1;\n\t}\n\treturn 0;\n}\n\nfunction getPushbackOrigin(a){\n\treturn {skill : skill};\n}",
					"notes": "",
