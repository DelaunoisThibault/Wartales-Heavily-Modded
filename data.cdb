							{
								"st": "Poison"
							}
						],
						"apCost": 0,
						"specialAnim": "ThrowLeftGrenade",
						"vars": {
							"value1": 1
						},
						"useWithoutWeapon": true,
						"flags": 64,
						"needDisengaged": true,
						"throwModel": "chars/Weapons/LeftHand_IncendiaryFlask.fbx",
