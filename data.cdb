						},
						"globalEvents": true,
						"usableWhenLocked": true
					},
					"script": "function onBeginBattle() {\n\tvars.nbCivils = randInt(1, vars.nbCivils);\n\tskill.unit.addStatus(Status.BurningStructure);\n\tlockUnit(skill.unit);\n\tskill.unit.stats.maxHealth = vars.nTurns;\n}\n\nfunction onBeginRound() {\n\tif( !skill.unit.hasStatus(Status.BurningStructure) ) {\n\t\tskill.unit.addStatus(Status.BurningStructure);\n\t}\n}\n\nfunction onEndRound() {\n\tvars.nTurns -= 1;\n\tskill.unit.health = vars.nTurns;\n\tif( vars.nTurns <= 0 ) {\n\t\tskill.unit.die(null);\n\t}\n}",
					"notes": "",
					"done": 1,
					"icon": {
						"file": "ui/Icons/BattleIcons_05_96PX.png",
