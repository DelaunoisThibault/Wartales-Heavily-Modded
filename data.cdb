					"script": "function onBeginAction() {\n    vars.nbUnits = 0;\n    for (u in getFoes(skill.unit)){\n        var dist = getDistance(u, skill.unit);\n        if (u.armor < u.stats.armor && dist < vars.value2)\n            vars.nbUnits++;\n    }\n\n    var val = floor(vars.nbUnits * vars.value1);\n    var statusCount = skill.unit.getStatusCount(Status.MaceSpe5Skill3Status);\n    var d = floor(val - statusCount);\n    if (d > 0)\n        skill.unit.addStatus(Status.MaceSpe5Skill3Status, d);\n    else if (d < 0){\n        skill.unit.consumeStatus(Status.MaceSpe5Skill3Status, -d);\n    }\n\n}",
