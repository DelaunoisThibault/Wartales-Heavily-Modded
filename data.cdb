					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {},
					"script": "function onEndTurn() {\n\tfor( u in getAllies(skill.unit) ) {\n\t\tif( u.isMelee(skill.unit) ) {\n\t\t\tskill.unit.cancelStatus(Status.EerieLink);\n\t\t\tspawnFx();\n\t\t\treturn;\n\t\t}\n\t}\n\tskill.unit.addStatus(Status.Terror, round(getStatusValue(Status.EerieLink)));\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "SleepingStatus",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "function onSkillEval(s){\n \tfor ( t in s.getTargets()) {\n        if (t.target == skill.unit ) {\n            t.baseDamageBonus += round(getStatusValue(Status.Sleeping));\n\t\t\tt.criticalHitPercent = 100;\n        }\n    }\n}",
					"notes": "",
