								"st": "Poison"
							},
							{
								"st": "PrisonnerHealthMurderReinforcement"
							}
						]
					},
					"script": "function onBeginBattle() {
						vars.currentStack = 0;
						skill.unit.cancelStatus(Status.PrisonnerHealthMurderReinforcement);
						skill.unit.addStatus(Status.PrisonnerHealthMurderReinforcement, skill.unit.getCounter(Counter.PoisonCounterForPlagueriddensHealthStack));
					}
					function onEndTurn(){
						for( s in skill.unit.getAllStatus() ){
							if( s.kind == Status.Poison ) {
								vars.currentStack = s.count;
								if( vars.currentStack >= vars.value1 ) {
									skill.unit.incCounter(Counter.PoisonCounterForPlagueriddensHealthStack, vars.value2);
									skill.unit.cancelStatus(Status.PrisonnerHealthMurderReinforcement);
									skill.unit.addStatus(Status.PrisonnerHealthMurderReinforcement, skill.unit.getCounter(Counter.PoisonCounterForPlagueriddensHealthStack));
									vars.currentStack = 0;
								}
							}
						}
					}",
