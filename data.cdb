				{
					"id": "AnimalUnity",
					"name": "Unité animale",
					"desc": "À la fin de son tour, cette unité soigne l'animal allié le plus proche d'un montant égal à la [Constitution] de l'animal.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 50
						},
						"descPassiveGroup": "[GROUPTYPE] : Quand une unité non-animale termine son tour, elle soigne l'animal allié le plus proche d'un montant égal à la [Constitution] de l'animal."
					},
					"script": "function onEndTurn() {\n\tvar array = [];\n\tif( !skill.unit.isAnimal ) {\n\t\tfor( t in getAllies(skill.unit) ) {\n\t\t\tif( t.isAnimal ) {\n\t\t\t\tvar d = getDistance(skill.unit, t);\n\t\t\t\tarray.push({ dist : d, target: t });\n\t\t\t}\n\t\t}\n\t\tarray.sort(function (u1, u2) {\n\t\t\tif (u1.dist < u2.dist) {\n\t\t\t\treturn -1;\n\t\t\t}\n\t\t\tif (u2.dist < u1.dist) {\n\t\t\t\treturn 1;\n\t\t\t}\n\t\t\treturn 0;\n\t\t});\n\t\tvar nb = 1;\n\t\tnb = min(array.length, nb);\n\t\tfor( i in 0...nb ) {\n\t\t\tspawnFx();\n\t\t\tarray[i].target.heal(skill, ceil(array[i].target.stats.health*vars.value1/100));\n\t\t}\n\t}\n}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
						"size": 96,
						"x": 18,
						"y": 7
