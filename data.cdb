				},
				{
					"id": "BossPitE1_ReducPassif",
					"name": "Retranché",
					"desc": "Cette unité reçoit jusqu'à -::maxReduc::% de dégâts de toute source, basés sur la [Health] restante des différentes barricades.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"maxReduc": 75
						},
						"globalEvents": true
					},
					"script": "function onSkillEval(s){\n    for (t in s.getTargets())\n        if (t.target == skill.unit)\n            t.baseDamageBonus -= getReduction();\n}\n\nfunction onDotEval(dot) {\n    if (dot.unit == skill.unit)\n        dot.dmg = floor(dot.dmg * (1 - getReduction() / 100));\n}\n\nfunction getReduction() {\n    return ceil(pitNbAliveBarricades() / 4 * vars.maxReduc);\n}",
					"notes": "maxReduc = reduc en % quand les 4 armures sont en vie (0 sinon)",
					"done": 1,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_03_96PX.png",
