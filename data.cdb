								"st": "Pushback"
							}
						],
						"globalEvents": true
					},
					"script": "function onHit(a) {\n\tif (a.unit == skill.unit && a.skillKind == Skill.FugitiveBowLegion){\n\t\ta.target.pushback({ unit : skill.unit }, getPushback(a), a);\n\t}\n}\n\nfunction getPushback( a ) {\n\treturn vars.value1;\n}\n\nfunction onAfterPushback(t){\n\tif (t.unit == skill.unit && t.skillKind == Skill.FugitiveBowLegion){\n\t\tif (t.pushbackData.touchObstacle || t.pushbackData.touchUnit){\n   \t    \tt.target.damages(skill, t.dmgDealt);\n\t\t}\n\t}\n}",
