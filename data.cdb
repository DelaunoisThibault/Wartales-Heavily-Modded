					"script": "function onHit(a) {\n\ta.target.pushback({unit : skill.unit}, getPushback(a), a);\n\tif (vars.applied) return;\n\tvars.applied = true;\n\tvar minD = 10e9;\n\tvar minFoe = null;\n\tfor( t in skill.getTargets() ) {\n\t\tvar d = getDistance(t.target, skill.unit);\n\t\tif( d < minD ) {\n\t\t\tminD = d;\n\t\t\tminFoe = t.target;\n\t\t}\n\t}\n\tminFoe.addStatus(Status.Slowdown, vars.value2, true);\n}\n\nfunction getPushback( a ) {\n\treturn vars.value1;\n}\n\nfunction onPostSkill() {\n\tvars.applied = false;\n}",
