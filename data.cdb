				{
					"id": "FuriousAndSolidGroup",
					"name": "Groupe soudé et furieux",
					"desc": "Chaque fois qu'un animal allié meurt, cette unité gagne ::value1:: [AnimalMarkedBonus]. \nTous les ::value2:: animaux alliés tués, cette unité gagne également ::value3:: [Enervate]. Décompte actuel : ::deadsCount::",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 2,
							"value2": 5,
							"value3": 1,
							"deadsCount": 0
						},
						"globalEvents": true,
						"tooltipStatus": [
							{
								"st": "AnimalMarkedBonus"
							},
							{
								"st": "Enervate"
							}
						],
						"descPassiveGroup": "[GROUPTYPE] : Chaque fois qu'un animal du groupe meurt, les unités gagnent ::value1:: [AnimalMarkedBonus]. \nTous les ::value2:: animaux du groupe tués, les unités gagnent également ::value3:: [Enervate]. Décompte actuel : ::deadsCount::."
					},
					"script": "function onBeginBattle() {
						vars.deadsCount = 0;
					}
					function onDeath(a) {
						if( a.target.isAnimal && a.target.side == skill.unit.side && a.target != skill.unit ) {
							skill.unit.addStatus(Status.AnimalMarkedBonus, vars.value1);
							vars.deadsCount++;
							if( vars.deadsCount >= vars.value2 ){
								skill.unit.addStatus(Status.Enervate, vars.value3);
								vars.deadsCount = 0;
							}
						}
					}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
						"size": 96,
						"x": 11,
						"y": 12
					},
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "BearComeBack",
					"name": "Renouveau ursidé",
					"desc": "Quand cette unité gagne [Berserk], si sa santé est inférieure à ::value1::% de sa santé maximum, elle se soigne de ::value2::% de sa santé maximum. \nSinon, elle gagne [Protection] pour le restant du combat.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 50,
							"value2": 25
						},
						"tooltipStatus": [
							{
								"st": "Berserk"
							},
							{
								"st": "Protection"
							}
						],
						"descPassiveGroup": "[GROUPTYPE] : Quand une unité gagne [Berserk], si sa santé est inférieure à ::value1::% de sa santé maximum, elle se soigne de ::value2::% de sa santé maximum. \nSinon, elle gagne [Protection] pour le restant du combat."
					},
					"script": "function onStatus(s) {
						var p = 100 * (skill.unit.health / skill.unit.stats.health);
						if( s.unit == skill.unit && s.kind == Status.Berserk) {
							if( p < vars.value1 ){
								skill.unit.heal(skill, ceil(skill.unit.stats.health*vars.value2/100));
							} else {
								skill.unit.addStatusPersist(Status.Protection, skill);
							}
						}
					}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
