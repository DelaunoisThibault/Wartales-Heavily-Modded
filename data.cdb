					function onSkillPlayed(s) {
						if( skill.unit.isEngaged() && !vars.engaged ) {
							vars.engaged = true;
							spawnFx();
							var foes = getFoes(skill.unit);
							for( u in foes ) {
								if( getDistance(skill.unit, u) <= vars.value2 ) {
									u.addStatus(Status.Poison, vars.value1);
								}
							}
						}
					}",
