						{
							"introDialog": [
								{
									"text": "[XX]Bon sang ! J'ose même plus parler aux autres parce que j'ai oublié leurs noms ! \nIl faut que je fasse un effort, ça va finir par me jouer des tours !"
								}
							],
							"choices": [],
							"personality": "PersAggressive"
						},
						{
							"introDialog": [
								{
									"text": "[XX]J'ai parfois le sentiment de voyager avec des inconnus. Je connais leurs noms, je sais quelles armes ils manient, mais s’ils mouraient demain, j'ignorerais à qui envoyer leurs soldes."
								}
							],
							"choices": [],
							"personality": "PersCompassionate"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Si cette troupe veut survivre, ses membres doivent être unis et solidaires. Nous devons devenir des compagnons, non des inconnus qui partagent un feu de camp."
								}
							],
							"choices": [],
							"personality": "PersPragmatic"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Pour devenir la meilleure troupe de mercenaires des Cinq Royaumes, nous devons être unis comme les doigts de la main. Ces inconnus doivent devenir ma famille !"
								}
							],
							"choices": [],
							"personality": "PersOptimist"
						}
