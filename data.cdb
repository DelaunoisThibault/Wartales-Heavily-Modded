				},
				{
					"id": "Purge",
					"name": "Purger",
					"desc": "Déclenche l’effet de [PurgeTrigger] de l’[Censer] équipé, puis consomme toutes les [Inhalation].",
					"mode": 5,
					"range": {
						"radius": 5,
						"type": 0,
						"allowedTargets": 4
					},
					"props": {
						"vars": {
							"allowed": false
						},
						"isAttack": true,
						"specialAnim": "ActivateWide",
						"preventEngage": true
					},
					"script": "function onBeginAction() {\n\tvars.allowed = skill.unit.getStatusCount(Status.Inhalation) > 0;\n}\n\nfunction onSkill() {\n\tplayAnim();\n\tskill.unit.playFx(\"prefabs/fx/fight/Thaumaturge/Purge_IB.fx\");\n\tpurgeCenser();\n\tpurgeCenserTargets(skill.getTargets());\n\tif (!skill.unit.hasStatus(Status.Censer_lvl12_status)) {\n\t\tskill.unit.cancelStatus(Status.Inhalation);\n\t}\n}\n\nfunction getCost(c) {\n\tif (skill.unit.hasSkill(Skill.Censer_lvl8_1)) {\n\t\treturn skill.unit.getSkillVar(Skill.Censer_lvl8_1, \"n\");\n\t}\n\treturn null;\n}\n\nfunction onPostSkill() {\n\tif (skill.unit.hasSkill(Skill.Censer_lvl8_1) && !isAutoPlayed())\n\t\tallowReplay();\n}",
					"notes": "",
					"done": 1,
					"icon": {
