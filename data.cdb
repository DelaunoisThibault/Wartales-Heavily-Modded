					"script": "function onHit(a) {\n\tif (a.unit == skill.unit && a.skillKind == Skill.LightningSpin){\n\t\ta.target.pushback({ unit : skill.unit }, getPushback(a), a);\n\t}\n}\n\nfunction getPushback( a ) {\n\treturn vars.value1;\n}\n\nfunction onAfterPushback(t){\n\tif (t.unit == skill.unit && t.skillKind == Skill.LightningSpin){\n\t\tif (t.pushbackData.touchObstacle || t.pushbackData.touchUnit){\n\t\t\tt.target.damages(skill, round(t.dmgDealt * vars.value2 / 100));\n\t\t}\n\t}\n}",
