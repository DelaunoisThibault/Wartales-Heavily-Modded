				{
					"id": "Fief_Currency_Power",
					"name": "Pouvoir",
					"desc": "Mesure votre autorité auprès de vos gens ainsi que des interlocuteurs extérieurs. Vous permet de nommer un <b>gouvernement</b> et utiliser des <b>mandats</b>.\n\nObtenu grâce aux gouvernements, lors des audiences et lors de la montée de niveau.",
					"props": {
						"displayIcon": "FiefCurrencyIconPower"
					},
					"done": true,
					"path": "DLC_Fief"
				},
				{
					"id": "Fief_Needs_Food",
					"name": "Nourriture",
					"desc": "Mesure la <b>production</b> de [Fief_Needs_Food] du fief sur la quantité dont votre population a besoin. Le <b>besoin</b> augmente avec le nombre d’habitants et est modifié par la <b>composition</b> de la population.\n\nAugmente le [Fief_Val_Happy] lorsque remplie, sinon le diminue.",
					"props": {
						"displayIcon": "FiefNeedsIconFood"
					},
					"done": true,
					"path": "DLC_Fief"
				},
				{
					"id": "Fief_Needs_Defense",
					"name": "Défense",
					"desc": "Mesure la <b>production</b> de [Fief_Needs_Defense] du fief sur la quantité dont votre population a besoin. Le <b>besoin</b> augmente avec le nombre d’habitants et est modifié par la <b>composition</b> de la population.\n\nAugmente le [Fief_Val_Happy] lorsque remplie, sinon le diminue.",
					"props": {
						"displayIcon": "FiefNeedsIconDefense"
					},
					"done": true,
					"path": "DLC_Fief"
				},
				{
					"id": "Fief_Needs_Hobbies",
					"name": "Marchandises",
					"desc": "Mesure la <b>production</b> de [Fief_Needs_Hobbies] du fief sur la quantité dont votre population a besoin. Le <b>besoin</b> augmente avec le nombre d’habitants et est modifié par la <b>composition</b> de la population.\n\nAugmente le [Fief_Val_Happy] lorsque remplie, sinon le diminue.",
					"props": {
						"displayIcon": "FiefNeedsIconHobbies"
					},
					"done": true,
					"path": "DLC_Fief"
				},
				{
					"id": "Fief_Needs_Education",
					"name": "Connaissance",
					"desc": "Mesure la <b>production</b> de [Fief_Needs_Education] du fief sur la quantité dont votre population a besoin. Le <b>besoin</b> augmente avec le nombre d’habitants et est modifié par la <b>composition</b> de la population.\n\nAugmente le [Fief_Val_Happy] lorsque remplie, sinon le diminue.",
					"props": {
						"displayIcon": "FiefNeedsIconEducation"
					},
					"done": true,
					"path": "DLC_Fief"
				},
				{
					"id": "Fief_Val_Happy",
					"name": "Bonheur",
					"desc": "A chaque repos, détermine la croissance de la [Fief_Val_Pop]. Plus le bonheur est haut, plus cette dernière grandira. S’il est négatif, vous perdrez des habitants.",
					"props": {
						"displayIcon": "FiefValIconHappy"
					},
					"done": true,
					"path": "DLC_Fief"
				},
				{
					"id": "Fief_Val_Pop",
					"name": "Population",
					"desc": "Augmente ou diminue en fonction du [Fief_Val_Happy].\nEst composé de différents <b>types de population</b>. Chacun augmente ou diminue un ou plusieurs <b>besoins</b>.\nAugmentez le <b>maximum </b>de population que le fief peut accueillir en construisant ou améliorant des bâtiments.",
