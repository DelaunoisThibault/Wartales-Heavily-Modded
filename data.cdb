							"personality": "PersCompassionate"
						},
						{
							"introDialog": [
								{
									"text": "[XX] On ne doit pas s'attarder ici, tant pis si les autres ont mal dormi. Plus vite nous serons levés, plus vite nous serons partis de cette forêt."
								}
							],
							"choices": [
