							"nFeverPassive": 2,
							"nFever": 2,
							"nFever2": 2,
							"nInh": 2
						}
					},
					"script": "function onCenserPurgedHit(c) {\n\tif (c.st.target.side == skill.unit.side) return;\n\tvar nbMalus = 0;\n\tif (c.inhalation >= vars.nInh) {\n\t\tfor (st in c.st.target.getAllStatus())\n\t\t\tif (st.isMalus)\n\t\t\t\tnbMalus++;\n\t}\n\tc.st.target.addStatus(Status.Fever, vars.nFever);\n\tc.st.target.addStatus(Status.Fever, nbMalus * vars.nFever2);\n}\n\nfunction onDamageTaken(a) {\n\tif (a.unit.isMelee(a.target))\n\t\ta.unit.addStatus(Status.Fever, a.target.getStatusCount(Status.Inhalation) * vars.nFeverPassive);\n}",
					"notes": "",
