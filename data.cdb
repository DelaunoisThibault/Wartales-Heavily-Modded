					},
					"script": "function onSkillEval(a) {\n\tif( a.unit == skill.unit ) {\n\t\tfor( t in a.getTargets() ) {\n\t\t\tvar p = round(100 * (1-(skill.unit.health / skill.unit.stats.health)));\n\t\t\tt.baseDamageBonus += p;\n\t\t}\n\t}\n}",
