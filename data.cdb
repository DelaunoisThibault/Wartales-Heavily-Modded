							"personality": "PersDefault"
						},
						{
							"introDialog": [
								{
									"text": "[MX]Qu’importe si je mange seul !\nJe ne suis pas devenu mercenaire pour me faire des copains. Ces pouilleux peuvent me détester autant qu’ils veulent, je ne changerai pas."
								},
								{
									"text": "[FX]Qu’importe si je mange seule !\nJe ne suis pas devenue mercenaire pour me faire des copains. Ces pouilleux peuvent me détester autant qu’ils veulent, je ne changerai pas."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[MX]Donner une bonne raison à la troupe de le détester."
										},
