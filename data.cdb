					"script": "function onBeginBattle() {
						vars.foesNbr = 0;
						vars.alliesNbr = 0;
						vars.bonusValue = 0;
						for( u in getAllies(skill.unit) ) {
							vars.alliesNbr++;
						}
						for( u in getFoes(skill.unit) ) {
							vars.foesNbr++;
						}
						var u = getAllies(skill.unit, true);
						var eu = getFoes(skill.unit);
						if( u.length < eu.length ) {
							vars.bonusValue = (vars.foesNbr - vars.alliesNbr) * vars.value1;
							if( vars.bonusValue > vars.value2){
								vars.bonusValue = vars.value2;
							}
						}
					}
