					"script": "function onBeginBattle() {\n\tvars.factionSkillId = getPrisonerSkill(skill.unit, 0);\n}\n\nfunction onSkill() {\n\tplayAnim();\n\tfor (u in getAllies(skill.unit)) {\n\t\tu.addTemporarySkill(vars.factionSkillId, true);\n\t}\n\tvars.turnCounter = 0;\n}\n\nfunction onEndTurn() {\n\tif (vars.turnCounter < 0 || vars.turnCounter > vars.nbTurns) {\n\t\treturn;\n\t}\n\tvars.turnCounter++;\n\tif (vars.turnCounter > vars.nbTurns) {\n\t\tfor (u in getAllies(skill.unit)) {\n\t\t\tu.removeTemporarySkill(vars.factionSkillId);\n\t\t}\n\t}\n}",
