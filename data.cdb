				{
					"id": "PitH1_BossAttack",
					"name": "Conduction",
					"desc": "Inflige [DMG] à la cible. Si l'unité a [PitH1_5_Loaded], consomme le statut et applique [PitH1_5_Conduit] à la cible.",
					"mode": 0,
					"range": {
