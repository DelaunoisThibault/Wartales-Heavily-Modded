					"script": "function onStatus(s) {
						if (s.unit == skill.unit) {
							if(s.kind == Status.Terror) {
								spawnFx();
								s.cancel();
							}
							for( st in skill.unit.getAllStatus() ) {
								if(st.kind == Status.Bleeding) {
									vars.isBleeding = true;
								}
								if(st.kind == Status.Burning ) {
									vars.isBurned = true;
								}
							}
							if( vars.isBleeding && vars.isBurned ) {
								for( st in skill.unit.getAllStatus() ) {
									if(st.kind == Status.Bleeding || st.kind == Status.Burning ) {
										spawnFx();
										st.cancel();
									}
								}
								skill.unit.addStatus(Status.Poison, vars.value1);
								vars.isBleeding = false;
								vars.isBurned = false;
