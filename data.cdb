						"vars": {
							"value1": 20
						},
						"isAttack": true
					},
					"script": "function onEval(t){\n    t.baseDamageBonus += vars.value1 * skill.unit.getStatusCount(Status.Retaliation);\n}\n\nfunction onPostSkill() {\n    var n = skill.unit.getStatusCount(Status.Retaliation);\n    skill.unit.cancelStatus(Status.Retaliation);\n    if (skill.unit.hasStatus(Status.Stampede)) {\n        skill.unit.cancelStatus(Status.Stampede);\n        allowReplay(Skill.FerociousTusks, true);\n        skill.unit.addStatus(Status.Retaliation, n);\n    } else\n        skill.unit.addStatus(Status.Stampede);\n}",
