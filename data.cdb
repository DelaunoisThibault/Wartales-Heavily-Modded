						"specialAnim": "UltiSkill",
						"oncePerFight": true,
						"apCost": 0
					},
					"script": "function onSkill() {\n\tplay();\n\twhile (skill.unit.getStatusCount(Status.Inhalation) < getStatusMaxStacks(Status.Inhalation))\n\t\tskill.unit.castSkill(Skill.Inhalation, {unit : skill.unit}, skill);\n\tskill.unit.addStatus(Status.Censer_lvl12_status);\n}\n\nfunction onSkillPlayed(s) {\n\tif (!skill.unit.hasStatus(Status.Censer_lvl12_status)) return;\n\tif (s.kind == skill.kind) return;\n\tif (s.kind == Skill.Purge) return;\n\tskill.unit.castSkill(Skill.Purge, {unit : skill.unit}, skill);\n}\n\nfunction onEndTurn() {\n\tif (skill.unit.hasStatus(Status.Censer_lvl12_status)) {\n\t\tvar dmg = skill.unit.getPercentHealth(getStatusValue(Status.Censer_lvl12_status));\n\t\tskill.unit.damages(skill, dmg, true);\n\t}\n}",
