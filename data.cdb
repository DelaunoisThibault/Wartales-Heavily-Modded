								"st": "BeastInfluence"
							},
							{
								"st": "Fury"
							}
						],
						"specialAnim": "Roar"
					},
					"script": "function onSkill() {\n\tbeastRoar();\n\tfor (u in getUnits())\n\t\tu.addStatus(isFoe(u) ? Status.Fury : (u.isAnimal && !u.isWerewolf) ? Status.BeastInfluence : Status.Terror);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
						"size": 96,
