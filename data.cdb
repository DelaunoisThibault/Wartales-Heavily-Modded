					"script": "function onEval(a){\n\tvar v = a.target.getPercentHealth(vars.value2);\n\tvar b = getBonus(Bonus.SeafightAbilitiesBonus);\n\tif (b > 0)\n\t\tv = ceil(v * 1 + b / 100);\n\ta.dmg = ceil(v);\n}\n\nfunction onHit(a){\n\ta.target.pushback({unit : skill.unit}, getPushback(a), a);\n}\n\nfunction getPushback(a){\n\treturn vars.value1;\n}",
