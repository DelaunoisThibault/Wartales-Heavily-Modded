					"script": "function onEval(a){\n\tif(vars.nbAttack > 0){\n\t\ta.criticalHitPercent = 100;\n\t}\n}\n\nfunction onBeginAction() {\n\tvars.nbAttack = 0;\n}\n\nfunction onPostSkill() {\n\tvar count = 0;\n\tfor( t in skill.getTargets() ){\n\t\tif(t.armor > 0)\n\t\t\tcount++;\n\t}\n\tif(count >= 2 && vars.nbAttack < vars.value1){\n\t\tvars.nbAttack++;\n\t\tattack();\n\t}\n}",
