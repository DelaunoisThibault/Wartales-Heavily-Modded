					"script": "function onBeginRound() {\n\tfor (a in getAllies(skill.unit)) {\n\t\tif (getDistance(a, skill.unit) < vars.dist) {\n\t\t\ta.addStatus(Status.Fury);\n\t\t\ta.addStatus(Status.Brutality);\n\t\t\ta.addStatus(Status.AnimalMarkedBonus, vars.rage);\n\t\t}\n\t}\n}",
