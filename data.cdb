					},
					"script": "function onBeginBattle(){
						vars.stackCount = 0;
						vars.killedTarget = false;
					}
					function onDeath(a) {
						if( a.unit == skill.unit ) {
							vars.killedTarget = true;
							vars.stackCount++;
							vars.stackBonus = vars.value1 * vars.stackCount;
						}
					}
					function onSkillEval(a) {
						for (t in a.getTargets()){
							if(vars.killedTarget){
								t.baseDamageBonus += vars.stackBonus;
								vars.killedTarget = false;
							}
						}
					}",
