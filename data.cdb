								skill.unit.addStatusPersist(Status.Brutality, skill);
							}
						}
					}
					function onBeginAction() {
						if(skill.unit.armor <= 0) {
							skill.unit.addStatusPersist(Status.Protection, skill);
							if( skill.level == 2 ){
								skill.unit.addStatusPersist(Status.Brutality, skill);
							}
						}
					}
					function onEndTurn() {
						if(skill.unit.armor <= 0) {
							skill.unit.addStatusPersist(Status.Protection, skill);
							if( skill.level == 2 ){
								skill.unit.addStatusPersist(Status.Brutality, skill);
							}
						}
					}
					function onSkillEval(a) {
						for( t in a.getTargets() ) {
							if(skill.unit.armor > 0) {
								if (t.target == skill.unit){
									t.baseDamageBonus -= vars.value1;
								}
								if (a.unit == skill.unit){
									t.baseDamageBonus += vars.value1;
								}
							}
						}
