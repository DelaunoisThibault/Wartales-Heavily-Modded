					"script": "function onSkill() {\n\tcreateAreaEffect(\"Immediate\");\n}\n\nfunction onZoneIn(a) {\n\tif (isFoe(a.target)) return;\n\ta.stopMove(false);\n\tplay();\n\tfor( t in a.getUnitsInRadius(vars.rangeAOE) ) {\n\t\tif (t.hasStatus(Status.Recovery)){\n\t\t\tcontinue;\n\t\t}\n\t\tt.damages(skill, t.getPercentHealth(vars.value1));\n\t}\n\tcreateSkillZone(Skill.FireZone);\n\ta.remove();\n}",
