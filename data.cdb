										]
									},
									"props": {}
								}
							],
							"personality": "PersCompassionate"
						},
						{
							"introDialog": [
								{
									"text": "[XF]::name:: n'est peut-être pas aussi inutile que je le pensais. Je l'ai bien observée ces derniers temps et, finalement, elle ne se bat pas plus mal qu'un autre. Peut-être que je devrais voyager à ses côtés aujourd'hui. Histoire d'apprendre à la connaitre."
								},
								{
									"text": "[XM]::name:: n'est peut-être pas aussi inutile que je le pensais. Je l'ai bien observé ces derniers temps, et finalement, il ne se bat pas plus mal qu'un autre. Peut-être que je devrais voyager à ses côtés aujourd'hui. Histoire d'apprendre à le connaitre."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[MX]Chercher à impressionner ::name:: avec une démonstration de ses talents."
										},
										{
											"text": "[FX]Chercher à impressionner ::name:: avec une démonstration de ses talents."
										}
									],
									"tipText": "Impressionner",
									"cost": {
										"itemCost": [
											{
												"item": "ActionPoint",
												"qty": 1
											}
										]
									},
									"gains": {
										"relation": [
											{
												"qty": 1,
												"target": 0
											}
										]
									},
									"props": {}
								}
							],
							"personality": "PersPragmatic"
						},
						{
							"introDialog": [
								{
									"text": "[XM]Bon sang ! Quelle veillée ! Mes côtes me font encore mal !\nJe n'avais plus rit comme ça depuis des mois. ::name:: est tellement drôle, il faut que je voyage à côté de lui, mes journées passeront beaucoup plus vite."
								},
								{
									"text": "[XF]Bon sang ! Quelle veillée ! Mes côtes me font encore mal !\nJe n'avais plus rit comme ça depuis des mois. ::name:: est tellement drôle, il faut que je voyage à côté de lui, mes journées passeront beaucoup plus vite."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XM]Gagner la sympathie de ::name:: en le distrayant."
