					},
					"script": "function onSkillEval(a) {
						for( t in a.getTargets() ) {
							var nb = 0;
							if( t.target.isEngaged() && t.target.engagedUnit != skill.unit ) {
								nb++;
							}
							if( t.target.hasStatus(Status.Surrounded) ) {
								nb++;
							}
							if( t.backstab ) {
								nb++;
							}
							t.baseDamageBonus += nb*vars.value1;
						}
					}",
