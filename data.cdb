										]
									}
								}
							],
							"personality": "PersDefault"
						},
						{
							"introDialog": [
								{
									"text": "[XX]J’avais jamais rien vu d’aussi dégueulasse qu’un nid de rat. Cette pourriture partout, j’ai l’impression de la sentir encore. Rien que d’y penser, j’ai envie de vomir."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Se soulager pour de bon."
										}
									],
									"tipText": "Vomir",
									"cost": {},
									"props": {},
									"gains": {
										"relation": [
											{
												"qty": -1,
												"target": 2
											}
										]
									}
								}
							],
							"personality": "PersAggressive"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Patauger dans la pourriture pour un si maigre butin ? On a perdu notre temps avec ce nid de rats ! Il y a surement des moyens moins dangereux et surtout moins sales de devenir riches."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Exprimer clairement son avis sur l'incompétence du groupe."
										}
									],
									"tipText": "Insulter",
									"cost": {},
									"props": {},
									"gains": {
										"relation": [
											{
												"qty": -1,
												"target": 2
											}
										],
										"item": [
											{
												"qty": 2,
												"inf": "ActionPoint"
											}
										]
									}
								},
								{
									"texts": [
										{
											"text": "[XX]Mieux préparer le groupe aux nids de rats."
										}
									],
									"tipText": "Organiser",
									"cost": {},
									"props": {},
									"gains": {
										"tiredness": 0.3,
										"status": [
											{
												"inf": "Ratkiller",
												"target": 0
											}
										]
									}
								}
							],
							"personality": "PersPragmatic"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Heureusement qu’on ne nous demande pas de nettoyer des nids de rats tous les jours. Quand je pense qu’après la guerre, c’était le boulot principal des mercenaires, je plains nos prédécesseurs."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Se rassurer en se rappelant que ces missions sont rares."
										}
									],
									"tipText": "Relativiser",
									"cost": {},
									"props": {},
									"gains": {
										"status": [
											{
												"inf": "Nightmare",
												"target": 0
											}
										]
									}
								}
							],
							"personality": "PersOptimist"
						},
						{
							"introDialog": [
								{
									"text": "[XX]S’il te plaît, saint Jéru, garde-moi de retourner là-dedans. Je refuse de revivre ça ! Tous ces rats qui grouillent, la Peste, l’odeur de pourriture… c’était un cauchemar !"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Implorer saint Jéru pour ne plus y retourner."
										}
									],
									"tipText": "Prier",
									"cost": {},
									"props": {},
									"gains": {
