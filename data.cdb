					"script": "function onBeginAction() {\n\tvar nb = 0;\n\tfor( u in getAllies(skill.unit) ) {\n\t\tif( (u.kind == UnitClass.Molerat || u.kind == UnitClass.PitMolerat)  && getDistance(skill.unit, u) <= vars.value2 ) {\n\t\t\tnb++;\n\t\t}\n\t}\n\tvars.stackBonus = vars.value1 * nb;\n}\n\nfunction onSkillEval(a) {\n\tfor( t in a.getTargets() ) {\n\t\tt.baseDamageBonus += vars.stackBonus;\n\t}\n}",
