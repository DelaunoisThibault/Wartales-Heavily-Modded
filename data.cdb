				{
					"id": "AnimalSoothing", 
					"name": "Apaisement animal", 
					"desc": "Permet de capturer n'importe quel animal si sa vie est inférieure à 50%. Sinon, lui inflige la moitié de sa vie actuelle. \nCette action peut être réalisée deux fois sur le même tour. \nNe fonctionne pas sur les élites.", 
					"mode": 5, 
					"range": {
						"radius": 1,
						"allowedTargets": 0,
						"baseDistance": 15
					}, 
					"props": {
						"vars": {
							"secondUse": true
						},
						"specialAnim": "Growl",
						"extraFx": "prefabs/fx/fight/Creatures/DebuffCry_Bear.fx",
						"apCost": 0
					}, 
					"script": "function onBeginBattle(){
						vars.secondUse = true;
					}
					function onBeginRound(){
						vars.secondUse = true;
					}
					function onSkill() {
						for ( t in skill.getTargets() ) {
							var p = 100 * (t.target.health / t.target.stats.health);
							if( t.target != null && t.target.isAnimal && !t.target.hasStatus(Status.Skilled) &&  !t.target.hasStatus(Status.Leader) && !t.target.hasStatus(Status.Gladiator) && !t.target.hasStatus(Status.Champion) ) {
								if( p <= 50 ){
									captureTarget(t);
								} else {
									t.target.damages(skill, t.target.getPercentHealth(50), true);
								}
								if(vars.secondUse){
									allowReplay();
									vars.secondUse = false;
								}
							} else {
								allowReplay();
							}
						}
					}", 
					"notes": "", 
					"done": 2, 
