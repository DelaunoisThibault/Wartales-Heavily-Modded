					},
					"script": "function onSkill() {\n\tskill.unit.addStatus(Status.Repositioning);\n\tskill.unit.reloadMovePoints();\n}\n\nfunction onEndTurn() {\n\tskill.unit.consumeStatus(Status.Repositioning);\n}",
