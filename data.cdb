					"done": 2
				},
				{
					"id": "QuickHeal",
					"name": "Soins rapides",
					"desc": "Soigne un allié [Dying] et lui fait gagner ::value1::% de sa [Health] maximum.\nLui retire toutes les applications de [Poison], [Bleeding] et [Burning].",
					"mode": 0,
					"range": {
						"allowedTargets": 1,
						"flags": 128
					},
					"props": {
						"specialAnim": "Heal",
						"apCost": 0,
						"vars": {
							"value1": 10
						},
						"needDisengaged": true,
						"cursor": "CursorHeal",
						"healPreview": 0.1,
						"useWithoutWeapon": true
					},
					"script": "function onSkill() {\n\tfor( t in skill.getTargets() ) {\n\t\tt.target.heal(skill,  ceil(t.target.stats.health*vars.value1/100) , null);\n\n\t\tvar cancelStatus = false;\n\t\tfor( st in t.target.getAllStatus() ) {\n\t\t\tif( st.kind == Status.Poison || st.kind == Status.Bleeding || st.kind == Status.Burning ) {\n\t\t\t\tst.cancel();\n\t\t\t\tcancelStatus = true;\n\t\t\t}\n\t\t}\n\t\tt.target.heal(skill,  0 , cancelStatus ? true : null);\n\t}\n\tplay();\n}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons96PX.png",
						"size": 96,
						"x": 15,
						"y": 1
					},
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "EncouragingAura",
					"name": "Aura encourageante",
					"desc": "L'unité et tous les alliés dans un rayon de ::value1:: mètres autour de l'unité gagnent gagnent [Protection] pendant ::value2:: rounds  à la fin du tour de l'unité. L'unité gagne aussi cet effet au début de son tour.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 10,
							"value2": 2
						},
						"tooltipStatus": [
							{
								"st": "Protection"
							}
						]
					},
					"script": "function onBeginTurn() {
						skill.unit.addStatus(Status.Protection, vars.value2, true);
					}
					function onEndTurn() {
						skill.unit.addStatus(Status.Protection, vars.value2, true);
						for( u in getAllies(skill.unit) ) {
							if( getDistance(skill.unit, u) <= vars.value1 ) {
								u.addStatus(Status.Protection, vars.value2, true);
							}
						}
					}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons96PX.png",
