					"script": "function onBeginAction() {\n\tfor (a in getUnits())\n\t\tif (a.isAnimal && a != skill.unit) {\n\t\t\tif (a.side == skill.unit.side) {\n\t\t\t\tif (getDistance(a, skill.unit) > vars.range) {\n\t\t\t\t\ta.addStatusPersist(Status.Deflection, skill);\n\t\t\t\t\ta.cancelStatus(Status.Inspiration, skill);\n\t\t\t\t} else {\n\t\t\t\t\ta.addStatusPersist(Status.Inspiration, skill);\n\t\t\t\t\ta.cancelStatus(Status.Deflection, skill);\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\ta.cancelStatus(Status.Inspiration, skill);\n\t\t\t\ta.cancelStatus(Status.Deflection, skill);\n\t\t\t}\n\t\t}\n}",
