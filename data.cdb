				{
					"id": "IR2_BeastSpawn_Renfort",
					"name": "Appel du spectre",
					"desc": "Appelle ::value:: animaux fantômes en renfort.",
					"mode": 4,
					"range": {},
					"props": {
						"vars": {
							"maxRenfortRatio": 1.5,
							"minRenforts": 0,
							"maxRenforts": 0,
							"nbUnitsHardLimit": 100,
							"value": 0,
							"curPatternIdx": 0
						},
						"specialAnim": "Growl",
						"extraFx": "prefabs/fx/fight/BuffCry/BuffCryWhite.fx",
						"hitFx": "prefabs/fx/fight/BuffCry/BuffCryWhite.fx",
						"animFx": "prefabs/fx/fight/BuffCry/BuffCryWhite.fx"
					},
					"script": "function onBeginRound() {\n\tif (vars.minRenforts <= 0) {\n\t\tvars.minRenforts = switch(skill.unit.kind) {\n\t\t\tcase UnitClass.BeastSpawnInfected: 6;\n\t\t\tcase UnitClass.BeastSpawnFamished: 4;\n\t\t\tcase UnitClass.BeastSpawnLeader: 4;\n\t\t\tdefault: getAllies(skill.unit).length;\n\t\t}\n\t}\n\n\tif (vars.maxRenforts <= 0) {\n\t\tvars.maxRenforts = switch(skill.unit.kind) {\n\t\t\tcase UnitClass.BeastSpawnInfected: floor(getPlayerUnits().length * 1.5);\n\t\t\tcase UnitClass.BeastSpawnFamished: floor(getPlayerUnits().length * 1.5);\n\t\t\tcase UnitClass.BeastSpawnLeader: floor(getPlayerUnits().length * 1.5);\n\t\t\tdefault: getAllies(skill.unit).length;\n\t\t}\n\t}\n\n\tif (vars.value < vars.minRenforts) {\n\t\tvars.value = vars.minRenforts;\n\t} else if (vars.value < vars.maxRenforts) {\n\t\tvars.value += 1;\n\t}\n}\n\nfunction onSkill() {\n\tvar types = switch (skill.unit.kind) {\n\tcase UnitClass.BeastSpawnInfected: [\n\t\t{ k : UnitClass.GhostRat, n : 0 }\n\t];\n\tcase UnitClass.BeastSpawnFamished: [\n\t\t{ k : UnitClass.GhostBoar, n : 0 },\n\t\t{ k : UnitClass.GhostWolf, n : 0 },\n\t\t{ k : UnitClass.GhostWolf, n : 0 }\n\t];\n\tcase UnitClass.BeastSpawnLeader: [\n\t\t{ k : UnitClass.GhostWolf, n : 0 },\n\t\t{ k : UnitClass.GhostWolf, n : 0 },\n\t\t{ k : UnitClass.GhostBoar, n : 0 },\n\t\t{ k : UnitClass.GhostBoar, n : 0 },\n\t\t{ k : UnitClass.GhostBear, n : 0 }\n\t];\n\tdefault: [];\n\t}\n\tplayAnim();\n\tfor (_ in 0...vars.value) {\n\t\ttypes[vars.curPatternIdx].n += 1;\n\t\tvars.curPatternIdx = (vars.curPatternIdx + 1) % (types.length);\n\t}\n\tfor (t in types)\n\t\tif (t.n > 0)\n\t\t\tspawnRenfort(t.k, t.n, false);\n}",
					"notes": "Note à la trad : Ref à Professor Layton qui a un jeu qui s'appelle \"l'Appel du Spectre\" ou \"The spectre's call\" en europe",
