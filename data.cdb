					"script": "function onInit() {\n\tvar foes = getFierceAnimalPack();\n\tif( foes == null )\n\t\treturn;\n\tvar jc = ceil(foes.length * (vars.value / 100.0));\n\tfoes = foes.filter(u -> !u.hasStatus(Status.Fierce));\n\tshuffle(foes, randInt(0, 1000));\n\tfor( i in 0...min(foes.length, jc) ) {\n\t\tvar f = foes[i];\n\t\tf.addStatus(Status.Juvenile);\n\t}\n}",
