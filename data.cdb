				{
					"id": "RecoilShot",
					"name": "Tir de recul",
					"desc": "Inflige [DMG] à toutes les cibles dans la zone et les repousse de ::value1:: mètres. Applique [Slowdown] pendant ::value2:: rounds à la première cible touchée.",
					"mode": 5,
