				{
					"id": "S_Captured_5_2",
					"name": "Menottage",
					"desc": "Attire l'unité ciblée en mêlée et lui applique [Handcuffed] pendant ::nbRounds:: round.",
					"mode": 0,
					"range": {
						"baseDistance": 4
					},
					"props": {
						"vars": {
							"value1": 4,
							"nbRounds": 1
						},
						"tooltipStatus": [
							{
								"st": "Handcuffed"
							}
						],
						"apCost": 1,
						"useWithoutWeapon": true,
						"globalEvents": true
					},
					"script": "function getPushback( a ) {\n\treturn -vars.value1;\n}\n\nfunction onSkill() {\n\tfor (t in skill.getTargets()) {\n\t\tt.target.pushback({unit : skill.unit}, getPushback(t), t);\n\t\tt.target.addStatus(Status.Handcuffed, vars.nbRounds);\n\t}\n}\n\nfunction onBeginAction() {\n\tif ( skill.level == 2 ) {\n\t\tvar adjacentExecute = function(u : battle.Unit){\n\t\t\tvar has = u.hasStatusPersist(Status.Vulnerability, skill);\n\t\t\tvar cond = u.hasStatus(Status.Handcuffed) && u.hasStatus(Status.Surrounded);\n\t\t\tif (!has && cond) {\n\t\t\t\tu.addStatusPersist(Status.Vulnerability, skill);\n\t\t\t\tspawnFx(u);\n\t\t\t} else if (has && !cond) {\n\t\t\t\tu.cancelStatus(Status.Vulnerability, skill);\n\t\t\t}\n\t\t}\n\t\tvar nonAdjacentExecute = function(u : battle.Unit) {\n\t\t\tu.cancelStatus(Status.Vulnerability, skill);\n\t\t};\n\n\t\tskill.unit.applyToSkillAdjacents(false, Skill.S_Captured_5_2, 2, adjacentExecute, nonAdjacentExecute);\n\t}\n}",
					"notes": "",
					"done": 1,
					"icon": {
						"file": "ui/Icons/BattleIcons_05_96PX.png",
						"size": 96,
						"x": 3,
						"y": 5
					},
					"iconeDone": true,
					"levels": [
						{
							"props": {
								"tooltipStatus": [
									{
										"st": "Vulnerability"
									}
								]
							},
							"desc": "Attire l'unité ciblée en mêlée et lui applique [Handcuffed] pendant ::nbRounds:: round.\nLes ennemis adjacents encerclés avec le status [Handcuffed] ont [Vulnerability]."
						}
					]
				},
