					"done": 2
				},
				{
					"id": "FirstAid",
					"name": "Premiers soins",
					"desc": "Soigne un allié [Dying] et lui fait gagner ::value1::% de sa [Health] maximum.\nLui retire toutes les applications de [Poison], [Bleeding] et [Burning].",
					"mode": 0,
					"range": {
						"allowedTargets": 1,
						"flags": 32
					},
					"props": {
						"specialAnim": "Heal",
						"apCost": 0,
						"vars": {
							"value1": 25,
							"checkValue1": 25,
							"healValue": 25
						},
						"needDisengaged": true,
						"cursor": "CursorHeal",
						"useWithoutWeapon": true
					},
					"script": "function onBeginBattle(){
						if( skill.unit.hasTrait(Trait.RogueApothecary) ){
							vars.value1 *= 2;
						} else {
							vars.value1 = vars.checkValue1;
						}
					}
					function onSkill() {
						play();
						for( t in skill.getTargets() ) {
							var cancelStatus = false;
							for( st in t.target.getAllStatus() ) {
								if( st.kind == Status.Poison || st.kind == Status.Bleeding || st.kind == Status.Burning ) {
									st.cancel();
									cancelStatus = true;
								}
							}
							t.target.heal(skill, t.target.getPercentHealth(vars.healValue), cancelStatus ? true : null);
						}
					}
					function onBeginAction() {
						if( skill.unit.hasTrait(Trait.RogueApothecary) ) {
							vars.healValue = round( (getHealPercent() * 100.0)* 2 );
						} else {
							vars.healValue = round(getHealPercent() * 100.0);
						}
					}
					function getHealPercent() {
						var hp = vars.value1 / 100;
						return hp;
					}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons96PX.png",
						"size": 96,
						"x": 15,
						"y": 1
					},
					"levels": [
