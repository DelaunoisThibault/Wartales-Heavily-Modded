					},
					"script": "function onSkillEval(a) {\n\tif (skill.unit == a.unit){\n\t\tfor (t in a.getTargets()) {\n\t\t\tt.criticalHitPercent = 100;\n\t\t}\n\t}\n}\n\nfunction onDamageDealt(a){\n\tif (a.unit == skill.unit){\n\t\tskill.unit.cancelStatus(Status.Invisible);\n\t}\n}\n\nfunction onBeginAction(){\n\tif (!isPlaying(skill.unit)){\n\t\tfor (u in getFoes(skill.unit)){\n\t\t\tif (u.isMelee(skill.unit)){\n\t\t\t\tskill.unit.cancelStatus(Status.Invisible);\n\t\t\t}\n\t\t}\n\t}\n}",
