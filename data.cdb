							}
						],
						"apCost": 2
					},
					"script": "function onEval(a) {\n    a.attackCount = vars.value1;\n}\n\nfunction onHit(a) {\n    if (!a.isLastAttack()) return;\n    if (canUseAttackStance())\n\t    a.target.pushback({ unit : skill.unit }, getPushback(a), a);\n    if (a.isInitiative())\n        a.target.addStatus(Status.Slowdown, vars.value3);\n    else {\n        var sts = [];\n        for (st in a.target.getAllStatus())\n            if (st.isBonus)\n                sts.push(st);\n        for (i in 0...vars.value4) {\n            if (sts.length == 0) return;\n            var st = sts[randInt(0, sts.length - 1)];\n            a.target.cancelStatus(st.kind);\n            sts.remove(st);\n        }\n    }\n}\n\nfunction onPostSkill() {\n    if (canUseDefenseStance())\n        skill.unit.addStatusPersist(Status.Deflection, skill);\n}\n\nfunction getPushback( a ) {\n\tif (canUseAttackStance())\n\t\treturn vars.value2;\n\treturn 0;\n}",
