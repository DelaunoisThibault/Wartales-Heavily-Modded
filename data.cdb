					"script": "function onSkill() {\n\tfor (u in getAllUnits()) {\n\t\tif (getDistance(u, skill.target) <= vars.meters){\n\t\t\tu.addStatus(Status.Poison, skill.unit.getSkillVar(Skill.PathogenicPreparation, \"poisonvalue\"));\n\t\t\tu.addStatus(Status.Corrosion, skill.unit.getSkillVar(Skill.PathogenicPreparation, \"corrosionvalue\"));\n\t\t\tu.addStatus(Status.Bleeding);\n\t\t\tu.addStatus(Status.Burning);\n\t\t}\n\t}\n}",
