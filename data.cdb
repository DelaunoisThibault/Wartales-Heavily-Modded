				{
					"id": "IndividualChallenge",
					"name": "Défi personnel",
					"desc": "Chaque round, cette unité doit attaquer au moins une fois dans une posture donnée. Si elle réussit, elle effectue une attaque d'opportunité.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 4
						}
					},
					"script": "var previousRound = false;\n\nfunction onBeginRound() {\n\tcancelChallenge();\n\tif (proba(50)) {\n\t\tskill.unit.addStatus(Status.AttackStanceChallenge);\n\t} else {\n\t\tskill.unit.addStatus(Status.DefenseStanceChallenge);\n\t}\n}\n\nfunction onSkillPlayed(s) {\n\tif (s.isStanceAttack()) {\n\t\tif (skill.unit.hasStatus(Status.AttackStanceChallenge) && skill.unit.hasStatus(Status.AttackStance) || skill.unit.hasStatus(Status.DefenseStanceChallenge) && skill.unit.hasStatus(Status.DefenseStance)) {\n\t\t\tvar target = skill.unit.engagedUnit;\n\t\t\tif (target == null) {\n\t\t\t\tfor (u in getFoes(skill.unit)) {\n\t\t\t\t\tif (u.isMelee(skill.unit)) {\n\t\t\t\t\t\ttarget = u;\n\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (target != null) {\n\t\t\t\tskill.unit.opportunityAttack(target, skill);\n\t\t\t\tcancelChallenge();\n\t\t\t\tif (skill.level == 2 && previousRound) {\n\t\t\t\t\tskill.unit.addStatus(Status.AnimalMarkedBonus, vars.value1);\n\t\t\t\t}\n\t\t\t}\n\t\t\tpreviousRound = true;\n\t\t}\n\t}\n}\n\nfunction onEndRound() {\n\tif (skill.unit.hasStatus(Status.AttackStanceChallenge) || skill.unit.hasStatus(Status.AttackStanceChallenge)) {\n\t\tpreviousRound = false;\n\t\tcancelChallenge();\n\t}\n}\n\nfunction cancelChallenge() {\n\tskill.unit.cancelStatus(Status.AttackStanceChallenge);\n\tskill.unit.cancelStatus(Status.DefenseStanceChallenge);\n}",
					"notes": "",
