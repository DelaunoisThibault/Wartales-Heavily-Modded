					"script": "function onEval(a) {\n\ta.attackCount = vars.value;\n}\n\nfunction onHit(a) {\n\tif (a.isLastAttack()) {\n\t\ta.target.pushback({ unit : skill.unit }, vars.value2, a);\n\t}\n}\n\nfunction onAfterPushback(t) {\n\tif (t.pushbackData.distance > 0) {\n\t\tvars.pushed = true;\n\t}\n}\n\nfunction onPostSkill() {\n\tif (!vars.pushed) {\n\t\tfor (t in skill.getTargets()) {\n\t\t\tskill.unit.castSkill(Skill.CU7FistsFollowUp, {unit : t.target}, skill);\n\t\t}\n\t} else {\n\t\tvars.pushed = false;\n\t}\n}",
