								"st": "PitS1_5_RatPlagueSong"
							},
							{
								"st": "PitS1_5_PiperMark"
							}
						],
						"isAttack": true
					},
					"script": "function onHit(s) {\n    var target = s.target;\n\n    // Pick new marked unit\n    if (target.hasStatus(Status.PitS1_5_PiperMark)) {\n        target.consumeStatus(Status.PitS1_5_PiperMark, 1);\n        var units = getUnits().filter( u -> u.side == target.side && u != target && !u.hasStatus(Status.PitS1_5_PiperMark));\n        var newTarget = units[randInt(0, units.length - 1)];\n        if (newTarget != null) newTarget.addStatus(Status.PitS1_5_PiperMark, 1);\n    }\n\n    if (!isPlayer(target))\n        return;\n    // cycle status : rat > plague > ratPlague > none > rat > ...\n    if (target.hasStatus(Status.PitS1_5_RatSong)) {\n        target.consumeStatus(Status.PitS1_5_RatSong, 1);\n        target.addStatus(Status.PitS1_5_PlagueSong, 1);\n    } else if (target.hasStatus(Status.PitS1_5_PlagueSong)) {\n        target.consumeStatus(Status.PitS1_5_PlagueSong, 1);\n        target.addStatus(Status.PitS1_5_RatPlagueSong, 1);\n    } else if (target.hasStatus(Status.PitS1_5_RatPlagueSong)) {\n        target.consumeStatus(Status.PitS1_5_RatPlagueSong, 1);\n    } else {\n        target.addStatus(Status.PitS1_5_RatSong, 1);\n    }\n}",
					"notes": "",
					"done": 0,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_03_96PX.png",
						"size": 96,
						"x": 4,
						"y": 9
					},
					"minDmg": 10
				},
