				},
				{
					"id": "OdorousPowder",
					"name": "Zone odorante",
					"desc": "Tous les animaux non-engagés dans la zone se déplacent vers le point d'impact.",
					"mode": 5,
					"range": {
						"type": 0,
						"radius": 6,
						"baseDistance": 6,
						"allowedTargets": 4,
						"flags": 16
					},
					"props": {
						"apCost": 0,
						"specialAnim": "ThrowLeftGrenade",
						"itemCost": {
							"item": "OdorousPowder",
							"qty": 1
						},
						"needDisengaged": true,
						"vars": {
							"value1": 5
						},
						"flags": 96,
						"throwFx": "prefabs/fx/fight/Explosion/OdorusPowder/OdorousPowderThrowTrail.fx",
						"hitFx": "prefabs/fx/fight/Explosion/OdorusPowder/OdorusPowder.fx"
					},
					"script": "function onEval(a) {\n\tif(!a.target.isAnimal) {\n\t\ta.dontShowPreview();\n\t}\n}\n\nfunction onPostSkill() {\n\tvar targets = [];\n\tfor (t in skill.getTargets()) {\n\t\tvar dist = t.target.getPosition().distanceSq(skill.getPosition());\n\t\ttargets.push({target : t.target, dist : dist});\n\t}\n\ttargets.sort(function(a,b) {\n\t\tif (a.dist > b.dist) return 1;\n\t\tif (a.dist < b.dist) return -1;\n\t\treturn 0;\n\t});\n\tfor(t in targets) {\n\t\tif(t.target.isAnimal && !t.target.isEngaged() && t.target.kind != UnitClass.Matriarch) {\n\t\t\tt.target.moveTo(getPushbackOrigin(t));\n\t\t}\n\t}\n}\n\nfunction getPushback( a ) {\n\tif( a != null && a.target.isAnimal && !a.target.isEngaged() && a.target.kind != UnitClass.Matriarch ) {\n\t\tvar skillPos = a.getSkillPosition();\n\t\tvar uPos = a.target.getPosition();\n\t\treturn 0 - distance(skillPos.x, skillPos.y, uPos.x, uPos.y);\n\t}\n\treturn 0;\n}\n\nfunction getPushbackOrigin(a) {\n\treturn { skill : skill };\n}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons96PX.png",
						"size": 96,
