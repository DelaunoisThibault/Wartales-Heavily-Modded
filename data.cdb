					"script": "function onDamageTaken(s) {\n    if ((s.target.hasStatus(Status.PitS1_5_RatSong) && s.unit.isRat()) ||\n        (s.target.hasStatus(Status.PitS1_5_PlagueSong) && s.unit.isPlagueRidden()) ||\n        (s.target.hasStatus(Status.PitS1_5_RatPlagueSong) && (s.unit.isRat() || s.unit.isPlagueRidden())))\n        flee(false);\n}",
