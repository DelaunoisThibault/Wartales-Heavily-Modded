						{
							"introDialog": [
								{
									"text": "[MX]Jamais je ne me ferai arrêter pour vol, je suis bien trop discret. Avec moi, nous ne courons aucun risque car non seulement je suis doué, mais je sais parfaitement où m’arrêter."
								},
								{
									"text": "[FX]Jamais je ne me ferai arrêter pour vol, je suis bien trop discrète. Avec moi, nous ne courons aucun risque car non seulement je suis douée, mais je sais parfaitement où m’arrêter."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[MX]Se vanter de sa réussite et de son talent auprès du groupe."
										},
										{
