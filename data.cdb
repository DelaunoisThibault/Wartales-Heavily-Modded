				{
					"id": "AssassinCapture", 
					"name": "Capture d'assassin", 
					"desc": "Permet de capturer n'importe quelle cible humanoide à proximité si sa santé est inférieure à 50%. Sinon, réduit sa vie de moitié. \nCette action peut être réalisée deux fois sur le même tour. \nNe fonctionne pas sur les élites.", 
					"mode": 5, 
					"range": {
						"type": 0,
						"radius": 2,
						"allowedTargets": 0,
						"baseDistance": 0
					}, 
					"props": {
						"usableWhenDying": true,
						"vars": {
							"secondUse": false
						},
						"specialAnim": "AttackSpin",
						"apCost": 0,
						"useWithoutWeapon": true
					}, 
					"script": "function onBeginBattle(){
						vars.secondUse = true;
					}
					function onBeginRound(){
						vars.secondUse = true;
					}
					function onSkill() {
						for ( t in skill.getTargets() ) {
							if( t.target != null && !t.target.isAnimal && !t.target.hasStatus(Status.NotCapturableUnit) && !t.target.hasStatus(Status.Skilled) &&  !t.target.hasStatus(Status.Leader) && !t.target.hasStatus(Status.Gladiator) && !t.target.hasStatus(Status.Champion) ) {
								var p = 100 * (t.target.health / t.target.stats.health);
								if( p <= 50){
									captureTarget(t);
								} else {
									t.target.damages(skill, t.target.getPercentHealth(50), true);
								}
								if(vars.secondUse){
									allowReplay();
									vars.secondUse = false;
								}
							} else {
								allowReplay();
							}
						}
					}", 
