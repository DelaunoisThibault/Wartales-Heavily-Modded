						},
						"hitFx": "prefabs/fx/fight/AttackBellshot/FlamingArrows_Angle.fx",
						"zRotation": -90,
						"flags": 2
					},
					"script": "function onSkill() {\n\tattack();\n\tcreateSkillZone(Skill.FireZone);\n}\n\nfunction onEval(s) {\n\ts.dmg = s.forcedDmg = s.target.getPercentHealth(vars.value1);\n}",
					"notes": "",
					"done": 0,
					"iconeDone": true
				},
				{
