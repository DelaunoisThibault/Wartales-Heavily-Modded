										"item": [
											{
												"inf": "Happiness",
												"qty": 4
											}
										]
									},
									"props": {}
								},
								{
									"texts": [
										{
											"text": "[XX]Rendre grâce aux dieux de l'Ihraa pour cette aventure."
										}
									],
									"tipText": "Prier",
