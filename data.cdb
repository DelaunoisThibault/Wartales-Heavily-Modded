					"props": {
						"tooltipStatus": [
							{
								"st": "Imbalance"
							},
							{
								"st": "PitG1_4_FragileRest"
							}
						],
						"globalEvents": true,
						"vars": {
							"value1": 50
						}
					},
					"script": "function onDamageTaken(a) {\n\tif (isGameMaster(a.unit)) return;\n\tif (!a.target.hasStatus(Status.Imbalance)) {\n\t\ta.target.addStatus(Status.Imbalance);\n\t\ta.target.addStatus(Status.PitG1_4_FragileRest);\n\t}\n\telse {\n\t\ta.target.cancelStatus(Status.Imbalance);\n\t}\n}\n\nfunction onAfterPushback(a){\nif (a.target.hasStatus(Status.PitG1_4_FragileRest)) {\n\ta.target.cancelStatus(Status.PitG1_4_FragileRest);\n}\n}",
					"notes": "",
					"done": 0,
					"iconeDone": true,
