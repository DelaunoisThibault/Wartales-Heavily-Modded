					"script": "function onDeath(a) {\n\tvars.n++;\n}\n\nfunction onEndRound() {\n\tspawnRenfort(UnitClass.Spectator, vars.n * (skill.unit.hasStatus(Status.Discredit) ? vars.val2 : vars.val), false);\n}\n\nfunction onBeginRound() {\n\tif (vars.val2 == 0)\n\t\tvars.val2 = round(vars.val - getStatusValue(Status.Discredit));\n\tif (getRound() == 1) {\n\t\tspawnRenfort(UnitClass.Spectator, vars.startRenforts, false, true);\n\t}\n}",
