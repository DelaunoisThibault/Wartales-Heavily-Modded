					"desc": "Chaque fois qu'un allié adjacent est attaqué en mêlée par un ennemi, inflige [DMG] à cet ennemi.",
					"mode": 2,
					"range": {},
					"props": {
						"dmgAttribute": 0,
						"globalEvents": true
					},
					"script": "function onSkillPlayed(s) {\n\tif( s.unit.side != skill.unit.side ) {\n\t\tfor( u in getAllies(skill.unit) ) {\n\t\t\tif( u.isMelee(skill.unit) && u.isMelee(s.unit) && !skill.unit.isEngaged() ) {\n\t\t\t\tfor( t in s.getTargets() ) {\n\t\t\t\t\tif( t.target == u && t.dmg > 0 ) {\n\t\t\t\t\t\tspawnFx();\n\t\t\t\t\t\tattackTarget(s.unit);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}",
