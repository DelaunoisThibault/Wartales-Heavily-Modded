						"specialAnim": "Throw"
					},
					"script": "function onSkill() {\n\tplayAttack();\n\tpurgeCenserTargets(skill.getTargets());\n}\n\nfunction onEndTurn() {\n\tallowReplay(Skill.Inhalation);\n}",
