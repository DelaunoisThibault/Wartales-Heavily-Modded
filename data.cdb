						"isAttack": true
					},
					"script": "function onSkill() {
						if( skill.target.side != skill.unit.side ) {
							attack();
							skill.target.addStatus(Status.Vulnerability);
						} else {
							play();
							skill.target.addStatus(Status.Fury);
							var hp : Float = getHealPercent();
							skill.target.heal(skill, ceil(skill.target.stats.health * hp) , null);
						}
					}
					function getHealPercent() {
						 return 0.25; 
					}",
