					"script": "function onHit(a) {\n\tif (a.isOpportunityAttack()) {\n\t\tif (a.target.armor <= 0) {\n\t\t\ta.target.addStatus(Status.Bleeding);\n\t\t} else {\n\t\t\ta.target.addStatus(Status.Corrosion, vars.value1);\n\t\t}\n\t}\n}\n\nfunction onSkillEval(a) {\n\tif (skill.level == 2) {\n\t\tfor( t in a.getTargets() ) {\n\t\t\tif( t.target.armor > 0 && t.target.hasStatus(Status.Corrosion)) {\n\t\t\t\tt.baseDamageBonus += vars.value2;\n\t\t\t}\n\t\t}\n\t}\n}",
