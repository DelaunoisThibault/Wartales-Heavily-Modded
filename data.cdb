					],
					"iconeDone": true,
					"done": 1
				},
				{
					"id": "CountKills",
					"name": "Nombre d'éliminations comptabilisés (et autre)",
					"desc": "Compte le nombre d'unités tuées. Ainsi que d'autres choses. \nNombre d'éliminations actuelles : ::currentStack::. \nNombre de coups portés : ::landedHitStack::. \nNombre de coups reçus : ::receivedHitStack::. \nNombre de coups critiques reçus : ::critReceivedStack::. \nNombre de coups critiques réalisés : ::critDoneStack::. \nNombre de nounours massacrés : ::bearsKilledStack::. ",
					"mode": 2,
					"range": {},
					"props": {
						"hidden": true,
						"globalEvents": true,
						"vars": {
							"currentStack": 0,
							"landedHitStack": 0,
							"receivedHitStack": 0,
							"critReceivedStack": 0,
							"critDoneStack": 0,
							"bearsKilledStack": 0
						}
					},
					"script": "function onBeginBattle() {
						vars.currentStack = skill.unit.getCounter(Counter.EnemiesKilled);
						if( skill.unit.stats.strength > skill.unit.stats.dexterity ){
							vars.landedHitStack = skill.unit.getCounter(Counter.AttackCounterForStrongTrait);
						} else {
							vars.landedHitStack = skill.unit.getCounter(Counter.AttackCounterForNimbleTrait);
						}
						vars.receivedHitStack = skill.unit.getCounter(Counter.HitReceivedCounterForRobustTrait);
						vars.critReceivedStack = skill.unit.getCounter(Counter.CritHitTaken);
						vars.critDoneStack = skill.unit.getCounter(Counter.CritCounterForBloodthirstyTrait);
						vars.bearsKilledStack = skill.unit.getCounter(Counter.BearsKilled);
					} 
					function onBeginAction() {
						vars.currentStack = skill.unit.getCounter(Counter.EnemiesKilled);
						if( skill.unit.stats.strength > skill.unit.stats.dexterity ){
							vars.landedHitStack = skill.unit.getCounter(Counter.AttackCounterForStrongTrait);
						} else {
							vars.landedHitStack = skill.unit.getCounter(Counter.AttackCounterForNimbleTrait);
						}
						vars.receivedHitStack = skill.unit.getCounter(Counter.HitReceivedCounterForRobustTrait);
						vars.critReceivedStack = skill.unit.getCounter(Counter.CritHitTaken);
						vars.critDoneStack = skill.unit.getCounter(Counter.CritCounterForBloodthirstyTrait);
						vars.bearsKilledStack = skill.unit.getCounter(Counter.BearsKilled);
					}
					function onEndTurn() {
						vars.currentStack = skill.unit.getCounter(Counter.EnemiesKilled);
						if( skill.unit.stats.strength > skill.unit.stats.dexterity ){
							vars.landedHitStack = skill.unit.getCounter(Counter.AttackCounterForStrongTrait);
						} else {
							vars.landedHitStack = skill.unit.getCounter(Counter.AttackCounterForNimbleTrait);
						}
						vars.receivedHitStack = skill.unit.getCounter(Counter.HitReceivedCounterForRobustTrait);
						vars.critReceivedStack = skill.unit.getCounter(Counter.CritHitTaken);
						vars.critDoneStack = skill.unit.getCounter(Counter.CritCounterForBloodthirstyTrait);
						vars.bearsKilledStack = skill.unit.getCounter(Counter.BearsKilled);
					}
					function onDeath(a) {
						if( a.unit == skill.unit ) {
							skill.unit.incCounter(Counter.EnemiesKilled, 1);
							vars.currentStack = skill.unit.getCounter(Counter.EnemiesKilled);
							if( (a.target.kind == UnitClass.Bear || a.target.kind == UnitClass.SteelBear || a.target.kind == UnitClass.SkilledBear || a.target.kind == UnitClass.GodLikeBear || a.target.kind == UnitClass.WhiteBear || a.target.kind == UnitClass.SteelWhiteBear || a.target.kind == UnitClass.SkilledWhiteBear || a.target.kind == UnitClass.GodLikeWhiteBear || a.target.kind == UnitClass.GhostBear || a.target.kind == UnitClass.BearFierce) && !skill.unit.hasTrait(Trait.GreatVitality) ){
								skill.unit.incCounter(Counter.BearsKilled, 1);
								vars.bearsKilledStack = skill.unit.getCounter(Counter.BearsKilled);
							}
						}
					}
					function onDamageDealt(a) {
						if(a.target.side != skill.unit.side && a.unit == skill.unit){	
							if( skill.unit.stats.strength > skill.unit.stats.dexterity ){
								skill.unit.incCounter(Counter.AttackCounterForStrongTrait, 1);
							} else if( skill.unit.stats.strength < skill.unit.stats.dexterity ){
								skill.unit.incCounter(Counter.AttackCounterForNimbleTrait, 1);
							} else {
								skill.unit.incCounter(Counter.AttackCounterForStrongTrait, 1);
								skill.unit.incCounter(Counter.AttackCounterForNimbleTrait, 1);
							}
							if( !skill.unit.hasTrait(Trait.HeavyBeing) && !skill.unit.hasTrait(Trait.FocusedFighter) && !skill.unit.hasTrait(Trait.IronBlood) ){
								skill.unit.incCounter(Counter.AttackCounterForAggressiveFighterTrait, 1);
							}
							if( !skill.unit.hasTrait(Trait.HeavyBeing) && !skill.unit.hasTrait(Trait.AggressiveFighter) ){
								skill.unit.incCounter(Counter.AttackCounterForFocusedFighterTrait, 1);
							}
							if( a.isCritical ) {
								skill.unit.incCounter(Counter.CritCounterForBloodthirstyTrait, 1);
								vars.critDoneStack = skill.unit.getCounter(Counter.CritCounterForBloodthirstyTrait);
							}
						}
						if( skill.unit.stats.strength > skill.unit.stats.dexterity ){
							vars.landedHitStack = skill.unit.getCounter(Counter.AttackCounterForStrongTrait);
						} else {
							vars.landedHitStack = skill.unit.getCounter(Counter.AttackCounterForNimbleTrait);
						}
					}
					function onDamageTaken(s) {
						if ( s.target == skill.unit ) {
							skill.unit.incCounter(Counter.HitReceivedCounterForRobustTrait, 1);
							if( !skill.unit.hasTrait(Trait.AggressiveFighter) && !skill.unit.hasTrait(Trait.FocusedFighter) && !skill.unit.hasTrait(Trait.IronBlood) ){
								skill.unit.incCounter(Counter.HitReceivedCounterForHeavyBeingTrait, 1);
							}
							if( !skill.unit.hasTrait(Trait.HeavyBeing) && !skill.unit.hasTrait(Trait.AggressiveFighter) ){
								skill.unit.incCounter(Counter.HitReceivedCounterForIronBloodTrait, 1);
							}
							if( s.isCritical) {
								if( !skill.unit.hasTrait(Trait.HardSkin) ){
									skill.unit.incCounter(Counter.CritHitTakenCounterForMadeOfSteelTrait, 1);
								}
								vars.critReceivedStack = skill.unit.getCounter(Counter.CritHitTaken);
							}
							vars.receivedHitStack = skill.unit.getCounter(Counter.HitReceivedCounterForRobustTrait);
						}
					}",
