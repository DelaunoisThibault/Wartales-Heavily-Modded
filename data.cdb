					"script": "function onSkillEval(a) {\n\tif (skill.level == 2)\n\t\tfor (t in a.getTargets())\n\t\t\tif (!t.target.isMelee(t.unit))\n\t\t\t\tt.criticalHitPercent += vars.value2;\n}\n\nfunction onDamageDealt(t) {\n\tif( t.dmg > 0 && !t.wasMelee ) {\n\t\tif( t.target.addStatus(Status.Destabilization, vars.value1, true) ) {\n\t\t\tspawnFx();\n\t\t}\n\t}\n}",
