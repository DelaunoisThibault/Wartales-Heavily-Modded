						if( !skill.unit.hasStatus(Status.Fury) ) {
							skill.unit.damages(skill, skill.unit.getPercentHealth(vars.value1), true);
							skill.unit.addStatus(Status.Fury);
							b = true;
						}
						skill.unit.addStatus(Status.AnimalMarkedBonus, vars.value2);
						b = true;
