				{
					"id": "Champion21Mecanism",
					"name": "Mécanisme à balancier",
					"desc": "Chaque fois que cette unité tire sur une unité à ::value1:: mètres de distance ou plus, gagne ::value2:: [Aim] pour chaque mètre de distance au-delà de ::value1::.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 8,
							"value2": 1,
							"todo": false,
							"done": false
						},
						"playerDesc": "Chaque round, la première fois que cette unité tire sur une unité à ::value1::m ou plus, [Reload] et gagne ::value2:: [Aim] pour chaque mètre de distance au-delà.",
						"tooltipStatus": [
							{
								"st": "Reload"
							},
							{
								"st": "Aim"
							}
						]
					},
					"script": "function onDamageDealt(s) {\n\tvar d = getDistance(s.unit, s.target);\n\tif (d < vars.value1 || s.castOrigin != null) return;\n\tvar n = floor(d - vars.value1);\n\tif (!isPlayer(s.unit)) {\n\t\tif (n > 0) skill.unit.addStatus(Status.Aim, n * vars.value2);\n\t} else if (!vars.todo) {\n\t\tvars.todo = true;\n\t\tif (n > 0) skill.unit.addStatus(Status.Aim, n * vars.value2);\n\t}\n}\n\nfunction onSkillPlayed(s) {\n\tif (vars.todo && !vars.done) {\n\t\tskill.unit.reloadCrossbow(skill);\n\t\tvars.done = true;\n\t}\n}\n\nfunction onEndRound() {\n\tvars.done = false;\n\tvars.todo = false;\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_04_96PX.png",
