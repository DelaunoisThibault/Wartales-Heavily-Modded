					"script": "function onDamageTaken(a) {\n\tif (a.target.side != a.unit.side) {\n\t\tgainsSanity(-vars.sanity);\n\t\tskill.unit.cancelStatus(Status.A2SanityStatus01);\n\t}\n}\n\nfunction onEndBattle() {\n\tgainsSanity(vars.sanity);\n}",
