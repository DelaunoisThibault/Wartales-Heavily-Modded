				{
					"id": "Inhalation",
					"name": "Inhaler",
					"desc": "Gagne ::nb:: [Inhalation].\n\nCoûte <ap>::increasedCost::</ap> de plus pour chaque utilisation après la première du tour.",
					"mode": 4,
					"range": {},
					"props": {
						"tooltipStatus": [
							{
								"st": "Inhalation"
							}
						],
						"vars": {
							"allowed": false,
							"nb": 1,
							"increasedCost": 1,
							"used": 0
						},
						"apCost": 0,
						"specialAnim": "Inhale"
					},
					"script": "function onBeginAction() {\n\tvars.allowed = skill.unit.getStatusCount(Status.Inhalation) < getStatusMaxStacks(Status.Inhalation);\n}\n\nfunction onSkill() {\n\tplayAnim();\n\tskill.unit.playFx(\"prefabs/fx/fight/Thaumaturge/Inhale_IB.fx\");\n\tskill.unit.addStatus(Status.Inhalation);\n\tinhaleCenser(skill.unit);\n}\n\nfunction onPostSkill() {\n\tif (!isAutoPlayed())\n\t\tallowReplay();\n\tvars.used++;\n}\n\nfunction onBeginRound() {\n\tvars.used = 0;\n}\n\nfunction getCost(c) {\n\treturn c + vars.used * vars.increasedCost;\n}\n\nfunction onEndTurn() {\n\tvar dmg = skill.unit.getPercentHealth(skill.unit.getStatusCount(Status.Inhalation) * getStatusValue(Status.Inhalation));\n\tskill.unit.damages(skill, dmg, true);\n}",
					"notes": "",
					"done": 1,
					"icon": {
						"file": "ui/Icons/BattleIcons_04_96PX.png",
						"size": 96,
						"x": 13,
