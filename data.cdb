						"dmgAttribute": 0,
						"flags": 0,
						"flagsAI": 0
					},
					"script": "function onDamage(a) {\n\tif( skill.unit.hasStatus(Status.PitH1_5_Loaded) ){\n\t\ta.target.addStatus(Status.PitH1_5_Conduit);\n\t}\n}\n\nfunction getAITargetScore(a) {\n\tif ( a.unit.hasStatus(Status.PitH1_5_Loaded) && a.target.hasStatus(Status.PitH1_5_Conduit))\n\t\treturn -100;\n\treturn 0;\n}",
					"notes": "",
