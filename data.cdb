				},
				{
					"id": "PitS1_2_PlaguedSpawn",
					"name": "La Horde",
					"desc": "À la fin de chaque round, si moins de ::nbToKill:: unités ont été mises hors-combat à ce round, alors ::nbToSpawn:: pestiférés rejoignent le combat.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"nbToKill": 3,
							"nbToSpawn": 2,
							"nbKilled": 0
						}
					},
					"script": "function onEndRound(){\n\tvar n = getNbKilledThisRound();\n\tif (n < vars.nbToKill)\n\t\tspawnRenfort(UnitClass.Plagueridden, vars.nbToSpawn, /* neutral= */true);\n\tvars.nbKilled += n;\n}\n\nfunction getNbKilledThisRound() {\n\tvar n = -vars.nbKilled;\n\tfor (u in getAllUnits())\n\t\tif (!u.isAlive())\n\t\t\tn++;\n\treturn n;\n}",
					"notes": "",
					"done": 0,
