									},
									"props": {}
								}
							],
							"personality": "PersAggressive"
						},
						{
							"introDialog": [
								{
									"text": "[XM]Au début, je pensais que ::name:: était juste un bourrin de plus dans cette troupe, mais en fait, il est plus subtile qu'il en a l'air. Peut-être qu'on pourrait finir par s'entendre ?"
								},
								{
									"text": "[XF]Au début, je pensais que ::name:: était juste une brute de plus dans cette troupe, mais en fait, elle est plus subtile qu'elle en a l'air. Peut-être qu'on pourrait finir par s'entendre ?"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Partager une discussion profonde avec ::name::."
