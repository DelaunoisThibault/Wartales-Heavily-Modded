				{
					"id": "BloodPactShot",
					"name": "Tir du pacte sanglant",
					"desc": "Inflige [DMG] à la cible. \nSi la [Health] de l'unité est supérieure à ::value1::% de sa [Health] maximum, consomme ::value2::% de sa [Health] pour augmenter les dégâts de ::value3::%. \n\n[DeadlyBlow] : Cette unité se soigne de ::value4::% de sa [Health].",
					"mode": 1,
					"range": {
						"baseDistance": 13
					},
					"props": {
						"apCost": 3,
						"dmgAttribute": 1,
						"vars": {
							"value1": 25,
							"value2": 10,
							"value3": 100,
							"value4": 20
						},
						"needDisengaged": true,
						"isAttack": true,
						"extraFx": "prefabs/fx/fight/Attack/Attack_B.fx"
					},
					"script": "function onEval(a) {
						var p = 100 * (skill.unit.health / skill.unit.stats.health);
						if( p > vars.value1 ) {
							a.baseDamageBonus += vars.value3;
						}
					}
					function onSkill() {
						var p = 100 * (skill.unit.health / skill.unit.stats.health);
						if( p > vars.value1 ) {
							skill.unit.damages(skill, skill.unit.getPercentHealth(vars.value2), true);
						}
						attack();
					}
					function onPostSkill() {
						for( t in skill.getTargets() ) {
							if( !t.target.isAlive() ) {
								skill.unit.heal(skill, ceil(skill.unit.stats.health*vars.value4/100));
							}
						}
					}",
