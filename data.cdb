					"script": "function onBeginBattle(){
						vars.escapeDeath = false;
					}
					function onBeforeHit(a) {
						var p = skill.unit.health;
						if (a.target == skill.unit && a.dmg >= p && !vars.escapeDeath) {
							var d = ceil(a.dmg * vars.value1 / 100);
							a.dmg -= d;
							skill.unit.heal( skill, ceil(skill.unit.stats.health*vars.value2/100) );
							skill.unit.addStatus(Status.Berserk);
							vars.escapeDeath = true;
						}
					}",
