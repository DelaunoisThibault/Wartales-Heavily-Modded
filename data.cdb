					"script": "function onBeginAction(){\n    var n = 0;\n    for (u in getAllUnits().filter(u -> u.isAlive() && isPlayer(u)))\n        n++;\n    vars.nbMine = ceil(n / vars.nbUnits);\n}\n\nfunction onSkill(){\n\tplay();\n\tvar us = getAllUnits().filter(u -> u.isAlive() && isPlayer(u));\n\tvar l = us.length;\n\tfor (i in 0...vars.nbMine) {\n\t\tcastSkill(Skill.PirateMine, { unit: us[randInt(0, l - 1)] }, skill, true);\n\t}\n}",
