					"script": "function onEval(a) {\n\tif (canUseAttackStance()) {\n\t\ta.criticalHitDamageBonus += vars.value2;\n\t}\n\ta.attackCount = vars.value3;\n}\n\nfunction onDamage(a) {\n\tvars.attackCount++;\n\tif (vars.attackCount == vars.value3){\n\t\tif (a.target.isEngaged()) {\n\t\t\ta.target.disengage(false);\n\t\t}\n\t\tif( skill.unit.canSwapPositionWith(a.target) ) {\n\t\t\tvar prevPos = a.target.getPosition();\n\t\t\tvar currentPos = skill.unit.getPosition();\n\t\t\tskill.unit.swapPositionWith(a.target, 0);\n\t\t}\n\t\tskill.unit.engage(a.target);\n\t}\n}\n\nfunction onPostSkill(){\n\tif (canUseDefenseStance()) {\n\t\tskill.unit.addStatus(Status.ToPosition, vars.value1, true);\n\t}\n\tvars.attackCount = 0;\n}",
