					"mode": 2,
					"range": {},
					"props": {},
					"script": "function onDamageDealt(a){\n\tif(a.target.isEngaged() && a.target.engagedUnit != a.unit && a.target.engagedUnit.isAnimal && a.target.engagedUnit.side == a.unit.side){\n\t\ta.target.engagedUnit.addStatus(Status.Riposte);\n\t\tspawnFx();\n\t}\n}",
