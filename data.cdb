				{
					"id": "Regeneration",
					"name": "Régénération",
					"desc": "Tant que cette unité n’a pas de malus, elle récupère ::value1::% de sa [Health] maximum à la fin de chaque tour.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 20
						}
					},
					"script": "function onEndTurn() {
						var hasMalus = false;
						for(m in skill.unit.getAllStatus()){
								if(m.isMalus){
									hasMalus = true;
									break;
								}
							}
						if( skill.level == 1 ) {
							if (!hasMalus) {
								skill.unit.heal(skill,  ceil(skill.unit.stats.health*vars.value1/100) , null);
							}
						} else if ( skill.level == 2 ) {
							if (!hasMalus) {
								skill.unit.heal(skill,  ceil(skill.unit.stats.health*vars.value1/100) , null);
							} else {
								for( st in skill.unit.getAllStatus() ) {
									if( st.isMalus && !st.isInjury) {
										st.cancel();
									}
								}
							}
						}
					}",
