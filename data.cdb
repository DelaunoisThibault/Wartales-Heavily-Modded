							"personality": "PersDefault"
						},
						{
							"introDialog": [
								{
									"text": "[XM]Je pensais pas dire ça un jour, mais plus le temps passe, plus ::name:: me plait.\nNon seulement c'est un bon combattant, mais en plus il est toujours partant pour lever le coude ! On peut pas rêver de meilleur frère d'armes."
								},
								{
									"text": "[XF]Je pensais pas dire ça un jour, mais plus le temps passe, plus ::name:: me plait.\nNon seulement c'est un bonne combattante, mais en plus elle est toujours partante pour lever le coude ! On peut pas rêver de meilleure sœur d'armes."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[MX]Renforcer ses liens avec ::name:: grâce aux pouvoirs de l'alcool."
