									"props": {}
								},
								{
									"texts": [
										{
											"text": "[XX]Encourager le groupe à tenir bon face aux lycanthropes."
										}
									],
									"tipText": "Motiver",
									"cost": {},
									"gains": {
										"relation": [
											{
												"qty": 1,
												"target": 1
											},
											{
												"qty": 1,
												"target": 1
											},
											{
												"qty": 1,
												"target": 1
											}
										]
									},
									"props": {}
								}
							],
							"personality": "PersDefault"
						},
						{
							"introDialog": [
								{
									"text": "[XX] Bon sang ! Je n’arrive pas à croire qu’on soit toujours en vie ! Ces foutus monstres sont terrifiants !\nOn en a combattu, des horreurs, mais les lycanthropes... je n’arrive pas à m’y habituer !"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Raconter cette rencontre dans un poème."
										}
									],
									"tipText": "Écrire",
									"cost": {},
									"gains": {
										"item": [
											{
												"inf": "Influence",
												"qty": 100
											}
										]
									},
									"props": {}
								}
							],
							"personality": "PersCompassionate"
						},
						{
							"introDialog": [
								{
									"text": "[XX] Combien y-a-il de lycanthropes dans cette maudite région ? J’ai l’impression d’en avoir déjà tué des centaines ! Qu’est-ce qu’ils faisaient, les Chevaliers, avant qu’on n’arrive ? Ils les regardaient se reproduire ?"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Se promettre de passer ses nerfs sur les prochains ennemis."
										}
									],
									"tipText": "Maugréer",
									"cost": {},
									"gains": {
										"status": [
											{
												"inf": "Angry",
												"target": 0
											}
										]
									},
									"props": {}
								}
							],
							"personality": "PersAggressive"
						},
						{
							"introDialog": [
								{
									"text": "[XX] Il ne faut pas se laisser décourager. Les lycanthropes sont difficiles à combattre, certes. Mais à force de les affronter, nous allons finir par progresser ! Et si nous arrivons à triompher d’ennemis pareils, plus aucun brigand ou déserteur ne nous résistera !"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XM]User de son expérience pour améliorer sa manière de combattre."
										},
										{
											"text": "[XF]User de son expérience pour améliorer sa manière de combattre."
										}
									],
									"tipText": "S'entrainer",
