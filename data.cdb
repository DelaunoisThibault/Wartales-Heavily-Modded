					"script": "function onBeginRound() {\n\tif(getRound() != 1) return;\n\tfor (u in getUnits())\n\t\tif (u.isElement(cast \"T9BisTavernIgor\")) {\n\t\t\tlockCamera(true);\n\t\t\tu.askSwapWeaponModel(\"assets/interior/deco/assetPack/Bottle.fbx\", false);\n\t\t\twait(1.);\n\t\t\tsetCameraTarget(u);\n\t\t\tu.playAnim(\"StandDrink_D\");\n\t\t\tu.damages(skill, u.stats.maxHealth, true);\n\t\t\tlockCamera(false);\n\t\t\treturn;\n\t\t}\n}",
