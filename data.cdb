					"script": "function onDamageDealt(a){\n\tif (a.isStanceAttack() && canUseAttackStance() && a.target.isAlive()) {\n\t\tvar val = vars.value1;\n\t\tif(a.target.hasStatus(Status.Champion))\n\t\t\tval = vars.value3;\n\t\ta.target.damages(skill, a.target.getPercentHealth(val));\n\t}\n}\n\nfunction onDamageTaken(a){\n\tif(canUseDefenseStance()){\n\t\ta.unit.damages(skill, ceil(a.dmgDealt*vars.value2/100));\n\t}\n}",
