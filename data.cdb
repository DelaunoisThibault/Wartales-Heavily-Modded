				{
					"id": "S_Captured_7_1",
					"name": "Prise par le col",
					"desc": "À chaque fois qu'un ennemi termine son tour adjacent à cette unité, il subit [Slowdown] pendant ::value1:: round.",
					"mode": 2,
					"range": {},
					"props": {
						"tooltipStatus": [
