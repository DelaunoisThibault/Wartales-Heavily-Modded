					"props": {},
					"script": "function onBeginRound() {\n\tif (getRound() == 1) {\n\t\tskill.unit.addStatus(Status.PugiFocused);\n\t}\n\telse if(skill.level == 2) {\n\t\tskill.unit.addStatus(Status.PugiFocused);\n\t}\n\telse{\n\t\tskill.unit.cancelStatus(Status.PugiFocused);\n\t}\n}\n\nfunction onSkillPlayed(s) {\n\tif (s.isStanceAttack())\n\t\ts.unit.cancelStatus(Status.PugiFocused);\n}",
