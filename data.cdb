							"value1": 20
						},
						"isAttack": true,
						"impactFx": "prefabs/fx/fight/hits & impacts/impactElectrical.fx"
					},
					"script": "function onBeforeHit(a) {\n\tif( isFoe(a.target) ) return;\n\tif( !skill.unit.hasStatus(Status.PitH1_5_Conduit) ) return;\n\tif( getDistance(skill.unit, a.target) > vars.range ) return;\n\tswitch( a.skillKind ) {\n\t\tcase Skill.PitH1_BossLightning, Skill.PitH1_LightningBolt, Skill.Lightning, Skill.SportLightning, Skill.CelestiumLightning:\n\t\tdefault: return;\n\t}\n\n\t@async {\n\t\tskill.unit.consumeStatus(Status.PitH1_5_Conduit);\n\t\tplay(\"Hurt\");\n\t\tskill.unit.damages(skill, skill.unit.getPercentHealth(vars.value1), true);\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "PitH1_BossPushback",
