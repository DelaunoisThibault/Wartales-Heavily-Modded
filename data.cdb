				{
					"id": "CrawlerLichMindControl", 
					"name": "Emprise de la liche", 
					"desc": "Brise l'esprit d'une cible et lui inflige [Weakening], [Destabilization], [Fragility], [Slowdown] et [Vulnerability] pour le restant du combat. \nNe dure que ::value1:: round sur les élites.", 
					"mode": 5, 
					"range": {
						"radius": 0.5,
						"allowedTargets": 0,
						"baseDistance": 12
					}, 
					"props": {
						"usableWhenDying": true,
						"useWithoutWeapon": true,
						"vars": {
							"value1": 1,
							"value2": 3
						},
						"tooltipStatus": [
							{
								"st": "Weakening"
							},
							{
								"st": "Destabilization"
							},
							{
								"st": "Fragility"
							},
							{
								"st": "Slowdown"
							},
							{
								"st": "Vulnerability"
							}
						],
						"animFx": "prefabs/fx/fight/Creatures/CrawlerSlash.fx",
						"apCost": 3
					}, 
					"script": "function onSkill() {
						for ( t in skill.getTargets() ) {
							if( t.target != null ){
								if( !t.target.hasStatus(Status.Gladiator) && !t.target.hasStatus(Status.Champion) ) {
									t.target.addStatusPersist(Status.Weakening, skill);
									t.target.addStatusPersist(Status.Destabilization, skill);
									t.target.addStatusPersist(Status.Fragility, skill);
									t.target.addStatusPersist(Status.Slowdown, skill);
									t.target.addStatusPersist(Status.Vulnerability, skill);
								} else {
									t.target.addStatus(Status.Weakening, vars.value1, true);
									t.target.addStatus(Status.Destabilization, vars.value1, true);
									t.target.addStatus(Status.Fragility, vars.value1);
									t.target.addStatus(Status.Slowdown, vars.value1, true);
									t.target.addStatus(Status.Vulnerability);
								}
							} else {
								skill.unit.gainsActionPoint(vars.value2);
								allowReplay();
							}
						}
