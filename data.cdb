						"x": 16,
						"y": 19
					}
				},
				{
					"id": "PitH1_3_BouncingStatus",
					"name": "Malédiction",
					"desc": "Deux unités ennemies sont affectées par [PitH1_3_Bouncing]. Lorsque l'une d'elle est frappée, le statut est transféré à son allié le plus proche avec une application supplémentaire.",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"tooltipStatus": [
							{
								"st": "PitH1_3_Bouncing"
							}
						]
					},
					"script": "function onInit() {\n\tvar foes = getFoeUnits();\n\tfoes[0].addStatus(Status.PitH1_3_Bouncing);\n\tif( foes.length >= 2 )\n\t\tfoes[foes.length - 1].addStatus(Status.PitH1_3_Bouncing);\n}\n\nfunction onDamageTaken(a) {\n\tif( a.target.hasStatus(Status.PitH1_3_Bouncing) )\n\t\tbounce(a.target);\n}\n\nfunction onDamageDealt(a) {\n\tif( a.unit.hasStatus(Status.PitH1_3_Bouncing) ) {\n\t\tbounce(a.unit);\n\t}\n}\n\nfunction bounce(u) {\n\tvar foe = isFoe(u);\n\tvar team = getAllUnits().filter(u -> u.isAlive() && isFoe(u) == foe && !u.hasStatus(Status.PitH1_3_Bouncing));\n\tvar bounceTargets = team.filter(u -> !u.hasStatus(Status.PitH1_3_BouncingFlag));\n\n\t// reset the bounce cycle\n\tif( bounceTargets.length == 0 ) {\n\t\tfor( u in team )\n\t\t\tu.cancelStatus(Status.PitH1_3_BouncingFlag);\n\t\tbounceTargets = team;\n\t}\n\n\tif( bounceTargets.length > 0 ) {\n\t\tbounceTargets.sort((u1, u2) -> round(getDistance(u, u1) - getDistance(u, u2)));\n\t\tvar nearest = bounceTargets[0];\n\n\t\tvar prevStacks = u.getStatusCount(Status.PitH1_3_Bouncing);\n\t\tu.cancelStatus(Status.PitH1_3_Bouncing);\n\t\tu.addStatus(Status.PitH1_3_BouncingFlag);\n\t\tnearest.addStatus(Status.PitH1_3_Bouncing, prevStacks + 1);\n\t}\n}",
					"notes": "",
					"done": 0,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_03_96PX.png",
						"size": 96,
						"x": 10,
						"y": 19
					}
				},
				{
