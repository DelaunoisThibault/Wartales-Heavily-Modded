					"script": "function onDamageTaken(a) {\n\tvar u = a.target;\n\tif(u.hasStatus(Status.Stun) )\n\t\treturn;\n\tu.addStatus(Status.Stun);\n}\n\nfunction onBeginTurn() {\n\tfor( u in getFoeUnits() ) {\n\t\tif( isPlaying(u) && u.hasStatus(Status.Stun) ) {\n\t\t\tskill.unit.consumeStatus(Status.Stun);\n\t\t\tendTurn();\n\t\t\tbreak;\n\t\t}\n\t}\n}\n\nfunction onEndRound() {\n\tfor( u in getFoeUnits() ) {\n\t\tif(u.hasStatus(Status.Stun) ) {\n\t\t\tu.consumeStatus(Status.Stun);\n\t\t}\n\t}\n}",
					"notes": "",
