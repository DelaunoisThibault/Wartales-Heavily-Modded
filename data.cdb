					"desc": "Inflige ::value1:: fois [DMG] à la cible et la force à s’engager.\n[AttackStance]: Chaque attaque applique ::value2:: [Poison].\n[DefenseStance]: Attaque ::value3:: fois supplémentaire pour chaque malus appliqué à la cible. (max: ::value4::)",
					"mode": 0,
					"range": {},
					"props": {
						"vars": {
							"value1": 2,
							"value2": 1,
							"value3": 1,
							"attackCount": 0,
							"attackCountTarget": 0,
							"value4": 5
						},
						"tooltipStatus": [
							{
								"st": "Poison"
							}
						],
						"isAttack": true,
						"dmgAttribute": 1,
						"useStances": true
					},
					"script": "function onEval(t) {\n\tvar n = vars.value1;\n\tif (canUseDefenseStance()) {\n\t\tfor (st in t.target.getAllStatus()) {\n\t\t\tif (st.isMalus) {\n\t\t\t\tn += vars.value3;\n\t\t\t}\n\t\t}\n\t}\n\n\n\tif (n> (vars.value4+vars.value1)){\n\t\tn = (vars.value4+vars.value1);\n\t}\n\tt.attackCount = n;\n\tvars.attackCountTarget = n;\n}\n\nfunction onHit(a) {\n\tif (canUseAttackStance()) {\n\t\ta.target.addStatus(Status.Poison, vars.value2);\n\t}\n}\n\nfunction onDamage(a){\n\tvars.attackCount++;\n\tif (vars.attackCount == vars.attackCountTarget && a.target.isAlive() && a.target.engagedUnit != skill.unit){\n\t\ta.target.disengage();\n\t\ta.target.engage(skill.unit);\n\t}\n}\n\nfunction onPostSkill(){\n\tvars.attackCount = 0;\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true,
