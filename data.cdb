					"props": {
						"priority": 2
					},
					"done": true
				},
				{
					"id": "ConfessionPestiferous",
					"data": [
						{
							"introDialog": [],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Donner de ses propres krowns au groupe pour acheter un remède."
