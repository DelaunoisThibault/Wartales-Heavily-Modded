					"script": "function onSkillEval(s) {\n\tif (!skill.unit.isEngaged()) {\n\t\tfor (t in s.getTargets()) {\n\t\t\tt.criticalHitDamageBonus += vars.valueDmg;\n\t\t\tif (t.target.isEngaged()){\n\t\t\t\tt.criticalHitPercent += vars.valueChance;\n\t\t\t}\n\t\t}\n\t}\n}",
