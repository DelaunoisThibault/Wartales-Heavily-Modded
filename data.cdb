					"script": "function onSkillEval(a) {\n    if (a.unit.hasStatus(Status.CrossbowShotCount))\n        dontAllow();\n}\n\nfunction onEval(t) {\n    var distance = getDistance(skill.unit, t.target);\n    var bonus = ceil(((distance * -vars.valueMax) / 9 /* baseDistance */) + vars.valueMax);\n    t.baseDamageBonus += bonus;\n}\n\nfunction onHit(a) {\n    a.unit.pushback({unit : skill.target}, getPushback( a ), a);\n    a.unit.damages(skill, vars.value1);\n}\n\nfunction getPushback( a ) {\n\treturn 3;\n}\nfunction getPushbackOrigin( a ) {\n\treturn {unit : a.target, origin : a.unit};\n}\nfunction getPushbackTarget( a ) {\n\treturn a.unit;\n}\n\nfunction onStatus(s){\n    if (s.kind == Status.CrossbowReloadCount)\n        skill.unit.addStatus(Status.Aim, vars.value2);\n}",
