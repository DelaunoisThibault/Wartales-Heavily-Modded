					"script": "function onCenserPurgedHit(c) {\n\tif (vars.locked) return;\n\tvar ally = isMeleeWithAlly(skill.unit);\n\tvar foe = skill.level == 2 ? ally : false;\n\tif (!ally || skill.level == 1)\n\t\tfor (u in getFoes(skill.unit)) {\n\t\t\tif (u.isMelee(skill.unit)) {\n\t\t\t\tfoe = true;\n\t\t\t\tif (skill.level == 2)\n\t\t\t\t\tally = true;\n\t\t\t\tif (ally && foe) break;\n\t\t\t}\n\t\t}\n\tif (!ally || !foe) return;\n\tvars.locked = true;\n\tpurgeCenser();\n\tvar sts = [];\n\tfor (_ in 0...vars.n-1)\n\t\tsts.push(c.st);\n\tpurgeCenserTargets(sts);\n\tvars.locked = false;\n}",
