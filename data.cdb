							"personality": "PersDefault"
						},
						{
							"introDialog": [
								{
									"text": "[MX]Être recherché par la Garde m’a empêché de dormir. Je n’ai pas arrêté de me réveiller en sursaut, certain d’avoir entendu le cliquetis des chaînes."
								},
								{
									"text": "[FX]Être recherchée par la Garde m’a empêché de dormir. Je n’ai pas arrêté de me réveiller en sursaut, certaine d’avoir entendu le cliquetis des chaînes."
								}
							],
							"choices": [
								{
									"texts": [
