				{
					"id": "Intervention",
					"name": "Intervention",
					"desc": "L'unité peut échanger sa place avec un allié adjacent engagé. L'unité devient engagée et effectue une attaque d’opportunité.",
					"mode": 0,
					"range": {
						"allowedTargets": 1
					},
					"props": {
						"apCost": 1,
						"needDisengaged": true,
						"cursor": "CursorHelp",
						"tooltipStatus": [
							{
								"st": "OpportunityAttack"
							}
						]
					},
					"script": "function onEval(a) {\n\tif( !a.target.isEngaged() || a.target.isAnimal || !skill.unit.canSwapPositionWith(a.target) ) {\n\t\tdontAllow();\n\t}\n}\n\nfunction onSkill() {\n\tvar target = skill.target;\n\tvar prevEngaged = target.engagedUnit;\n\ttarget.disengage(false);\n\n\tvar prevPos = target.getPosition();\n\tvar currentPos = skill.unit.getPosition();\n\tskill.unit.swapPositionWith(target, 0);\n\n\tskill.unit.engage(prevEngaged);\n\tskill.unit.opportunityAttack(prevEngaged, skill);\n}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons96PX.png",
						"size": 96,
						"x": 6,
						"y": 18
					},
					"iconeDone": true,
					"done": 2
				},
