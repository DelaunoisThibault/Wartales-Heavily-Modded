					"name": "Sacrifice motivant",
					"desc": "Tue une unité alliée. S'il s'agit d'un mort-vivant, applique [Brutality] et [Protection] pendant ::value1:: rounds sur tous les alliés. Sinon, applique [Fury], ::value2:: [AnimalMarkedBonus] et [Inspiration] pendant ::value3:: round.",
					"mode": 1,
					"range": {
						"baseDistance": 999,
						"allowedTargets": 1
					},
					"props": {
						"apCost": 0,
						"vars": {
							"value1": 2,
							"value2": 2,
							"value3": 1
						},
						"tooltipStatus": [
							{
								"st": "Brutality"
							},
							{
								"st": "Protection"
							},
							{
								"st": "Fury"
							},
							{
								"st": "AnimalMarkedBonus"
							},
							{
								"st": "Inspiration"
							}
						],
						"useWithoutWeapon": true,
						"specialAnim": "Howl",
						"extraFx": "prefabs/fx/fight/Rat_Matriarch/MotherRatHowl.fx"
					},
					"script": "function onSkill() {
						play();
						for( t in skill.getTargets() ) {
							if( t.target.kind != UnitClass.CrawlerLich && t.target.kind != UnitClass.AncientBear && t.target.kind != UnitClass.SpectralAssassin && t.target.kind != UnitClass.SpectralAssassinRecoilShot && t.target.kind != UnitClass.SpectralAssassinBarrage){
								t.target.damages(skill, t.target.stats.health, true);
							} else {
								allowReplay();
							}
						}
					}
					function onPostSkill() {
						for( t in skill.getTargets() ){
							if( t.target.isAlive() ){
								t.target.damages(skill, t.target.stats.health, true);
							} else {
								for( u in getAllies(skill.unit) ){
									if( t.target.kind == UnitClass.Undead ){
										u.addStatus(Status.Brutality, vars.value1, true);
										u.addStatus(Status.Protection, vars.value1, true);
									} else {
										u.addStatus(Status.Fury);
										u.addStatus(Status.AnimalMarkedBonus, vars.value2);
										u.addStatus(Status.Inspiration, vars.value3, true);
									}
								}
							}
						}
					}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons96PX.png",
						"size": 96,
						"x": 17,
						"y": 14
					},
