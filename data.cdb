					"script": "function onBeginBattle(){
						if( !skill.unit.hasStatus(Status.Inspiration) ){
							skill.unit.addStatusPersist(Status.Inspiration, skill);
						}
						if( !skill.unit.hasStatus(Status.PreventEngage) ){
							skill.unit.addStatusPersist(Status.PreventEngage, skill);
						}
					}
					function onBeginAction(){
						if( !skill.unit.hasStatus(Status.Inspiration) ){
							skill.unit.addStatusPersist(Status.Inspiration, skill);
						}
						if( !skill.unit.hasStatus(Status.PreventEngage) ){
							skill.unit.addStatusPersist(Status.PreventEngage, skill);
						}
					}
					function onEndTurn(){
						if( !skill.unit.hasStatus(Status.Inspiration) ){
							skill.unit.addStatusPersist(Status.Inspiration, skill);
						}
						if( !skill.unit.hasStatus(Status.PreventEngage) ){
							skill.unit.addStatusPersist(Status.PreventEngage, skill);
						}
						for( u in getAllies(skill.unit) ) {
							if( getDistance(skill.unit, u) <= vars.value2 ) {
								u.addStatus(Status.Inspiration, vars.value1, true);
							}
						}
					}",
