					"script": "function onBeginAction(){\n\tif (skill.unit.hasStatus(Status.AttackStance) && !skill.unit.hasStatus(Status.StancesMasteryAttackBonus)) {\n\t\tskill.unit.cancelStatus(Status.StancesMasteryDefenseBonus);\n\t\tskill.unit.addStatus(Status.StancesMasteryAttackBonus, vars.value1);\n\t} else if (skill.unit.hasStatus(Status.DefenseStance) && !skill.unit.hasStatus(Status.StancesMasteryDefenseBonus)) {\n\t\tskill.unit.cancelStatus(Status.StancesMasteryAttackBonus);\n\t\tskill.unit.addStatus(Status.StancesMasteryDefenseBonus, vars.value2);\n\t}\n}",
