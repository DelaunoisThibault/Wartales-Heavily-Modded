				{
					"id": "CenserAfflictionOnPurge",
					"name": "Purge nocive",
					"desc": "Lorsque cette unité <b>purge</b>, applique ::nPoison:: [Poison]s aux ennemis à moins de ::range:: mètres, ainsi que ::nCorrosion:: [Corrosion]s s'ils ont toujours de l'armure, sinon, applique [Bleeding]. \nSi l'unité affectée a [Pyrophobia], applique [Burning] à la place du poison.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"nPoison": 2,
							"nCorrosion": 2,
							"range": 5
						},
						"tooltipStatus": [
							{
								"st": "Poison"
							},
							{
								"st": "Corrosion"
							},
							{
								"st": "Bleeding"
							},
							{
								"st": "Pyrophobia"
							},
							{
								"st": "Burning"
							}
						]
					},
					"script": "function onCenserPurged(c) {
						for (f in getFoes(skill.unit)) {
							if ( getDistance(skill.unit, f) < vars.range ) {
								if( f.hasStatus(Status.Pyrophobia) ){
									f.addStatus(Status.Burning);
								} else {
									f.addStatus(Status.Poison, vars.nPoison);
								}
								if( f.armor > 0){
									f.addStatus(Status.Corrosion, vars.nCorrosion);
								} else {
									f.addStatus(Status.Bleeding);
								}
							}
						}
					}",
