				{
					"id": "PackSurvival",
					"name": "Survie de la meute",
					"desc": "Lorsque cette unité devrait être tuée, elle échange sa place avec l'allié le plus proche dans un rayon de ::m:: mètres et se soigne de ::h::% de sa [Health] maximum.\n\nL'allié gagne [Fury].",
					"mode": 2,
					"range": {
						"type": 0,
						"radius": 14
					},
					"props": {
						"tooltipStatus": [
							{
								"st": "Fury"
							}
						],
						"vars": {
							"m": 14,
							"h": 10
						},
						"globalEvents": true
					},
					"script": "function onSkillPlayed(a) {\n\tvar has = false;\n\tfor (t in a.getTargets()) {\n\t\tif (t.target == skill.unit) {\n\t\t\thas = true;\n\t\t\tbreak;\n\t\t}\n\t}\n\tif (!has) return;\n\tcheckLife();\n}\n\nfunction onEndTurn(){\n\tif (!isCurrentTurn(skill.unit)) return;\n\tcheckLife();\n}\n\nfunction hasValidAllies() {\n\tfor(u in getAllies(skill.unit))\n\t\tif (getDistance(u, skill.unit) <= vars.m && skill.unit.canSwapPositionWith(u))\n\t\t\treturn true;\n\treturn false;\n}\n\nfunction doSwap() {\n\tvar swapUnit = null;\n\tvar minDist = 0.;\n\tfor (a in getAllies(skill.unit)) {\n\t\tvar d = getDistance(a, skill.unit);\n\t\tif (d <= vars.m && skill.unit.canSwapPositionWith(a) && (swapUnit == null || d < minDist)) {\n\t\t\tswapUnit = a;\n\t\t\tminDist = d;\n\t\t}\n\t}\n\tvar eu = swapUnit.engagedUnit;\n\tif (eu != null)\n\t\tswapUnit.disengage(false);\n\tskill.unit.swapPositionWith(swapUnit, 0.2);\n\tskill.unit.heal(skill, skill.unit.getPercentHealth(vars.h, true));\n\tif (eu != null)\n\t\tskill.unit.engage(eu);\n\tswapUnit.addStatus(Status.Fury);\n}\n\nfunction checkLife() {\n\tif (skill.unit.health > 0) return;\n\tfor(u in getAllies(skill.unit))\n\t\tif (getDistance(u, skill.unit) <= vars.m && skill.unit.canSwapPositionWith(u)) {\n\t\t\tdoSwap();\n\t\t\tbreak;\n\t\t}\n}",
