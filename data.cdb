							}
						],
						"globalEvents": true,
						"vars": {
							"todo": false,
							"tmpUnit": null
						}
					},
					"script": "function onStatusApplied(s) {\n    if (s.source == skill.unit && s.kind == Status.Burning) {\n\t\tvars.todo = true;\n\t\tvars.tmpUnit = s.unit;\n    }\n}\n\nfunction onBeginAction() {\n\tif (vars.todo) {\n\t\tvars.todo = false;\n\t\tif (vars.tmpUnit != null && vars.tmpUnit.isAlive()) {\n       \t\tvars.tmpUnit.applyDot(Status.Burning);\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
