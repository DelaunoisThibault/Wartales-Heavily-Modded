					"script": "function onSkill() {\n\tplayThrowFromAudience(randInt(3, 5));\n\tattack();\n}\n\nfunction onEval(a) {\n\tif(a.target.hasTrait(Trait.Philanthropist))\treturn;\n\n\ta.dmg = min(a.target.armor, round(a.target.armor * vars.value1 / 100));\n}\n\nfunction onHit(a) {\n\tif(a.target.hasTrait(Trait.Philanthropist))\treturn;\n\ta.target.addStatus(Status.Slowdown, vars.value2);\n}",
