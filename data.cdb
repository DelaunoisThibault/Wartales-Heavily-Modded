				},
				{
					"id": "RelentlessTraining",
					"name": "Entraînement impitoyable",
					"desc": "Inflige ::damage::% de leur [Health] maximum à un allié et lui confère ::status:: [AnimalMarkedBonus].\nS'il est engagé avec un ennemi, cet allié effectue également une attaque d’opportunité dont les dégâts sont augmentés de ::value1::%.\nSi l'allié engagé est un animal, les dégâts sont augmentés de ::value2::% à la place.",
					"mode": 0,
					"range": {
						"allowedTargets": 1
					},
					"props": {
						"vars": {
							"damage": 10,
							"status": 4,
							"value1": 25,
							"triggered": false,
