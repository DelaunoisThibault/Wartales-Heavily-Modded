							{
								"st": "BeastInfluence"
							}
						]
					},
					"script": "function onSkillPlayed(s) {\n\tif (s.unit == skill.unit && s.kind == Skill.FirstAid) {\n\t\ts.target.consumeStatus((s.target.isAnimal && !s.target.isWerewolf) ? Status.BeastInfluence : Status.Terror, vars.value);\n\t}\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
