						"isAttack": true
					},
					"script": "function onSkill() {\n\tvar count = vars.count;\n\tvars.attackcount = 0;\n\tfor( i => t in skill.getTargets() ) {\n\t\tif (t.isCritical){\n\t\t\tcount++;\n\t\t\tbreak;\n\t\t}\n\t}\n\tfor( i in 0...count) {\n\t\tif (count <= 2) {\n\t\t\tattack({ anim : \"AttackFast\"+(i%2+1), fast : true });\n\t\t} else {\n\t\t\tvar isLastAttack = i == count - 1;\n\t\t\tattack({ anim : isLastAttack ? \"AttackPower\" : \"AttackFast\"+(i%2+1), fast : !isLastAttack });\n\t\t}\n\t\tvars.attackcount++;\n\t}\n}\n\nfunction onEval(a) {\n\ta.baseDamageBonus += vars.attackcount * vars.dmgBonus;\n}",
