				{
					"id": "ReshufflingCards",
					"name": "Rebattre les cartes",
					"desc": "Inflige ::value1:: fois [DMG] à la cible et la force à s’engager.\n[AttackStance]: Si la cible est non-Elite et a plus de [Health], inflige à nouveau des dégats pour que les deux unités aient le même % de [Health].\n[DefenseStance]: Si la cible est non-Elite et a plus de [Health], se soigne pour que les deux unités aient le même % de [Health].",
					"mode": 0,
					"range": {},
					"props": {
						"vars": {
							"value1": 1
						},
						"isAttack": true,
						"dmgAttribute": 1,
						"useStances": true,
						"flags": 0
					},
					"script": "function onPostSkill() {\n\tif(skill.unit.engagedUnit != null && !skill.unit.engagedUnit.hasStatus(Status.Champion)){\n\t\tvar myPercentHealth = skill.unit.health / skill.unit.stats.maxHealth;\n\t\tvar targetPercentHealth = skill.unit.engagedUnit.health / skill.unit.engagedUnit.stats.maxHealth;\n\t\tif(targetPercentHealth > myPercentHealth){\n\t\t\tif (canUseAttackStance()) {\n\t\t\t\tvar amount = skill.unit.engagedUnit.health - skill.unit.engagedUnit.getPercentHealth(myPercentHealth * 100);\n\t\t\t\tattack({ anim : \"Attack\", fast : true, dmg: amount });\n\t\t\t}\n\t\t\tif (canUseDefenseStance()){\n\t\t\t\tvar amount = skill.unit.getPercentHealth(targetPercentHealth * 100) - skill.unit.health ;\n\t\t\t\tskill.unit.heal(skill, amount);\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunction onSkill() {\n\tfor( t in skill.getTargets() ) {\n\t\tif( t.target.engagedUnit != skill.unit ) {\n\t\t\tt.target.disengage(false);\n\t\t\tt.target.engage(skill.unit);\n\t\t}\n\t}\n\t// play();\n\tattack();\n}",
					"notes": "",
					"done": 0,
					"iconeDone": true,
					"icon": {
