						"extraFx": "prefabs/fx/fight/Rat_Matriarch/MotherRatHowl.fx"
					},
					"script": "function onDeath(a) {
						if( !a.target.isAnimal ) {
							if(vars.deadHumansCount < vars.value1){
								vars.deadHumansCount++;
							}
						} 
					}
					function onSkill() {
						spawnRenfort(UnitClass.Undead, vars.deadHumansCount, false);
						vars.deadHumansCount = 0;
					}",
					"notes": "",
					"icon": {
						"file": "ui/Icons_Resources.png",
						"size": 96,
						"x": 9,
						"y": 8
					},
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "CrawlerLichGhostAnimalsSummoning",
					"name": "Réanimation de la Meute fantôme",
					"desc": "Invoque jusqu'à ::value1:: Animaux fantômes en fonction du nombre d'animaux correspondants morts (un loup donnera un loup fantôme, un sanglier un sanglier fantôme, etc. Si aucun équivalent n'existe, un loup fantôme est invoqué à la place.). \nNombre d'animaux morts actuellement : \nLoups : ::deadWolves::,\nSangliers : ::deadBoars::,\nOurs : ::deadBears::,\nPoneys : ::deadPonys::,\nSmilodons : ::deadSmilodons::,\nRats pestiférés : ::deadPlaguedRats::,\nRat-taupes : ::deadMolerats::,\nTotal : ::deadAnimalsCount::.",
					"mode": 4,
					"range": {},
					"props": {
						"globalEvents": true,
						"usableWhenDying": true,
						"apCost": 1,
						"vars": {
							"value1": 10,
							"deadBoars": 0,
							"deadWolves": 0,
							"deadBears": 0,
							"deadPonys": 0,
							"deadSmilodons": 0,
							"deadPlaguedRats": 0,
							"deadMolerats": 0,
							"deadAnimalsCount": 0
						},
						"specialAnim": "Howl",
						"extraFx": "prefabs/fx/fight/Rat_Matriarch/MotherRatHowl.fx"
					},
					"script": "function onDeath(a) {
						if( a.target.isAnimal && !a.target.isGhost ) {
							vars.deadAnimalsCount = vars.deadBoars + vars.deadWolves + vars.deadBears + vars.deadPonys + vars.deadSmilodons + vars.deadPlaguedRats + vars.deadMolerats;
							if(vars.deadAnimalsCount < vars.value1){
								if( a.target.kind == UnitClass.Wolf || a.target.kind == UnitClass.SnowWolf || a.target.kind == UnitClass.Alpha || a.target.kind == UnitClass.WolfFierce || a.target.kind == UnitClass.SnowAlpha || a.target.kind == UnitClass.SteelWolf || a.target.kind == UnitClass.SteelSnowWolf || a.target.kind == UnitClass.AncientAlpha || a.target.kind == UnitClass.AncientSnowAlpha || a.target.kind == UnitClass.GodLikeAlpha || a.target.kind == UnitClass.GodLikeSnowAlpha ){     
									vars.deadWolves++;
								} else if( a.target.kind == UnitClass.Boar || a.target.kind == UnitClass.DominantSow || a.target.kind == UnitClass.BoarFierce || a.target.kind == UnitClass.Swamoar || a.target.kind == UnitClass.SteelBoar || a.target.kind == UnitClass.SteelSwamoar || a.target.kind == UnitClass.AncientSwamoar || a.target.kind == UnitClass.AncientDominantSow || a.target.kind == UnitClass.GodLikeDominantSow || a.target.kind == UnitClass.GodLikeSwamoar ){
									vars.deadBoars++;
								} else if( a.target.kind == UnitClass.Bear || a.target.kind == UnitClass.WhiteBear || a.target.kind == UnitClass.BearFierce || a.target.kind == UnitClass.TrackerBears || a.target.kind == UnitClass.SteelBear || a.target.kind == UnitClass.SteelWhiteBear || a.target.kind == UnitClass.SkilledBear || a.target.kind == UnitClass.SkilledWhiteBear || a.target.kind == UnitClass.GodLikeBear || a.target.kind == UnitClass.GodLikeWhiteBear ){
									vars.deadBears++;
								} else if( a.target.kind == UnitClass.Smilodon || a.target.kind == UnitClass.SmilodonAlpha || a.target.kind == UnitClass.SmilodonFierce || a.target.kind == UnitClass.SteelSmilodon || a.target.kind == UnitClass.AncientSmilodonAlpha || a.target.kind == UnitClass.GodLikeSmilodonAlpha){
									vars.deadSmilodons++;
								} else if( a.target.kind == UnitClass.PlaguedRat || a.target.kind == UnitClass.Pit230 || a.target.kind == UnitClass.PitRat || a.target.kind == UnitClass.WanderingMatriarch ){
									vars.deadPlaguedRats++;
								} else if( a.target.kind == UnitClass.Molerat || a.target.kind == UnitClass.PitMolerat || a.target.kind == UnitClass.SteelMolerat || a.target.kind == UnitClass.MoleratMatriarch || a.target.kind == UnitClass.GodLikeMolerat ) {
									vars.deadMolerats++;
								} else if( a.target.kind == UnitClass.Pony ) {
									vars.deadPonys++;
								} else {
									vars.deadWolves++;
								}
							}
							vars.deadAnimalsCount = vars.deadBoars + vars.deadWolves + vars.deadBears + vars.deadPonys + vars.deadSmilodons + vars.deadPlaguedRats + vars.deadMolerats;
						} 
					}
					function onSkill() {
						spawnRenfort(UnitClass.GhostWolf, vars.deadWolves, false);
						spawnRenfort(UnitClass.GhostBoar, vars.deadBoars, false);
						spawnRenfort(UnitClass.GhostBear, vars.deadBears, false);
						spawnRenfort(UnitClass.Nightmare, vars.deadPonys, false);
						spawnRenfort(UnitClass.GhostMoleRat, vars.deadMolerats, false);
						spawnRenfort(UnitClass.GhostRat, vars.deadPlaguedRats, false);
						spawnRenfort(UnitClass.GhostSmilodon, vars.deadSmilodons, false);
						vars.deadWolves = 0;
						vars.deadBoars = 0;
						vars.deadBears = 0;
						vars.deadPonys = 0;
						vars.deadMolerats = 0;
						vars.deadPlaguedRats = 0;
						vars.deadSmilodons = 0;
					}",
