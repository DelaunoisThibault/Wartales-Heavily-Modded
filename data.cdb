					"script": "function onSkill() {\n\tplay();\n\tif (skill.unit.isEngaged()) {\n\t\tfor (u in getAllies(skill.unit, true)) {\n\t\t\tif (u.isEngaged()) {\n\t\t\t\tu.addStatus(Status.Fervor, vars.value1);\n\t\t\t}\n\t\t}\n\t}\n\telse {\n\t\tfor (u in getAllies(skill.unit)) {\n\t\t\tif (!u.isEngaged()) {\n\t\t\t\tu.addStatus(Status.Fervor, vars.value2);\n\t\t\t}\n\t\t}\n\t}\n}",
