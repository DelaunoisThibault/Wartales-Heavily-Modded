					"desc": "A chaque fois qu'elle subit des dégâts, cette unité a ::value1::% de chance de soigner les alliés dans un rayon de ::value2:: mètres de ::value3::% de leur [Health] maximum. \nLorsqu'elle meurt, elle soigne alliés dans un rayon de ::value2:: mètres de ::value4::% de leur [Health] maximum.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 30,
							"value2": 10,
							"value3": 5,
							"value4": 15
						}
					},
					"script":"function onDamageDone(s){
						if( s.unit != null && !isGameMaster(s.unit) ){
							var diceroll = random(0, 100);
							for( u in getAllies(skill.unit) ) {
								if( getDistance(skill.unit, u) <= vars.value2 && diceroll <= vars.value1 ) {
									u.heal(skill, ceil(u.stats.health*vars.value3/100));
								}
							}
						}
					}
					function onDamageTaken(s) {
						if( !isGameMaster(s.unit) ){
							var diceroll = random(0, 100);
							for( u in getAllies(skill.unit) ) {
								if( getDistance(skill.unit, u) <= vars.value2 && diceroll <= vars.value1 ) {
									u.heal(skill, ceil(u.stats.health*vars.value3/100));
								}
							}
						}
					}
					function onDeath(a) {
						if ( a.target == skill.unit ) {
							for( u in getAllies(skill.unit) ) {
								if( getDistance(skill.unit, u) <= vars.value2 ) {
									u.heal(skill, ceil(u.stats.health*vars.value4/100));
								}
							}
						}
					}",
