					"script":"function onBeginBattle(){
						vars.plaguePresence = false;
						for( u in getFoes(skill.unit) ){
							if(u.kind == UnitClass.PlaguedRat || u.kind == UnitClass.Matriarch || u.kind == UnitClass.Pit230 || u.kind == UnitClass.PitRat || u.kind == UnitClass.Plagueridden || u.kind == UnitClass.PitPlagueRidden || u.kind == UnitClass.WanderingMatriarch || u.kind == UnitClass.MutantPlagueridden || u.kind == UnitClass.GodLikePlagueridden ){
								vars.plaguePresence = true;
							}
						}
						if(vars.plaguePresence){
							for( u in getAllies(skill.unit) ){
								u.addStatus(Status.Deflection);
							}
							vars.plaguePresence = false;
						}
					}
					function onBeginRound(){
						for( u in getFoes(skill.unit) ){
							if(u.kind == UnitClass.PlaguedRat || u.kind == UnitClass.Matriarch || u.kind == UnitClass.Pit230 || u.kind == UnitClass.PitRat || u.kind == UnitClass.Plagueridden || u.kind == UnitClass.PitPlagueRidden || u.kind == UnitClass.WanderingMatriarch || u.kind == UnitClass.MutantPlagueridden || u.kind == UnitClass.GodLikePlagueridden ){
								vars.plaguePresence = true;
							}
						}
						if(vars.plaguePresence){
							for( u in getAllies(skill.unit) ){
								u.addStatus(Status.Deflection);
							}
							vars.plaguePresence = false;
						}
					}
					function onEndTurn(){
						for( u in getAllies(skill.unit) ){
							if( getDistance(skill.unit, u) <= vars.value1 ) {
								for( st in u.getAllStatus() ){
									if( st.kind == Status.Plagued_Injured ){
										play();
										st.cancel();
									}
								}
							}
						}
					}",
