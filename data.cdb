				},
				{
					"id": "PoisonTransmission",
					"name": "Transmission empoisonnée",
					"desc": "[InhalationTrigger] : Retire ::n:: [Poison]. Si cette unité n'a pas de [Poison], soigne ::n2::% de sa [MaxHealth].\n\n[PurgeTrigger] : Donne autant de [ToxicMiasm] que cette unité a d'[Inhalation]s aux unités dans la zone.",
					"mode": 2,
					"range": {
						"allowedTargets": 4
