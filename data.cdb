				{
					"id": "SkelmarWatchWE",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 5,
							"once": false
						}
					},
					"script": "function onStatus(s) {\n    if( s.kind != Status.SkelmarWatchWE || vars.once ) return;\n    vars.once = true;\n    var u = skill.unit;\n    var v = floor(u.stats.maxHealth * (1.0 - (vars.value1 / 100.0)));\n\tif (u.health > v)\n    \tu.health = v;\n    u.forceAttribute(Attribute.MaxHealth, v);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "E2R2InquisitionCamp",
					"name": "",
					"desc": "",
					"mode": 8,
					"range": {},
					"props": {
						"globalEvents": true,
						"vars": {
							"maxTurns": 5,
							"maxKills": 3,
							"minLeaderHp": 20,
							"ct": 0,
							"ck": 0
						}
					},
					"script": "function onAfterDeath(a) {\n\tif (a?.target == null) return;\n\tif( isFoe(a.target) ) {\n\t\tvars.ck++;\n\t\tif (vars.ck >= vars.maxKills) {\n\t\t\ttriggerEnd();\n\t\t}\n\t}\n}\n\nfunction onEndTurn() {\n\tfor( u in getAllUnits() ) {\n\t\tif( isPlayer(u) && isCurrentTurn(u) ) {\n\t\t\tvars.ct++;\n\t\t\tif (vars.ct >= vars.maxTurns) {\n\t\t\t\ttriggerEnd();\n\t\t\t}\n\t\t\treturn;\n\t\t}\n\t}\n}\n\nfunction onDamageTaken(s) {\n\tcheckDmgEnd(s);\n}\n\nfunction onDamageDone(s) {\n\tcheckDmgEnd(s);\n}\n\nfunction checkDmgEnd(s) {\n\tif( !isFoe(s.target) || s.target.getElement() == null ) return;\n\tvar pc = 100 * (s.target.health / s.target.stats.health);\n\tif( pc < vars.minLeaderHp || s.kills || s.target.hasStatus(Status.Dying) ) {\n\t\ttriggerEnd();\n    }\n}\n\nfunction triggerEnd() {\n\te2inquisitionExplosion();\n\twin(true);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true
				},
				{
					"id": "PatrollerZone",
					"name": "Qui va là ?",
					"desc": "Lance l'alerte lorsqu'une de vos unités entre dans la zone.",
					"mode": 5,
					"range": {
						"radius": 6,
						"type": 1,
						"allowedTargets": 6,
						"angle": 240
					},
					"props": {
						"globalEvents": true
					},
					"script": "function onMoveEvent(m) {\n\tif (m.unit.side != skill.unit.side || m.unit == skill.unit){\n\t\tskill.unit.castSkill(Skill.PatrollerAlert, {unit : skill.unit}, skill);\n\t}\n}\n\nfunction onMove(m) {\n\tif(m.unit != skill.unit && m.unit.side == skill.unit.side ) return;\n\tvar z = getZone();\n\tif( z == null || z.getKind() != skill.kind ) return;\n\tvar targets = null;\n\tif (m.unit == skill.unit)\n\t\ttargets = getUnits().filter( u -> isPlayer(u) && !u.hasStatus(Status.Prisoner));\n\tm.addZoneEvent(z, onMoveEvent, targets);\n\n}\n\nfunction onSkillPlayed(s) {\n    for ( t in s.getTargets()){\n        if (t.target == skill.unit) {\n\t\t\talert();\n\t\t\tif (t.target.isMelee(t.unit))\n\t\t\t\tt.target.engage(t.unit);\n\t\t}\n    }\n}\n\nfunction onDamageTaken(t) {\n\tif (t.target == skill.unit) {\n\t\talert();\n\t\tif (t.target.isMelee(t.unit))\n\t\t\tt.target.engage(t.unit);\n\t}\n}",
					"notes": "",
					"done": 0,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_04_96PX.png",
						"size": 96,
						"x": 10,
						"y": 4
					}
				},
