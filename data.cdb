					"script": "function onSkillEval(a) {
						if ( hasPlayed(skill.unit) ){
							for ( t in a.getTargets() ){
								if ( isValidUnit(t.target) ) {
									for ( t in a.getTargets() ) t.baseDamageBonus -= vars.value2;
									return;
								}
							}
						}
					}
					function onBeforeHit(a) {
						if (isValidUnit(a.target)) {
							var d = ceil(a.dmg * vars.value1 / 100);
							a.dmg -= d;
							skill.unit.damages(skill, d);
						}
					}
					function isValidUnit(u) {
						if (u == skill.unit) return false;
						if (u.side != skill.unit.side) return false;
						if (u.kind != skill.unit.kind ) return false;
						if (u.hasSkill(Skill.LoneAnimalSoul)) return false;
						return true;
					}",
