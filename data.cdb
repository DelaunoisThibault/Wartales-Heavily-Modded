							}
						],
						"globalEvents": true,
						"vars": {
							"value1": 1,
							"value2": 50
						}
					},
					"script": "function onEndTurn(){\n\tfor (u in getFoes(skill.unit))\n\t\tif (isCurrentTurn(u) && u.isMelee(skill.unit)) {\n\t\t\tu.addStatus(Status.Slowdown, vars.value1);\n\t\t\treturn;\n\t\t}\n}\n\nfunction onSkillEval(s) {\n\tif (skill.level == 2 && s.unit.hasStatus(Status.Slowdown)) {\n\t\tfor (t in s.getTargets()) {\n\t\t\tif (t.target == skill.unit) {\n\t\t\t\tt.baseDamageBonus -= vars.value2;\n\t\t\t}\n\t\t}\n\t}\n}",
					"notes": "",
