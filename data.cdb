					"script": "function onGen() {\n\tfor (f in getFoeUnits()) {\n\t\tif (f.hasStatus(Status.Leader)) {\n\t\t\tvars.name = f.getName(true);\n\t\t}\n\t}\n\treturn true;\n}\n\nfunction onDeath(a) {\n\tif (a.target.hasStatus(Status.Leader)) {\n\t\tsetSuccessObjective(a.target.isCaptured());\n\t\tupdateObjectiveDesc();\n\t}\n}",
