						},
						"specialAnim": "Throw",
						"preventEngage": true
					},
					"script": "function getClosestTargets() {\n\tvar ts = [];\n\tfor (t in skill.getTargets()) {\n\t\tts.push({t : t, d : getDistance(skill.unit, t.target)});\n\t}\n\tts.sort((t1, t2) -> t1.d < t2.d ? -1 : t1.d > t2.d ? 1 : 0);\n\tvar res = [];\n\tfor (t in ts) {\n\t\tres.push(t.t);\n\t\tif (res.length == vars.value1)\n\t\t\tbreak;\n\t}\n\treturn res;\n}\n\nfunction onEval(s) {\n\tvar ts = getClosestTargets();\n\tfor (t in ts)\n\t\tif (t.target == s.target)\n\t\t\treturn;\n\ts.dontShowPreview();\n}\n\nfunction onSkill() {\n\tvar ts = getClosestTargets();\n\tskill.unit.disengage(false);\n\tfor (t in ts)\n\t\tattackTarget(t.target);\n}",
