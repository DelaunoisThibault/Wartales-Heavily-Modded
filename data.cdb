					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "function onDamageTaken(a){\n    checkSt(a);\n}\n\nfunction onDamageDone(a) {\n    checkSt(a);\n}\n\nfunction checkSt(a) {\n\tif( a.target == skill.unit ) return;\n\tif( a.target.side != skill.unit.side ) return;\n\tif( a.unit != null && a.unit.side == a.target.side ) return;\n    if( a.damagedHealth <= 0 ) return;\n\tif( !skill.unit.isMelee(a.target) ) return;\n\tskill.unit.addStatus(Status.Motivation, 1, true);\n\tskill.unit.onTraitTriggered(Trait.Misanthropic);\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitDisciplinedTracker",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"once": false,
							"value1": 1
						}
					},
					"script": "function onSkillPlayed(s) {\n\tif( vars.once ) return;\n\tif( s.apCost < 1 ) return;\n\tskill.unit.gainsActionPoint(vars.value1);\n\tvars.once = true;\n\n\tskill.unit.onTraitTriggered(Trait.DisciplinedTracker);\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitsHelethGunbald",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "function onDamageTaken(a) {\n    checkSt(a);\n}\n\nfunction onDamageDone(a) {\n    checkSt(a);\n}\n\nfunction checkSt(a) {\n\tif( a.target == skill.unit ) return;\n\tif( a.unit != null && a.unit.side == a.target.side ) return;\n    if( a.damagedHealth <= 0 ) return;\n\n\tvar hitHeleth = a.target.hasTrait(Trait.GunbaldSoulmate);\n\tvar hitGunbald = a.target.hasTrait(Trait.HelethSoulmate);\n\tif( hitHeleth || hitGunbald ) {\n\t\tif( skill.unit.addStatus(Status.Fury) ) {\n\t\t\tskill.unit.onTraitTriggered(hitHeleth ? Trait.HelethSoulmate : Trait.GunbaldSoulmate);\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitOrthodoxe",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {},
					"script": "function onSkillEval(s) {\n    for (t in s.getTargets()) {\n\t\tif( t.target.hasStatus(Status.Burning) ) {\n\t\t\tt.criticalHitPercent = 100;\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitBaneOfSeas",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"vars": {
							"pc": 10
						}
					},
					"script": "function onBeginBattle() {\n\tif( !isBoatBattle() ) return;\n\tvar f = getFoeUnits();\n\tvar c = ceil((vars.pc / 100.0) * f.length);\n\tshuffle(f, randInt(0, 1000));\n\tfor( i in 0...c ) {\n\t\tf[i].addStatus(Status.Vulnerability);\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitDeadDrunk",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "function onBeginBattle() {\n\tif( skill.unit.getCounter(Counter.DrinkingDays) == 0 ) return;\n\tskill.unit.addStatus(Status.Brutality);\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitDeathDefying",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "function onStatus(a) {\n\tif( a.status.kind != Status.Dying ) return;\n\tif( a.unit.side != skill.unit.side ) return;\n\tskill.unit.gainsActionPoint(1);\n\tskill.unit.addStatus(Status.Inspiration);\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitEsmaSecond",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true
					},
					"script": "function onDamageTaken(a) {\n\tif( !a.target.isElement(cast \"B1PrisonPrisonner1\") ) return;\n\tif( a.target.side != skill.unit.side ) return;\n\tif( !a.target.isMelee(skill.unit) ) return;\n\tskill.unit.addStatus(Status.Fury);\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitEsmaDamnedSoul",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {},
					"script": "function onEndTurn() {\n\tvar allies = getAllies(skill.unit, false);\n\tvar esma = null;\n\tfor( u in allies ) {\n\t\tif( u.isElement(cast \"B1PrisonPrisonner1\") ) {\n\t\t\tesma = u;\n\t\t\tbreak;\n\t\t}\n\t}\n\tif( esma == null ) return;\n\tif( !esma.isMelee(skill.unit) ) return;\n\tesma.addStatus(Status.Deflection);\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitProtector",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"helped": false
						},
						"globalEvents": true
					},
					"script": "function onBeginRound() {\n\tvars.helped = false;\n}\n\nfunction onDamageTaken(a) {\n\tif( vars.helped ) return;\n\tif( a.target.side != skill.unit.side ) return;\n\tif( !a.target.isMelee(skill.unit) ) return;\n\tif( a.kills || a.damagedHealth <= 0 ) return;\n\tvar t = a.unit;\n\tif( t == null || t.side == a.target.side ) return;\n\tif( a.target.canOpportunityAttack(t) ) {\n\t\tskill.unit.onTraitTriggered(Trait.Protector);\n\t\ta.target.opportunityAttack(t, skill);\n\t\tvars.helped = true;\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitPhilanthropist",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"val": 10
						}
					},
					"script": "function onSkillEval(a) {\n\tvar civil = 0;\n\tfor (u in getAllUnits()) {\n\t\tif(u.kind == UnitClass.E3Civil && u.isAlive())\n\t\t\tcivil++;\n\t}\n\tif (civil == 0) return;\n\n\tfor (t in a.getTargets()) {\n\t\tt.baseDamageBonus += vars.val * civil;\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
				{
					"id": "TraitWalburgaBitter",
					"name": "",
					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"globalEvents": true,
						"vars": {
							"allowed": true
						}
					},
					"script": "function onStatus(a) {\n\tif (vars.allowed && a.unit.side == skill.unit.side && a.unit != skill.unit && a.status.isMalus){\n\t\tvars.allowed = false;\n\t\tskill.unit.addStatus(Status.Wrath);\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
