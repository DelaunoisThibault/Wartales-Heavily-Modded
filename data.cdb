					"desc": "",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value": 2
						}
					},
					"script": "function onStatus(st) {\n    if (st.kind == Status.Uninteresting) {\n        for (u in getAllies(skill.unit))\n            if (!u.hasStatus(Status.Uninteresting))\n                return;\n        for (u in getAllUnits()) {\n\t\t\tif (u.side == skill.unit.side)\n            \tu.consumeStatus(Status.Uninteresting);\n\t\t\telse\n\t\t\t\tu.addStatus(Status.RagingAnnoyance, vars.value);\n        }\n    }\n}",
					"notes": "",
