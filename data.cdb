				{
					"id": "Inferno",
					"name": "Inferno",
					"desc": "Inflige ::value1::% de leur [Health] maximum à des unités adverses aléatoires et crée un [Fire].",
					"mode": 4,
					"range": {},
					"props": {
						"usableWhenHasPlayed": true,
						"vars": {
							"value1": 30
						},
						"baseAction": false,
						"itemCost": {
							"item": "E2Manpower",
							"qty": 15
						},
						"oncePerFight": true
					},
					"script": "function onSkill() {\n    var targets = getFoes(skill.unit);\n    shuffle(targets, randInt(0, 1000));\n    targets.sort( (a, b) -> {\n        if (a.health < b.health) return  1;\n        if (a.health > b.health) return -1;\n        if ( a.isEngaged() && !b.isEngaged()) return  1;\n        if (!a.isEngaged() &&  b.isEngaged()) return -1;\n        return 0;\n    } );\n\n    var count = max(1, round(targets.length * 0.3));\n    var targets = targets.slice(0, count);\n    play(\"FireOrder\", true);\n    for ( t in targets) {\n        castSkill(Skill.InfernoProjectile, {unit : t}, skill);\n    }\n}",
					"notes": "",
					"done": 0,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_04_96PX.png",
						"size": 96,
						"x": 5,
						"y": 3
					}
				},
				{
