							}
						]
					},
					"script": "function onSkillEval(a) {
						for( u in a.getTargets() ) {
							if( u.target.hasStatus(Status.Slowdown) && u.target.guard > 0 ) {
								u.baseDamageBonus += vars.value2;
							} else if( u.target.hasStatus(Status.Slowdown) || u.target.guard > 0 ) {
								u.baseDamageBonus += vars.value1;
							}
						}
					}",
