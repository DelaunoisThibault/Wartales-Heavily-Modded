							},
							{
								"st": "Inspiration"
							}
						]
					},
					"script": "function onStatus(s){
						if(s.kind == Status.Burning){
							skill.unit.addStatusPersist(Status.Inspiration, skill);
						}
					}
					function onBeginRound(){
						if( skill.unit.hasStatus(Status.Burning) && !skill.unit.hasStatus(Status.Inspiration) ){
							skill.unit.addStatusPersist(Status.Inspiration, skill);
						}
					}
					function onSkillEval(a) {
						for( t in a.getTargets() ) {
							if( skill.unit.hasStatus(Status.Burning) ) {
								t.criticalHitPercent = 100;
							}
						}
					}",
