					"script": "function onBeforeHit(s){\n\tif (skill.unit.getCrossbowSkill() != s.skillKind) return;\n\n\tvar statusList = [Status.Burning, Status.Bleeding].filter( st -> !s.target.hasStatus(st));\n\tstatusList.push(Status.Poison);\n\tvar st = statusList[randInt(0, statusList.length - 1)];\n\ts.willAddStatus(st, st == Status.Poison ? vars.value : 1);\n}\n\nfunction onDamageDealt(s) {\n\tif (skill.level == 2 && isConsecutiveShot()) {\n\t\tif (s.statusToAdd != null)\n\t\t\tfor (st in s.statusToAdd){\n\t\t\t\ts.target.applyDot(st.st);\n\t\t\t}\n\t}\n}",
