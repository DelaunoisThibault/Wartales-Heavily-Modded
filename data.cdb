								"difficulty": 2
							}
						],
						"isAttack": true
					},
					"script": "function onHit(a) {\n\ta.target.pushback({ unit : skill.unit }, getPushback(a), a);\n}\n\nfunction onDamage(a) {\n\tif( a.target.isMelee(skill.unit) && a.target.side != skill.unit.side ) {\n\t\ta.target.disengage(false);\n\t\ta.target.engage(skill.unit);\n\t}\n}\n\nfunction getPushback( a ) {\n\treturn -vars.value1;\n}",
					"notes": "",
