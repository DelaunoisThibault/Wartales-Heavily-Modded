				{
					"id": "TrackMecanism",
					"name": "Mécanisme de traque",
					"desc": "Chaque round, la première fois que cette unité inflige des dégats à une unité qui n'a aucun alliés à moins de ::value:: mètres, [Reload].",
					"mode": 2,
					"range": {},
