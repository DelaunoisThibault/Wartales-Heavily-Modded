				{
					"id": "TrainingIR2Champion",
					"name": "Dressage",
					"desc": "L'animal fantôme le plus proche gagne [Replay]. Si cette unité n'a pas d'alliés, gagne [Fury].",
					"mode": 4,
					"range": {},
					"props": {
						"specialAnim": "Taunt",
