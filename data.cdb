					"script": "function onBeginBattle() {\n\tvar bonus = round(skill.unit.getTraitValue(Trait.WerewolfEasyTransform));\n\tvars.proba += bonus;\n}\n\nfunction onBeginAction() {\n\tvars.allowed = skill.unit.isWerewolf && !skill.unit.isWerewolfForm;\n}\n\nfunction onSkill() {\n\tvar p = isAutoPlayed() ? vars.foeProba : vars.proba;\n\twerewolfTransformation(skill.unit, p);\n\tif( skill.unit.isWerewolfForm ) {\n\t} else {\n\t\tvars.proba = min(vars.proba + vars.probaStep, 100);\n\t\tvars.foeProba = min(vars.foeProba + vars.probaStep, 100);\n\t}\n}",
