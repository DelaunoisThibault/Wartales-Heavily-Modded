						"specialAnim": "AttackWide"
					},
					"script": "function onBeginBattle() {
						vars.additionalAttack = false;
					}
					function onBeginRound(){
						vars.additionalAttack = false;
					}
					function onSkill() {
						if( vars.additionalAttack ){
							skill.unit.damages(skill, skill.unit.getPercentHealth(vars.value1), true);
							attack();
						} else {
							attack();
						}
					}
					function onEval(a) {
						if( vars.additionalAttack ) {
							a.baseDamageBonus += vars.value2;
						}
					}
					function onPostSkill() {
						allowReplay();
						vars.additionalAttack = true;
					}
					function onEndTurn(){
						vars.additionalAttack = false;
					}",
