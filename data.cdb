					"script": "function onBeginBattle() {
						var nb = 0;
						for( u in getAllies(skill.unit) ) {
							if( u.isAnimal  ) {
								nb++;
							}
						}
						vars.damageStackBonus = vars.value1 * nb;
						if(vars.damageStackBonus >= vars.value3) {
							vars.damageStackBonus = vars.value3;
						}
						vars.defenseStackBonus = vars.value2 * nb;
						if(vars.defenseStackBonus >= vars.value4 ) {
							vars.defenseStackBonus = vars.value4;
						}
					}
					function onBeginRound() {
						var nb = 0;
						for( u in getAllies(skill.unit) ) {
							if( u.isAnimal  ) {
								nb++;
							}
						}
						vars.damageStackBonus = vars.value1 * nb;
						if(vars.damageStackBonus >= vars.value3) {
							vars.damageStackBonus = vars.value3;
						}
						vars.defenseStackBonus = vars.value2 * nb;
						if(vars.defenseStackBonus >= vars.value4 ) {
							vars.defenseStackBonus = vars.value4;
						}
					}
					function onBeginAction() {
						var nb = 0;
						for( u in getAllies(skill.unit) ) {
							if( u.isAnimal ) {
								nb++;
							}
						}
						vars.damageStackBonus = vars.value1 * nb;
						if(vars.damageStackBonus >= vars.value3) {
							vars.damageStackBonus = vars.value3;
						}
						vars.defenseStackBonus = vars.value2 * nb;
						if(vars.defenseStackBonus >= vars.value4 ) {
							vars.defenseStackBonus = vars.value4;
						}
					}
					function onSkillEval(a) {
						for( t in a.getTargets() ) {
