					"script": "function onEval(a) {\n\tif( a.target.statusResist(Status.Disarm) && !a.target.hasStatus(Status.Champion )) {\n\t\tdontAllow();\n\t}\n}\n\nfunction onSkill() {\n\tplay();\n\tfor( t in skill.getTargets() ) {\n\t\tif( skill.level >= 2 && t.target.hasStatus(Status.Disarm) ) {\n\t\t\tt.target.addStatus(Status.Vulnerability);\n\t\t}\n\t\tt.target.addStatus(Status.Disarm, vars.value1, true);\n\t\tif (t.target.hasStatus(Status.Champion))\n\t\t\tt.target.addStatus(Status.Weakening);\n\t}\n}",
