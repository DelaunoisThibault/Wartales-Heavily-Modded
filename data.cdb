					"script": "function onSkillPlayed(a) {\n\tif (vars.todo && !vars.done) {\n\t\tvars.done = true;\n\t\tskill.unit.reloadCrossbow(skill);\n\t}\n}\n\nfunction onDamageDealt(a) {\n\tif(!vars.todo && a.dmg > 0 && vars.wasEngaged)\n\t\tvars.todo = true;\n}\n\nfunction onBeforeHit(a){\n\tvars.wasEngaged = a.target.isEngaged() && a.target.engagedUnit.side == skill.unit.side && a.target.engagedUnit != skill.unit;\n}\n\nfunction onEndRound() {\n\tvars.done = false;\n\tvars.todo = false;\n}\n\nfunction getAITargetScore(a) {\n\tif (!vars.done && a.target.isEngaged() && a.target.engagedUnit.side == skill.unit.side) {\n\t\treturn 100;\n\t}\n\treturn 0;\n}",
