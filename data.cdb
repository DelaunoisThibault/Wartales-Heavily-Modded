					"script": "function onEndTurn( ) {\n\tif(skill.unit.isEngaged()) return;\n\tif (!isCurrentTurn(skill.unit)) return;\n\tif( getZone() != null ) return; // Unit ended turn without moving\n    createZone();\n}\n\nfunction onMoveEvent(m) {\n\tskill.unit.castSkill(Skill.OpportunityAttack, {unit : m.unit}, skill);\n\tskill.unit.reloadCrossbow(skill);\n\tcancelZone();\n}\n\nfunction onMove(m) {\n\tif( m.unit.side == skill.unit.side ) return;\n\tvar z = getZone();\n\tif( z == null || z.getKind() != skill.kind ) return;\n\tm.addZoneEvent(z, onMoveEvent);\n}\n\nfunction onDamageDealt(a) {\n\tif (a.unit == skill.unit && a.castOrigin != null && a.castOrigin.kind == skill.kind) {\n\t\tcancelZone();\n\t}\n}",
