				{
					"id": "HornOfValor",
					"name": "Appel des Braves",
					"desc": "Tous les ennemis adjacents à un allié subissent une attaque d’opportunité de sa part. Ces mêmes alliés gagnent également [Riposte].",
					"mode": 4,
					"range": {},
					"props": {
						"usableWhenHasPlayed": true,
						"baseAction": false,
						"tooltipStatus": [
							{
								"st": "Riposte"
							}
						],
						"itemCost": {
							"item": "E2Manpower",
							"qty": 15
						},
						"oncePerFight": true
					},
					"script": "function onSkill() {\n    var pairs : Array<{target : battle.skill.UnitView, unit : battle.skill.UnitView}> = [];\n    for (ally in getAllies(skill.unit)){\n        for (foe in getFoes(ally)) {\n            if ((foe.isEngaged() && foe.engagedUnit == ally ) || (!foe.isEngaged() && !ally.isEngaged() && foe.isMelee(ally)))\n                pairs.push({target : foe, unit : ally});\n        }\n    }\n\n    play(\"ExecuteOrder\", true);\n    for (p in pairs) {\n\t\tp.unit.opportunityAttack(p.target, skill);\n        p.unit.addStatus(Status.Riposte);\n    }\n}",
					"notes": "",
					"done": 0,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_04_96PX.png",
						"size": 96,
						"x": 3,
						"y": 3
					}
				},
