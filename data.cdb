				{
					"id": "PitE1_HitCount",
					"name": "Coup pour Coup",
					"desc": "Les unités perdent leur [Armor] et voient leur [MaxHealth] réduite selon leur type d'[Armor]. Les unités ne perdent qu'un point de [Health] par attaque.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"foeL": 3,
							"foeM": 6,
							"foeH": 9,
							"allyL": 3,
							"allyM": 6,
							"allyH": 9,
							"init": false
						}
					},
					"script": "function onInit() {\n    for (u in getUnits()) {\n        var v = 1;\n        var isFoe = isFoe(u);\n        if (u.hasLightArmor()) {\n            v = isFoe ? vars.foeL : vars.allyL;\n        } else if (u.hasMediumArmor()) {\n            v = isFoe ? vars.foeM : vars.allyM;\n        } else if (u.hasHeavyArmor()) {\n            v = isFoe ? vars.foeH : vars.allyH;\n        }\n        u.armor = 0;\n        u.health = v;\n        u.forceAttribute(Attribute.MaxHealth, v);\n    }\n}\n\nfunction onSkillEval(s) {\n    for (t in s.getTargets()) {\n        t.forcedDmg = 1;\n    }\n}\n\nfunction onDotEval(dot) {\n    dot.dmg = 1;\n    dot.count = 1;\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"icon": {
