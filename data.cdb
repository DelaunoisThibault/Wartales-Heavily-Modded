							"statusIndex": -1
						}
					},
					"script": "var arr = [
						Status.Poison,
						Status.Bleeding,
						Status.Fragility,
						Status.Weakening,
						Status.Vulnerability
					];
					function onBeginRound(){
						getStatusIndex();
					}
					function getStatusIndex() {
						if (vars.statusIndex == -1){
							vars.statusIndex = randInt(0, arr.length - 1);
							return vars.statusIndex;
						}
					}
					function onDamageDealt(a) {
						a.target.addStatus(arr[getStatusIndex()]);
					}
					function onEndTurn(){
						skill.unit.damages(skill, skill.unit.getPercentHealth(vars.value1), true);
					}",
