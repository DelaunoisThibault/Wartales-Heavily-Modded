				{
					"id": "ScaryStrikePlayer",
					"name": "Frappe Effrayante",
					"desc": "Cible une zone.\nInflige [DMG] à toutes les unités dans la zone et leur applique [TheBeastMark]. Les animaux adjacents à l'unité gagnent [Replay].",
					"mode": 5,
					"range": {
						"type": 1,
						"radius": 3,
						"angle": 160,
						"allowedTargets": 5
					},
					"props": {
						"dmgAttribute": 0,
						"tooltipStatus": [
							{
								"st": "Targeting"
							},
							{
								"st": "TheBeastMark"
							},
							{
								"st": "Replay"
							}
						],
						"isAttack": true,
						"vars": {
							"value1": 1
						},
						"fxSuffix": 0,
						"specialAnim": "AttackWide"
					},
					"script": "function onSkill() {\n\tif( waitNextTurn() ) {\n\t\tprepareAttack();\n\t\tcreateZone();\n\t\tskill.unit.addStatus(Status.Targeting);\n\t\treturn;\n\t}\n\tattack();\n\tfor (a in getAllies(skill.unit))\n\t\tif (a.isAnimal && a.isMelee(skill.unit))\n\t\t\ta.addStatus(Status.Replay);\n\tcancelZone();\n}\n\nfunction onHit(a) {\n\ta.target.addStatus(Status.TheBeastMark);\n}",
