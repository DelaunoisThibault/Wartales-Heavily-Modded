					"script": "function onEval(a) {\n\tif ((a.target.getPercentHealth(100, true) <= a.unit.getPercentHealth(100) && skill.level == 1) || a.target.health >= a.target.getPercentHealth(vars.value1, true)) {\n\t\tdontAllow();\n\t}\n}\n\nfunction onPostSkill() {\n\tfor (t in skill.getTargets()) {\n\t\tif (!t.target.isAlive()) {\n\t\t\tif (canUseAttackStance()) {\n\t\t\t\tskill.unit.gainsActionPoint(vars.value2);\n\t\t\t}\n\t\t\tif (canUseDefenseStance()) {\n\t\t\t\tskill.unit.reloadMovePoints();\n\t\t\t}\n\t\t}\n\t}\n}",
