					"script": "function onEval(a) {\n\tif( a.target.isAnimal ) {\n\t\tdontAllow();\n\t}\n}\n\nfunction onHit(a) {\n\ta.target.pushback({ unit : a.unit }, getPushback(a), a);\n}\n\nfunction onDamage(a){\n\tif (a.target.isMelee(a.unit) && a.unit.canSwapPositionWith(a.target)){\n\t\ta.unit.swapPositionWith(a.target, 0);\n\t\ta.unit.engage(a.target);\n\t}\n}\n\nfunction getPushback( a ) {\n\treturn -vars.value1;\n}",
