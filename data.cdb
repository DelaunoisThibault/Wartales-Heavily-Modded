								"st": "Discredit"
							}
						],
						"vars": {
							"val": 20,
							"h": 0,
							"a": 0
						},
						"globalEvents": true
					},
					"script": "function onBeginRound() {\n\tvars.h = skill.unit.health;\n\tvars.a = skill.unit.armor;\n\tskill.unit.cancelStatus(Status.Discredit, skill);\n}\n\nfunction onBeginAction() {\n\tvar p = 1 - vars.val / 100;\n\tvar b = skill.unit.health / vars.h < p || skill.unit.armor / vars.a < p;\n\tif (b && !skill.unit.hasStatus(Status.Discredit)) {\n\t\tskill.unit.addStatusPersist(Status.Discredit, skill);\n\t} else if (!b && skill.unit.hasStatusPersist(Status.Discredit, skill)) {\n\t\tskill.unit.cancelStatus(Status.Discredit, skill);\n\t}\n}",
					"notes": "",
