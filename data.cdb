				{
					"id": "Frenzy",
					"name": "Frénésie",
					"desc": "Inflige [DMG] à la cible.\n\n[Backstab] : Effectue ::value1:: attaques supplémentaires.",
					"mode": 0,
					"range": {},
					"props": {
						"dmgAttribute": 1,
