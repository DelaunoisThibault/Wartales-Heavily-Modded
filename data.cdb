							}
						],
						"globalEvents": true
					},
					"script": "function onEndRound() {\n\tspreadZone(Skill.FireZone, vars.value2);\n}\n\nfunction onInit() {\n\tfor ( f in getUnits() ) {\n\t\tf.addStatus(Status.PitG1_1_FireDamageStatus, 1);\n\t}\n}\n\nfunction onStatusRemoved(a) {\n\tif (a.kind == Status.PitG1_1_FireDamageStatus) {\n\t\tskill.unit.addStatus(Status.PitG1_1_FireDamageStatus, 1);\n\t}\n}",
					"notes": "",
