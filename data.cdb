						var nb = 0;
						for( u in getAllies(skill.unit) ){
							if( u.kind == UnitClass.Wolf || u.kind == UnitClass.SnowWolf || u.kind == UnitClass.Alpha || u.kind == UnitClass.WolfFierce || u.kind == UnitClass.SnowAlpha || u.kind == UnitClass.AncientAlpha || u.kind == UnitClass.AncientSnowAlpha || u.kind == UnitClass.SteelWolf || u.kind == UnitClass.SteelSnowWolf || u.kind == UnitClass.GodLikeAlpha || u.kind == UnitClass.GodLikeSnowAlpha ){
								nb++;
							}
						}
