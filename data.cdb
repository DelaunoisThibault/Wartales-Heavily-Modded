				{
					"id": "Temperance",
					"name": "Tempérance",
					"desc": "Lorsque cette unité subit une attaque, si elle n'a pas [Deflection], elle gagne [Deflection].",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"addDeflection": false,
							"addRiposte": false
						},
						"globalEvents": true,
						"tooltipStatus": [
							{
								"st": "Deflection"
							}
						]
					},
					"script": "function onBeforeHit(s) {\n\tif( s.unit != skill.unit && s.target == skill.unit ) {\n\t\tvars.addDeflection = !s.target.hasStatus(Status.Deflection);\n\t\tvars.addRiposte = skill.level == 2 && !s.target.hasStatus(Status.Riposte);\n\t}\n}\n\nfunction onSkillPlayed(s) {\n\tvar b = false;\n\tif (vars.addDeflection) {\n\t\tskill.unit.addStatus(Status.Deflection);\n\t\tvars.addDeflection = false;\n\t\tb = true;\n\t}\n\tif (skill.level == 2 && vars.addRiposte) {\n\t\tskill.unit.addStatus(Status.Riposte);\n\t\tvars.addRiposte = false;\n\t\tb = true;\n\t}\n\tif (b)\n\t\tspawnFx();\n}",
					"notes": "",
					"icon": {
						"file": "ui/Icons/BattleIcons_02_96PX.png",
						"size": 96,
						"x": 14,
						"y": 3
					},
					"levels": [
						{
							"props": {
								"tooltipStatus": [
									{
										"st": "Riposte"
									}
								]
							},
							"desc": "Lorsque cette unité subit une attaque, si elle n'a pas [Deflection], elle gagne [Deflection].\nLorsque cette unité subit une attaque, si elle n'a pas [Riposte], elle gagne [Riposte]."
						}
					],
					"iconeDone": true,
					"done": 2
				},
				{
					"id": "OneOnOne",
					"name": "Face-à-face",
					"desc": "Tant qu'aucune autre unité n'est adjacente à cette unité ou à son adversaire engagé, elle a [Rivalry].",
					"mode": 2,
					"range": {},
					"props": {
						"tooltipStatus": [
							{
								"st": "Rivalry"
							}
						],
						"globalEvents": true
					},
					"script": "function onBeginAction() {\n\tif (skill.unit.engagedUnit == null) {\n\t\tskill.unit.cancelStatus(Status.Rivalry, skill);\n\t\treturn;\n\t}\n\tvar b = skill.unit.engagedUnit != null && !isMeleeWithAlly(skill.unit) && (skill.level == 1 || !isMeleeWithAlly(skill.unit.engagedUnit));\n\tif (b) {\n\t\tfor (u in getUnits()) {\n\t\t\tif (u == skill.unit.engagedUnit || u == skill.unit) continue;\n\t\t\tif (skill.unit.isMelee(u) || (skill.level == 1 && skill.unit.engagedUnit.isMelee(u))) {\n\t\t\t\tb = false;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t}\n\tif( b ) {\n\t\tif( !skill.unit.hasStatus(Status.Rivalry) ) {\n\t\t\tspawnFx();\n\t\t\tskill.unit.addStatusPersist(Status.Rivalry, skill);\n\t\t}\n\t} else {\n\t\tskill.unit.cancelStatus(Status.Rivalry, skill);\n\t}\n}",
					"notes": "",
