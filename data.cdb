					"name": "Puissance de la meute",
					"desc": "[DamageBonusPercent] augmentés de ::value1::% et [CritHitPercent] de ::value3::% si au moins ::value2:: alliés sont vivants dans le groupe. ",
					"mode": 2,
					"range": {},
					"props": {
						"hidden": false,
						"vars": {
							"value1": 50,
							"value2": 6,
							"value3": 25,
							"bonusApplied": false
						},
						"descPassiveGroup": "[GROUPTYPE] : [DamageBonusPercent] augmentés de ::value1::% et [CritHitPercent] de ::value3::% si au moins ::value2:: alliés sont vivants dans le groupe."
					},
					"script": "function onBeginBattle() {
						var nb = 0;
						for( u in getAllies(skill.unit) ) {
							nb++;
						}
						if( nb >= vars.value2 ){
							vars.bonusApplied = true;
						} else {
							vars.bonusApplied = false;
						}
					}
					function onBeginAction() {
						var nb = 0;
						for( u in getAllies(skill.unit) ) {
							nb++;
						}
						if( nb >= vars.value2 ){
							vars.bonusApplied = true;
						} else {
							vars.bonusApplied = false;
						}
					}
					function onSkillEval(a) {
						for( t in a.getTargets() ) {
							if(vars.bonusApplied){
								t.criticalHitPercent += vars.value3;
								t.baseDamageBonus += vars.value1;
							}
						}
					}",
