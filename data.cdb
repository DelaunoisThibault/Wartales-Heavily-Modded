					"script": "function onZoneIn(a) {\n\ta.stopMove(false);\n\ta.remove();\n\tplay();\n\tfunction pushbackAllTargets() {\n\t\tfor( t in a.getUnitsInRadius(vars.value2) ) {\n\t\t\tt.pushback(getPushbackOrigin(null), getPushback(null), getSkillTarget(skill.unit, t));\n\t\t}\n\t}\n\ta.addMoveEvent(pushbackAllTargets);\n}\n\nfunction getPushback( a ) {\n\treturn vars.value1;\n}\n\nfunction getPushbackOrigin(a) {\n\treturn { skill : skill };\n}",
