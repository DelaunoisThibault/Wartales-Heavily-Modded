				{
					"id": "UnstablePreparation",
					"name": "Préparation instable",
					"desc": "Chaque allié dans la zone effectue une [OpportunityAttack]. Obtenez <apt>::value1::</apt> pour chaque ennemi tué de cette manière.\n\n[Inhalation1] : [CriticalHit] assuré pour les unités dans la zone.\n\n[Inhalation2] : Déclenche une seconde [OpportunityAttack] puis les cibles gagnent ::value2:: [AnimalMarkedBonus].",
					"mode": 5,
					"range": {
						"baseDistance": 8,
						"allowedTargets": 1,
						"type": 0,
						"radius": 2,
						"flags": 128
					},
					"props": {
						"globalEvents": true,
						"vars": {
							"value1": 1,
							"value2": 2
						},
						"apCost": 1,
						"specialAnim": "Throw",
						"hitFx": "prefabs/fx/fight/Explosion/SmokeBomb/SmokeBomb.fx",
						"throwFx": "prefabs/fx/fight/Explosion/SmokeBomb/BlindingPowderTrowTrail.fx",
						"flags": 8388608,
						"tooltipStatus": [
							{
								"st": "AnimalMarkedBonus"
							}
						]
					},
					"script": "function onSkill() {\n\tplayAttack();\n\tfor ( t in skill.getTargets() ) {\n\t\tif (t.target.isEngaged()){\n\t\t\tif (skill.unit.getStatusCount(Status.Inhalation) >= 1)\n\t\t\t\tt.target.addStatus(Status.UnstablePreparation_ForceCrit);\n\t\t\tt.target.opportunityAttack(t.target.engagedUnit, skill);\n\t\t\tt.target.consumeStatus(Status.UnstablePreparation_ForceCrit);\n\t\t}\n\t}\n}\n\nfunction onPostSkill() {\n\tif (skill.unit.getStatusCount(Status.Inhalation) >= 3) {\n\t\tskill.unit.castSkill(Skill.Censer_lvl5_2_skill, { unit : skill.unit }, skill);\n\t}\n}\n\nfunction onDeath(a) {\n\tif (a.isOpportunityAttack() && a.castOrigin != null && a.castOrigin.unit == skill.unit && a.castOrigin.kind == Skill.UnstablePreparation) {\n\t\tskill.unit.gainsActionPoint(vars.value1);\n\t}\n}\n\nfunction onSkillPlayed(a) {\n\tif (a.kind != Skill.UnstablePreparation || a.unit != skill.unit) return;\n\tif (skill.unit.getStatusCount(Status.Inhalation) >= 2) {\n\t\tfor(t in a.getTargets()) {\n\t\t\tif (t.target.isEngaged()){\n\t\t\t\tt.target.opportunityAttack(t.target.engagedUnit, skill);\n\t\t\t\tt.target.addStatus(Status.AnimalMarkedBonus, vars.value2);\n\t\t\t}\n\t\t}\n\t}\n}",
