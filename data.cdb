					"script": "function onBeginAction() {\n\tcomputeStackBonus();\n}\n\nfunction onSkillEval(a) {\n\tvar bonus = computeStackBonus();\n\tfor( t in a.getTargets() ) {\n\t\tt.baseDamageBonus += bonus;\n\t}\n}\n\nfunction computeStackBonus() {\n\tvar arr = [];\n\tfor ( u in getFoes(skill.unit, true) ) {\n\t\tif( getDistance(skill.unit, u) <= vars.value2 ) {\n\t\t\tarr.push(u);\n\t\t}\n\t}\n\tvars.stackBonus = arr.length * vars.value1;\n\treturn vars.stackBonus;\n}",
