					"script": "function onBeginAction() {\n\tif( !skill.unit.isEngaged() ) {\n\t\tvars.engaged = false;\n\t\tskill.unit.cancelStatus(Status.Riposte, skill);\n\t}\n}\n\nfunction onSkillPlayed(s) {\n\tif (skill.unit.isEngaged() && !vars.engaged ) {\n\t\tvars.engaged = true;\n\t\tif (skill.unit.engagedUnit.hasStatus(Status.TheBeastMark)) {\n\t\t\tspawnFx();\n\t\t\tskill.unit.addStatusPersist(Status.Riposte, skill);\n\t\t}\n\t}\n}",
