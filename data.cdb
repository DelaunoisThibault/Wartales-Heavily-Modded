									}
								}
							],
							"personality": "PersDefault"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Bon sang mais qu’est-ce qui m’a pris ? Pourquoi est-ce que j’ai fui le combat ? J’aurais dû lutter contre la terreur ! Ces monstres sont des êtres de chair et de sang ! J’aurais pu les battre !"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[MX]Frapper un compagnon au hasard pour passer ses nerfs"
										},
										{
											"text": "[FX]Frapper un compagnon au hasard pour passer ses nerfs"
