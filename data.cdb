							"personality": "PersDefault"
						},
						{
							"introDialog": [
								{
									"text": "[MX]Pourquoi est-ce que je n’ai pas encore été soigné ? Est-ce que ce n’est pas une priorité ? Je vais me transformer en monstre si on ne fait rien !"
								},
								{
									"text": "[FX]Pourquoi est-ce que je n’ai pas encore été soignée ? Est-ce que ce n’est pas une priorité ? Je vais me transformer en monstre si on ne fait rien !"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Boire pour oublier."
										}
									],
									"tipText": "Boire",
									"cost": {
										"itemCost": [
											{
												"item": "Beer",
												"qty": 1,
												"orSameType": true
											}
										]
