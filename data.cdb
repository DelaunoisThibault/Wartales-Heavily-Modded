				{
					"id": "ConfessionLudernFinished1",
					"data": [
						{
							"introDialog": [
								{
									"text": "[XX]Je ne dors plus ! Dès que je ferme les yeux, c’est le sourire de la Bête que je vois !\nJ’ignore ce que les reliques auraient pu apprendre aux érudits, rien ne justifie d’avoir attiré ce monstre sur les habitants de Ludern !"
								}
							],
							"choices": [
								{
									"texts": [
										{
											"trait": [
												{
													"inf": "BardBorn",
													"target": 0
												}
											],
											"text": "[XX]Fêter la défaite des érudits d'Alazar."
										}
									],
									"tipText": "Célébrer",
									"cost": {},
									"gains": {
										"relation": [
											{
												"qty": 1,
												"target": 2
											}
										],
										"item": [
											{
												"inf": "Happiness",
												"qty": 4
											}
										]
									},
									"props": {}
								},
								{
									"texts": [
										{
											"text": "[XX]Remercier les Teuls et les Anciens de leurs avoir accorder la victoire."
										}
									],
									"tipText": "Prier",
									"cost": {},
									"gains": {
										"XP": [
											{
												"qty": 40,
