						}
					},
					"script": "function onEndTurn() {\n\tfor( u in getAllies(skill.unit) ) {\n\t\tif( u.isMelee(skill.unit) && !skill.unit.isEngaged() ) {\n\t\t\tspawnFx();\n\t\t\tu.heal(skill, u.getPercentHealth(vars.value1));\n\t\t}\n\t}\n}",
					"notes": "",
					"done": 2,
					"iconeDone": true
				},
