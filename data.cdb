					"script": "function onEval( a ) {\n\tif( a.isOpportunityAttack() && a.castOrigin != null && a.castOrigin.kind == Skill.ArmorOpportunityCrit ) {\n\t\ta.criticalHitPercent += vars.value1;\n\t}\n}\n\nfunction onDamageTaken(a) {\n\tif( a.isOpportunityAttack() ) {\n\t\tskill.unit.opportunityAttack(a.unit, skill);\n\t}\n}",
