					"desc": "Lorsqu'un allié adjacent subit des dégâts, cette unité en absorbe ::value::%. Si l'allié n'a plus d'armure, il gagne [Protection] pendant ::value2:: tours.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value": 10,
							"value2": 2
						},
						"tooltipStatus": [
							{
								"st": "Protection"
							}
						],
						"globalEvents": true
					},
					"script": "function onBeforeHit(t) {\n\tif (t.target.isMelee(skill.unit) && skill.unit != t.target && skill.unit.side == t.target.side) {\n\t\tvar d = ceil(t.dmg * (vars.value/100));\n\t\tt.dmg -= d;\n\t\tskill.unit.damages(skill, d);\n\n\t\tif (t.target.armor <= t.dmg) {\n\t\t\tt.target.addStatus(Status.Protection, vars.value2, true);\n\t\t}\n\t}\n}\n",
					"notes": "",
					"done": 1,
					"icon": {
						"file": "ui/Icons/BattleIcons_05_96PX.png",
						"size": 96,
						"x": 5,
						"y": 5
					},
					"iconeDone": true
				},
				{
					"id": "CU7HelmetMediumTrainer",
					"name": "Entraînement musclé",
					"desc": "Lorsqu'un allié adjacent subit des dégâts, il gagne ::value:: [AnimalMarkedBonus].\n\nLorsqu'un allié adjacent effectue une attaque critique, il gagne [Fury].",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value": 1
						},
						"tooltipStatus": [
							{
								"st": "AnimalMarkedBonus"
							},
							{
								"st": "Fury"
							}
						],
						"globalEvents": true
					},
					"script": "function onDamageDone(s) {\n\tif (s.unit != null) {\n\t\teffectDamageTaken(s);\n\t}\n}\n\nfunction onDamageTaken(s) {\n\tif (!s.isOpportunityAttack() && s.isLastAttack()) {\n\t\teffectDamageTaken(s);\n\t}\n}\n\nfunction effectDamageTaken(t) {\n\tif (t.target.isMelee(skill.unit) && skill.unit != t.target && skill.unit.side == t.target.side) {\n\t\tt.target.addStatus(Status.AnimalMarkedBonus, vars.value);\n\t}\n\n\tif (t.unit.isMelee(skill.unit) && skill.unit != t.unit && skill.unit.side == t.unit.side && t.isCritical) {\n\t\tt.unit.addStatus(Status.Fury, vars.value);\n\t}\n}",
					"notes": "",
					"done": 1,
					"icon": {
						"file": "ui/Icons/BattleIcons_05_96PX.png",
						"size": 96,
						"x": 1,
						"y": 5
					},
					"iconeDone": true
				},
