				{
					"id": "Trashing",
					"name": "Raclée",
					"desc": "Inflige ::value1:: fois [DMG] à la cible. Chaque attaque augmente les dégâts de la suivante de ::value2::%.\n[AttackStance] : Attaque ::value3:: fois de plus.\n[DefenseStance] : Soigne ::value4::% de sa [Health] maximum à chaque attaque.",
					"mode": 0,
					"range": {},
					"props": {
