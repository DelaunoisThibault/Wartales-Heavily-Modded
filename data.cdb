						},
						"globalEvents": true
					},
					"script": "function onSkillEval(z) {
						if(skill.unit.armor <= 0) {
							for (t in z.getTargets())
							{
								if (t.target == skill.unit)
								{
									t.baseDamageBonus -= vars.value1;
								}
								if (z.unit == skill.unit)
								{
									t.baseDamageBonus += vars.value1;
								}
							}
						}
					}",
