				{
					"id": "ScaryStrike",
					"name": "Frappe Effrayante",
					"desc": "Se dirige vers l'ennemi le plus proche n'ayant pas [EerieLink] et cible une zone.\nInflige [DMG] à toutes les unités dans la zone et leur applique [EerieLink].",
					"mode": 5,
					"range": {
						"type": 1,
						"radius": 3,
						"angle": 160,
						"allowedTargets": 5
					},
					"props": {
						"dmgAttribute": 0,
						"tooltipStatus": [
							{
								"st": "Targeting"
							},
							{
								"st": "EerieLink"
							}
						],
						"isAttack": true,
						"vars": {
							"value1": 1
						},
						"fxSuffix": 0,
						"specialAnim": "AttackWide"
					},
					"script": "function getAITargetScore(t) {\n\tif (t.target.hasStatus(Status.EerieLink))\n\t\treturn 0;\n\treturn ceil(2000 - 100 * getDistance(t.target, t.unit));\n}\n\nfunction onSkill() {\n\tif( waitNextTurn() ) {\n\t\tprepareAttack();\n\t\tcreateZone();\n\t\tskill.unit.addStatus(Status.Targeting);\n\t\treturn;\n\t}\n\tattack();\n\tcancelZone();\n}\n\nfunction onHit(a) {\n\ta.target.addStatus(Status.EerieLink);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_04_96PX.png",
