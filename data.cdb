					"script": "function onBeginAction() {\n\tcomputeStackBonus();\n}\n\nfunction onEval(a) {\n\ta.baseDamageBonus += computeStackBonus();\n}\n\nfunction computeStackBonus() {\n\tvar count = 0;\n\tfor( u in getAllies(skill.unit) ) {\n\t\tif( u.isMelee(skill.unit) ) {\n\t\t\tcount++;\n\t\t}\n\t}\n\tif (count == 0 && isMeleeWithAlly(skill.unit))\n\t\tcount = 1;\n\tvars.stackBonus = count * vars.value1;\n\treturn vars.stackBonus;\n}",
