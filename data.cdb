				{
					"id": "OnlySkilledWereWolf",
					"name": "Lycanthrope Seulement Aguerri",
					"desc": "Assure que le statut [Skilled] est maintenu et n'est pas combiné avec le statut [Leader]",
					"mode": 2,
					"range": {},
					"props": {
						"tooltipStatus": [
							{
								"st": "Skilled"
							},
							{
								"st": "Leader"
							}
						],
						"vars": {
							"neededHeal": true
						}
					},
					"script": "function onBeginBattle() {
						if( skill.unit.hasStatus(Status.Leader) ) {
							skill.unit.cancelStatus(Status.Leader);
						}
						if ( !skill.unit.hasStatus(Status.Skilled)  ) {
							skill.unit.addStatusPersist(Status.Skilled, skill);
						}
						if( skill.unit.health < skill.unit.stats.health ){
							skill.unit.heal(skill, ceil(skill.unit.stats.health));
						}
						if( skill.unit.armor < skill.unit.stats.armor && skill.unit.stats.armor > 0 ) {
							skill.unit.gainsArmor(ceil(skill.unit.stats.armor));
						}
						vars.neededHeal = false;
					}
					function onBeginRound(){
						if( skill.unit.hasStatus(Status.Leader) ) {
							skill.unit.cancelStatus(Status.Leader);
						}
						if ( !skill.unit.hasStatus(Status.Skilled)  ) {
							skill.unit.addStatusPersist(Status.Skilled, skill);
						}
						if(vars.neededHeal){
							skill.unit.heal(skill, ceil(skill.unit.stats.health));
							skill.unit.gainsArmor(ceil(skill.unit.stats.armor));
							vars.neededHeal = false;
						}
					}
					function onBeginAction() {
						if( skill.unit.hasStatus(Status.Leader) ) {
							skill.unit.cancelStatus(Status.Leader);
						}
						if ( !skill.unit.hasStatus(Status.Skilled)  ) {
							skill.unit.addStatusPersist(Status.Skilled, skill);
						}
					}
					function onEndTurn() {
						if ( !skill.unit.hasStatus(Status.Skilled)  ) {
							skill.unit.addStatusPersist(Status.Skilled, skill);
						}
					}",
