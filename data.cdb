					"name": "Purge stimulante",
					"desc": "Lorsque cette unité <b>purge</b>, les alliés engagés à moins de ::range:: mètres effectue une attaque d’opportunité.",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 10,
							"range": 5
						}
					},
					"script": "function onCenserPurged(c) {
						for (a in getAllies(skill.unit)) {
