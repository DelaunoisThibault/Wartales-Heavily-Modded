					"script": "function onDamageDealt(a) {\n\tif( !a.target.hasStatus(Status.Bleeding) || a.target.wasAppliedThisSkill(Status.Bleeding) ) return;\n\tif( a.target.isWerewolf ) {\n\t\twerewolfTransformation(a.target);\n\t\treturn;\n\t}\n\tvar gene = skill.unit.getWerewolfGene();\n\tif( gene == null ) return;\n\tif (randInt(0,1) <= (vars.chance / 100)) {\n\t\ta.target.werewolfInfect(gene);\n\t}\n}\n\nfunction onDamageTaken(a) {\n\tif( skill.unit.hasStatus(Status.Dying) ) {\n\t\tterrorize();\n\t}\n}",
