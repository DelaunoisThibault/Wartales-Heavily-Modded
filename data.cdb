					"id": "IR2ChampSymbiosis",
					"name": "Symbiose d’outre-monde",
					"desc": "Tant que <b>Smilodon Fantôme</b> est en vie, a [SpectralProtection].\nTant que <b>Sanglier Fantôme</b> est en vie, a [SpectralResilience].\nTant que <b>Loup Fantome</b> est en vie, a [SpectralAffliction].\nTant que <b>Ours Fantome</b> est en vie, a [SpectralWrath].",
					"mode": 2,
					"range": {},
					"props": {
						"tooltipStatus": [
							{
								"st": "SpectralProtection"
							},
							{
								"st": "SpectralResilience"
							},
							{
								"st": "SpectralAffliction"
							},
							{
								"st": "SpectralWrath"
							}
						],
						"globalEvents": true
					},
					"script": "function onBeginRound() {\n\tif (getRound() == 1) {\n\t\tskill.unit.addStatusPersist(Status.SpectralProtection, skill);\n\t\tskill.unit.addStatusPersist(Status.SpectralResilience, skill);\n\t\tskill.unit.addStatusPersist(Status.SpectralAffliction, skill);\n\t\tskill.unit.addStatusPersist(Status.SpectralWrath, skill);\n\t}\n}\n\nfunction onBeginAction() {\n\tvar smilodon = false;\n\tvar boar = false;\n\tvar wolf = false;\n\tvar bear = false;\n\tfor (f in getAllies(skill.unit)) {\n\t\tswitch (f.kind) {\n\t\tcase UnitClass.GhostSmilodon: smilodon = true;\n\t\tcase UnitClass.GhostBoar: boar = true;\n\t\tcase UnitClass.GhostWolf: wolf = true;\n\t\tcase UnitClass.GhostBear: bear = true;\n\t\tdefault:\n\t\t}\n\t}\n\n\tif (!smilodon)\n\t\tskill.unit.cancelStatus(Status.SpectralProtection, skill);\n\tif (!boar)\n\t\tskill.unit.cancelStatus(Status.SpectralResilience, skill);\n\tif (!wolf)\n\t\tskill.unit.cancelStatus(Status.SpectralAffliction, skill);\n\tif (!bear)\n\t\tskill.unit.cancelStatus(Status.SpectralWrath, skill);\n}\n\nfunction onSkillEval(a) {\n\tvar hasSmilodon = skill.unit.hasStatus(Status.SpectralProtection);\n\tvar hasBear = skill.unit.hasStatus(Status.SpectralWrath);\n\tif (hasSmilodon || hasBear)\n\t\tfor (t in a.getTargets()) {\n\t\t\tif (hasSmilodon && t.target == skill.unit) {\n\t\t\t\tt.baseDamageBonus -= round(t.unit.getStatusCount(Status.Terror) * getStatusValue(Status.SpectralProtection));\n\t\t\t} else if (hasBear && a.unit == skill.unit) {\n\t\t\t\tt.baseDamageBonus += round(t.target.getStatusCount(Status.Terror) * getStatusValue(Status.SpectralWrath));\n\t\t\t}\n\t\t}\n}\n\nfunction onDamageDealt(t) {\n\tif (t.unit.hasStatus(Status.SpectralAffliction) && t.target.hasStatus(Status.Terror))\n\t\tt.target.addStatus(Status.Bleeding);\n}\n\nfunction canEngage(t) {\n\treturn t == null || !t.hasStatus(Status.Terror);\n}",
					"notes": "",
					"done": 1,
					"iconeDone": true,
					"icon": {
						"file": "ui/Icons/BattleIcons_04_96PX.png",
						"size": 96,
						"x": 7,
						"y": 7
					}
				},
