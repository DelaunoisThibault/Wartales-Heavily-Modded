									"props": {},
									"gains": {
										"item": [
											{
												"qty": -2,
												"inf": "ActionPoint"
											}
										]
									}
								}
							],
							"personality": "PersAggressive"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Je crois que les autres ne saisissent pas bien le danger. Si je n’ai pas accès très vite à un remède d’Alazar, je vais devenir une menace pour tout le monde…\nJe ne veux pas finir comme ça."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Convaincre les autres de l'urgence de la situation."
										}
									],
									"tipText": "Convaincre",
									"cost": {},
									"props": {},
									"gains": {
										"relation": [
											{
												"qty": -1,
												"target": 2
											}
										]
									}
								}
							],
							"personality": "PersPragmatic"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Tant que je mange de la viande à chaque repas, il n’y a aucune chance que je perde l'esprit. Ensuite, on trouvera un de ces remèdes d’Alazar, et tout redeviendra comme avant. Il ne faut pas que je m’en fasse, ça va aller."
								}
							],
							"choices": [
								{
									"texts": [
										{
											"text": "[XX]Implorer le secours divin."
										}
									],
									"tipText": "Prier",
									"cost": {
										"itemCost": [
											{
												"item": "Influence",
												"qty": 30
											}
										]
									},
									"props": {},
									"gains": {
										"item": [
											{
												"qty": 2,
												"inf": "ActionPoint"
											},
											{
												"qty": -2,
												"inf": "Happiness"
											}
										]
									}
								}
							],
							"personality": "PersOptimist"
						},
						{
							"introDialog": [
								{
									"text": "[XX]Je... je sens que c’est en moi. La maladie va se déclarer. Dès que je manquerai de viande, je perdrai la tête. J’ai vu ce que les gens deviennent dans ces cas-là, je refuse de vivre ça !"
								}
							],
							"choices": [
