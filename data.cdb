				{
					"id": "PitE1_ArmorToHealth",
					"name": "À fleur de peau",
					"desc": "L'[Armor] et la [Guard] des unités sont converties en [MaxHealth].",
					"mode": 2,
					"range": {},
					"props": {
						"vars": {
							"value1": 100
						}
					},
					"script": "function onInit() {\n    for (u in getUnits()) {\n        var bh = ceil((u.armor * vars.value1 / 100) + u.stats.maxHealth/(1-u.stats.guard/100));\n        u.forceAttribute(Attribute.MaxHealth, u.stats.maxHealth + bh);\n        u.health = u.health + bh;\n        u.armor = 0;\n    }\n}",
